	// --- 6. Batch Auto-Segmentation (SAM 3 + CONCH Zero-Shot) ---

	batchSegmentPdfBtn?.addEventListener("click", async () => {
		if (!_currentPdfData || !_currentPdfData.images || _currentPdfData.images.length === 0) {
			alert("No hay imágenes en el PDF para segmentar.");
			return;
		}

		const images = _currentPdfData.images;
		const total = images.length;

		batchProgressModal.style.display = "flex";
		batchProgressFill.style.width = "0%";
		batchProgressText.textContent = `0 / ${total} procesadas (0%)`;
		batchStepTitle.textContent = `Iniciando segmentación en lote (${total} imágenes)...`;

		let firstAddedKey = null;

		for (let i = 0; i < total; i++) {
			const img = images[i];
			const pct = Math.round(((i + 1) / total) * 100);

			batchStepTitle.textContent = `[${i + 1}/${total}] Procesando: ${img.filename}`;
			batchProgressText.textContent = `${i + 1} / ${total} procesadas (${pct}%)`;
			batchProgressFill.style.width = `${pct}%`;

			try {
				const imgUrl = `${API_URL}/pdf-image/${_currentPdfData.pdf_id}/${img.filename}`;
				const response = await fetch(imgUrl);
				const blob = await response.blob();
				const file = new File([blob], img.filename, { type: "image/png" });

				const key = file.name + "_" + Date.now();
				const dataUrl = await readFileAsDataUrl(file);
				const dims = await getImageDimensions(dataUrl);

				const imageData = {
					file: file,
					filename: file.name,
					dataUrl: dataUrl,
					width: dims.width,
					height: dims.height,
					groups: [],
					annotated: false,
				};
				imageStore.set(key, imageData);
				if (!firstAddedKey) firstAddedKey = key;

				// 1. Run SAM 3 Auto-segmentation
				const formData = new FormData();
				formData.append("image", file);
				formData.append("umbral", thresholdSlider.value);
				if (window._activeOntologyName) {
					formData.append("ontology_name", window._activeOntologyName);
				}

				const segRes = await fetch(`${API_URL}/segment-auto`, {
					method: "POST",
					body: formData,
				});

				if (segRes.ok) {
					const segResult = await segRes.json();
					imageData.groups = segResult.groups || [];
					imageData.annotated = true;

					// 2. Run CONCH Zero-Shot Classification if groups exist
					let allDets = [];
					imageData.groups.forEach(g => {
						(g.detections || []).forEach(d => {
							allDets.push({
								id: d.id,
								bbox: d.bbox,
								polygon: d.polygon,
								score: d.score,
								class_key: g.key,
								label: g.label,
								color: g.color,
							});
						});
					});

					if (allDets.length > 0) {
						let candidateClasses = classRegistry.map(c => ({
							key: c.key,
							name: c.name,
							label: c.name,
							prompt: c.prompt || c.name,
							color: c.color,
						}));
						if (candidateClasses.length === 0) {
							candidateClasses = imageData.groups.map(g => ({
								key: g.key,
								name: g.label,
								label: g.label,
								prompt: g.label,
								color: g.color,
							}));
						}

						const conchForm = new FormData();
						conchForm.append("image", file);
						conchForm.append("detections", JSON.stringify(allDets));
						conchForm.append("classes", JSON.stringify(candidateClasses));
						conchForm.append("temperature", "0.05");

						const conchRes = await fetch(`${API_URL}/classify-detections-conch`, {
							method: "POST",
							body: conchForm,
						});

						if (conchRes.ok) {
							const conchResult = await conchRes.json();
							const classified = conchResult.detections || [];
							const groupsMap = new Map();
							for (const det of classified) {
								const gKey = det.class_key || "clase_1";
								if (!groupsMap.has(gKey)) {
									groupsMap.set(gKey, {
										key: gKey,
										label: det.class_label || gKey,
										color: det.color || getClassColor(gKey),
										detections: [],
									});
								}
								groupsMap.get(gKey).detections.push(det);
							}
							imageData.groups = Array.from(groupsMap.values());
						}
					}

					// Update class registry
					for (const group of imageData.groups) {
						if (!classRegistry.find(c => c.key === group.key)) {
							classRegistry.push({
								id: classIdCounter++,
								name: group.label,
								color: group.color,
								key: group.key,
							});
						}
					}
				}

			} catch (e) {
				console.warn(`Error processing ${img.filename} in batch:`, e);
			}
		}

		batchProgressModal.style.display = "none";
		renderGallery();
		updateExportStats();

		// Switch to images tab and select the first segmented image
		document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
		document.querySelectorAll(".tab-content").forEach(c => c.classList.remove("active"));
		document.querySelector('[data-tab="images-tab"]').classList.add("active");
		document.getElementById("images-tab").classList.add("active");

		if (firstAddedKey) {
			selectImage(firstAddedKey);
		}

		alert(`✅ Segmentación en lote completada: ${total} imágenes procesadas con SAM 3.1 y clasificadas con CONCH.`);
	});
