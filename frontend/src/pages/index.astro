	async function loadSavedOntologies(autoLoadFirst = false) {
		console.log("[ONT] loadSavedOntologies called, autoLoadFirst=", autoLoadFirst);
		try {
			const url = `${API_URL}/ontologies`;
			console.log("[ONT] Fetching:", url);
			const res = await fetch(url);
			console.log("[ONT] Response status:", res.status);
			if (!res.ok) return false;

			const data = await res.json();
			console.log("[ONT] Response data:", JSON.stringify(data).substring(0, 200));
			const list = data.ontologies || [];
			console.log("[ONT] Found", list.length, "ontologies");

			// Always render the list (even if auto-load later fails)
			renderOntologyList(list);
			_ontologiesLoaded = true;

			// Auto-load first ontology into workbench
			if (autoLoadFirst && list.length > 0 && !window._activeOntologyName) {
				try {
					const firstOnt = list[0];
					console.log("[ONT] Auto-loading first ontology:", firstOnt.name);
					window._activeOntologyName = firstOnt.name;
					statusIdle.innerHTML = `
						<span class="status-dot" style="background: #10b981;"></span>
						<span>Ontología activa: <strong style="color: var(--accent-cyan);">${firstOnt.name}</strong></span>
					`;
					statusIdle.style.display = "flex";

					const ontRes = await fetch(`${API_URL}/ontology/${firstOnt.name}`);
					if (ontRes.ok) {
						const ontData = await ontRes.json();
						console.log("[ONT] Auto-loaded ontology, structures:", ontData.structures?.length);
						displayOntologyEditor(ontData);
					}
				} catch (autoErr) {
					console.error("[ONT] Auto-load error (non-fatal):", autoErr);
				}
			}

			return true;
		} catch (e) {
			console.warn("[ONT] loadSavedOntologies error:", e);
			return false;
		}
	}

	// Robust retry: the backend takes ~10s to load SAM 3 on startup.
	(async function retryLoadOntologies() {
		const delays = [500, 1500, 3000, 5000, 8000, 12000, 18000, 25000];
		for (const delay of delays) {
			console.log("[ONT] Attempting to load ontologies...");
			const ok = await loadSavedOntologies(true);
			if (ok) {
				console.log("[ONT] ✅ Ontologies loaded successfully!");
				return;
			}
			console.log("[ONT] Backend not ready, retrying in", delay, "ms...");
			await new Promise(r => setTimeout(r, delay));
		}
		console.error("[ONT] ❌ Failed to load ontologies after all retries");
	})();

</script>


