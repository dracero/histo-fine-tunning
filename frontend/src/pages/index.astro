	/* Tooltip */
	.box-tooltip { position: fixed; z-index: 1000; background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; padding: 0.5rem 0.75rem; font-size: 0.75rem; pointer-events: none; color: #fff; box-shadow: 0 4px 20px rgba(0,0,0,0.4); display: flex; flex-direction: column; gap: 0.15rem; transform: translate(15px, 15px); }
	.tooltip-category { font-weight: 700; font-size: 0.8rem; }
	.tooltip-score { font-weight: 600; color: var(--accent-cyan); }
