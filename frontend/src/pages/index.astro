		// Also load images if available in the ontology document or backend disk
		if (ontology.pdf_id) {
			_currentPdfData = {
				pdf_id: ontology.pdf_id,
				filename: ontology.source_pdf || "paper.pdf",
				images: ontology.extracted_images || [],
			};

			// Fetch live images list from backend
			fetch(`${API_URL}/pdf-images/${ontology.pdf_id}`)
				.then(r => r.ok ? r.json() : null)
				.then(data => {
					if (data && data.images && data.images.length > 0) {
						_currentPdfData.images = data.images;
						renderPdfImagesCrud(data.images, ontology.pdf_id);
					} else if (ontology.extracted_images && ontology.extracted_images.length > 0) {
						renderPdfImagesCrud(ontology.extracted_images, ontology.pdf_id);
					}
				})
				.catch(err => {
					console.warn("Could not fetch live PDF images:", err);
					if (ontology.extracted_images && ontology.extracted_images.length > 0) {
						renderPdfImagesCrud(ontology.extracted_images, ontology.pdf_id);
					}
				});
