---
// SAM 3 Histology Auto-Segmenter with Annotation Editor & Roboflow Export
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>SAM 3 — Annotator + Roboflow Trainer</title>
		<meta name="description" content="Segmentación automática con SAM 3, edición de anotaciones y entrenamiento en Roboflow" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<div class="app-container">
			<header class="app-header">
				<div class="logo-area">
					<div class="glowing-orb"></div>
					<h1>SAM 3 <span class="gradient-text">Annotator</span></h1>
					<span class="badge">Multi-Image + Roboflow</span>
					<div class="model-status-pills" id="model-status-pills">
						<span class="model-pill active" title="Meta AI Segment Anything Model 3.1">
							<span class="dot green"></span> SAM 3.1
						</span>
						<span class="model-pill" id="conch-pill" title="MahmoodLab CONCH Vision-Language (512d)">
							<span class="dot" id="conch-dot"></span> CONCH (512d)
						</span>
						<span class="model-pill" id="uni-pill" title="MahmoodLab UNI ViT-Large (1024d)">
							<span class="dot" id="uni-dot"></span> UNI (1024d)
						</span>
						<span class="model-pill active" id="ont-pill" style="border-color: rgba(6,182,212,0.4); background: rgba(6,182,212,0.1); cursor: pointer;" title="Ontología activa. Click para ver ontología e imágenes del PDF.">
							<span class="dot green"></span> 🧬 <strong id="ont-pill-name" style="color: var(--accent-cyan); font-weight: 700;">Cargando...</strong>
						</span>
					</div>
				</div>
				<p class="subtitle">Segmentación multi-prompt con SAM 3.1 + clasificación histológica zero-shot con CONCH + ontologías automáticas de PDFs y exportación a Roboflow.</p>
			</header>

			<main class="app-main">
				<!-- LEFT COLUMN: Image Gallery + Controls -->
				<aside class="sidebar-panel">
					<!-- Tab Buttons -->
					<div class="tab-bar">
						<button class="tab-btn active" data-tab="images-tab">🖼️ Imágenes</button>
						<button class="tab-btn" data-tab="pdf-tab">📄 PDFs & Ontología</button>
						<button class="tab-btn" data-tab="classes-tab">🏷️ Clases</button>
						<button class="tab-btn" data-tab="export-tab">🚀 Exportar</button>
					</div>

					<!-- ==================== IMAGES TAB ==================== -->
					<div class="tab-content active" id="images-tab">
						<label for="file-input" class="upload-zone" id="drop-zone" style="cursor: pointer;">
							<input type="file" id="file-input" accept="image/*" multiple class="file-hidden" />
							<div class="upload-content" id="upload-content">
								<svg xmlns="http://www.w3.org/2000/svg" class="upload-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
								</svg>
								<p class="upload-text">Arrastra imágenes o <span class="text-link">seleccionalas</span></p>
								<p class="upload-hint">PNG, JPG, JPEG, TIFF — Múltiples archivos</p>
							</div>
						</label>

						<!-- Image Gallery -->
						<div class="image-gallery" id="image-gallery"></div>

						<!-- Segmentation controls -->
						<div class="parameters-area">
							<div class="form-group">
								<label for="custom-prompt-input">Patrón visual adicional:</label>
								<div class="input-with-btn">
									<input type="text" id="custom-prompt-input" placeholder="Ej: elongated dark nucleus" class="form-input" />
									<button type="button" id="re-segment-btn" class="btn-small">Re-segmentar</button>
								</div>
							</div>

							<div class="form-group">
								<div class="slider-header">
									<label for="threshold-slider">Umbral de confianza</label>
									<span id="threshold-val" class="slider-val">0.35</span>
								</div>
								<input type="range" id="threshold-slider" min="0.01" max="0.95" step="0.01" value="0.35" class="form-range" />
							</div>
						</div>

						<!-- Status -->
						<div class="status-area" id="status-area">
							<div class="status-idle" id="status-idle">
								<span class="status-dot idle"></span>
								<span>Esperando imágenes...</span>
							</div>
							<div class="status-running" id="status-running" style="display:none;">
								<span class="spinner-small"></span>
								<span id="status-text">Segmentando...</span>
							</div>
						</div>
					</div>

					<!-- ==================== CLASSES TAB ==================== -->
					<div class="tab-content" id="classes-tab">
						<div class="classes-header" style="flex-direction: column; gap: 0.5rem; align-items: stretch; margin-bottom: 0.5rem;">
							<div style="display: flex; justify-content: space-between; align-items: center;">
								<h3 class="section-title-sm">Clases y Categorías</h3>
								<button type="button" id="merge-classes-btn" class="btn-small btn-outline" disabled>Fusionar</button>
							</div>
							<div style="display: flex; gap: 0.35rem;">
								<input type="text" id="new-class-input" placeholder="Añadir clase (ej: Limón)" style="flex: 1; font-size: 0.78rem; padding: 0.35rem 0.5rem; background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-main);" />
								<button type="button" id="add-class-btn" class="btn-small btn-green" style="white-space: nowrap;">➕ Clase</button>
							</div>
							<button type="button" id="classify-conch-btn" class="btn-action btn-primary-action" style="margin-top: 0.35rem; font-size: 0.78rem; padding: 0.45rem 0.75rem;">
								🔬 Auto-Clasificar con CONCH
							</button>
						</div>
						<div id="classes-list" class="classes-list">
							<p class="empty-hint">Segmenta una imagen para ver las clases detectadas.</p>
						</div>
					</div>

					<!-- ==================== EXPORT TAB ==================== -->
					<div class="tab-content" id="export-tab">
						<div class="export-section">
							<h3 class="section-title-sm">Exportar Dataset</h3>

							<div class="export-stats" id="export-stats">
								<div class="stat-item">
									<span class="stat-val" id="stat-total-imgs">0</span>
									<span class="stat-lbl">Imágenes</span>
								</div>
								<div class="stat-item">
									<span class="stat-val" id="stat-annotated-imgs">0</span>
									<span class="stat-lbl">Anotadas</span>
								</div>
								<div class="stat-item">
									<span class="stat-val" id="stat-total-dets">0</span>
									<span class="stat-lbl">Instancias</span>
								</div>
								<div class="stat-item">
									<span class="stat-val" id="stat-total-classes">0</span>
									<span class="stat-lbl">Clases</span>
								</div>
							</div>

							<button type="button" id="export-coco-btn" class="btn-action btn-outline">
								💾 Descargar COCO JSON
							</button>

							<div class="divider"></div>

							<h3 class="section-title-sm">Roboflow Pipeline</h3>
							<div class="roboflow-status" id="rf-status">
								<span class="status-dot" id="rf-dot"></span>
								<span id="rf-status-text">Verificando conexión...</span>
							</div>

							<div class="form-group" style="margin-top: 0.75rem;">
								<label for="rf-project-name">Proyecto Roboflow:</label>
								<input type="text" id="rf-project-name" placeholder="nombre-del-proyecto" class="form-input" />
							</div>

							<button type="button" id="rf-upload-btn" class="btn-action btn-primary-action" style="margin-top: 0.5rem;">
								☁️ Subir Dataset a Roboflow
							</button>

							<button type="button" id="rf-train-btn" class="btn-action btn-green" style="margin-top: 0.25rem;">
								⚡ Entrenar Modelo en Roboflow
							</button>

							<div id="rf-log-area" class="rf-log" style="display: none;">
								<div id="rf-log-content"></div>
							</div>
						</div>
					</div>

					<!-- ==================== PDF ONTOLOGY TAB ==================== -->
					<div class="tab-content" id="pdf-tab">
						<div class="pdf-section">
							<h3 class="section-title-sm">Subir PDF Académico</h3>
							<p style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.75rem;">Subí un PDF de histología o microscopía. Se extrae el texto, se generan las ontologías con IA y podés gestionar y segmentar todas sus imágenes.</p>

							<div class="upload-zone" id="pdf-drop-zone" style="min-height: 90px; padding: 1rem; border: 2px dashed rgba(6,182,212,0.3); background: rgba(6,182,212,0.03); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem;">
								<div class="upload-content" id="pdf-upload-content" style="display: flex; flex-direction: column; align-items: center; width: 100%;">
									<svg xmlns="http://www.w3.org/2000/svg" class="upload-icon" style="width: 28px; height: 28px; color: var(--accent-cyan);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
									</svg>
									<p class="upload-text" style="font-size: 0.8rem; margin-bottom: 0.4rem;">Arrastrá un PDF acá o elegí el archivo:</p>
								</div>
								<input type="file" id="pdf-file-input" accept=".pdf" onchange="window._handlePdfUpload && window._handlePdfUpload(this)" style="font-size: 0.75rem; color: var(--text-main); background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: 6px; padding: 0.35rem 0.5rem; cursor: pointer; max-width: 100%;" />
							</div>

							<!-- PDF extraction results summary -->
							<div id="pdf-results" style="display: none;">
								<div class="pdf-info-card" style="background: var(--bg-tertiary); border-radius: 8px; padding: 0.75rem; margin-top: 0.75rem; border: 1px solid var(--border-color);">
									<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
										<span id="pdf-filename" style="font-weight: 600; font-size: 0.8rem; color: var(--accent-cyan);"></span>
										<span id="pdf-pages-badge" class="badge" style="font-size: 0.65rem;"></span>
									</div>
									<div style="display: flex; gap: 1rem; font-size: 0.72rem; color: var(--text-muted);">
										<span>📄 <strong id="pdf-text-len"></strong> caracteres</span>
										<span>🖼️ <strong id="pdf-img-count">0</strong> imágenes</span>
									</div>
								</div>

								<!-- Text preview accordion -->
								<details style="margin-top: 0.5rem;">
									<summary style="font-size: 0.75rem; cursor: pointer; color: var(--text-muted); user-select: none;">Ver texto extraído</summary>
									<div id="pdf-text-preview" style="max-height: 140px; overflow-y: auto; font-size: 0.7rem; color: var(--text-muted); background: var(--bg-main); padding: 0.5rem; border-radius: 6px; margin-top: 0.35rem; white-space: pre-wrap; word-break: break-word;"></div>
								</details>

								<!-- Generate ontology trigger -->
								<div style="margin-top: 0.75rem;">
									<div class="form-group" style="margin-bottom: 0.5rem;">
										<label for="domain-name-input" style="font-size: 0.72rem;">Nombre del dominio (opcional):</label>
										<input type="text" id="domain-name-input" placeholder="Ej: histologia_testiculo" class="form-input" style="font-size: 0.78rem;" />
									</div>
									<button type="button" id="generate-ontology-btn" class="btn-action btn-primary-action">
										🧬 Generar Ontología con IA
									</button>
									<div id="ontology-generating" style="display: none; text-align: center; padding: 0.75rem; justify-content: center; align-items: center; gap: 0.5rem;">
										<span class="spinner-small"></span>
										<span style="font-size: 0.75rem; color: var(--text-muted);">Generando ontología con Gemini...</span>
									</div>
								</div>
							</div>

							<!-- ONTOLOGY & PDF IMAGES SECTION (Visible together) -->
							<div id="ontology-workbench" style="display: none; margin-top: 1rem;">
								<!-- Top Action Bar for PDF Images Batch Segmentation -->
								<div class="batch-action-card" style="background: linear-gradient(135deg, rgba(139,92,246,0.15), rgba(6,182,212,0.15)); border: 1px solid var(--accent-cyan); border-radius: 10px; padding: 0.75rem; margin-bottom: 1rem;">
									<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
										<span style="font-size: 0.8rem; font-weight: 700; color: #fff;">🚀 Segmentación en Lote</span>
										<span id="batch-img-badge" class="badge">0 imágenes</span>
									</div>
									<p style="font-size: 0.7rem; color: var(--text-muted); margin-bottom: 0.6rem;">Envía todas las imágenes extraídas a la galería y ejecuta SAM 3 + clasificación CONCH con esta ontología.</p>
									<button type="button" id="batch-segment-pdf-btn" class="btn-action btn-green" style="margin: 0; font-size: 0.8rem;">
										⚡ Segmentar Todas las Imágenes con esta Ontología
									</button>
								</div>

								<!-- 1. Ontology structures editor -->
								<div id="ontology-editor" class="panel-box" style="margin-bottom: 1rem;">
									<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
										<h3 class="section-title-sm" style="margin: 0;">🧬 Ontología del Dominio</h3>
										<div style="display: flex; gap: 0.35rem;">
											<button type="button" id="save-ontology-btn" class="btn-small btn-green" style="font-size: 0.7rem; padding: 0.25rem 0.5rem;">💾 Guardar</button>
											<button type="button" id="apply-ontology-btn" class="btn-small btn-primary-action" style="font-size: 0.7rem; padding: 0.25rem 0.5rem;">🎯 Activar</button>
										</div>
									</div>
									<div id="ontology-structures-list" style="max-height: 280px; overflow-y: auto;"></div>
								</div>

								<!-- 2. PDF Extracted Images CRUD Gallery -->
								<div id="pdf-images-crud-section" class="panel-box">
									<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
										<div>
											<h3 class="section-title-sm" style="margin: 0;">🖼️ Imágenes del PDF</h3>
											<span style="font-size: 0.65rem; color: var(--text-muted);">Edita captions, elimina gráficos no deseados o agrega imágenes.</span>
										</div>
										<div>
											<input type="file" id="pdf-add-image-input" accept="image/*" class="file-hidden" />
											<button type="button" id="pdf-add-image-btn" class="btn-small btn-outline" style="font-size: 0.7rem; padding: 0.25rem 0.55rem;">
												➕ Agregar
											</button>
										</div>
									</div>
									
									<div id="pdf-images-crud-grid" class="pdf-crud-grid">
										<p class="empty-hint" style="font-size: 0.72rem;">No hay imágenes extraídas disponibles.</p>
									</div>
								</div>
							</div>

							<!-- Saved ontologies list -->
							<div class="divider" style="margin: 0.75rem 0;"></div>
							<h3 class="section-title-sm">Ontologías guardadas</h3>
							<div id="saved-ontologies-list">
								<p class="empty-hint" style="font-size: 0.72rem;">No hay ontologías guardadas aún.</p>
							</div>
						</div>
					</div>
				</aside>

				<!-- CENTER: Viewer -->
				<section class="viewer-panel panel-card">
					<div class="viewer-header">
						<h2 class="section-title">Visor de Anotaciones</h2>
						<div class="viewer-controls" id="viewer-controls" style="display: none;">
							<button type="button" id="toggle-click-mode" class="btn-small btn-primary-action" style="font-size: 0.75rem; padding: 0.25rem 0.6rem;">
								👆 Modo Click (SAM 3)
							</button>
							<button type="button" id="toggle-draw-mode" class="btn-small btn-outline" style="font-size: 0.75rem; padding: 0.25rem 0.6rem;">
								✏️ Dibujar Polígono
							</button>
							<button type="button" id="finish-polygon-btn" class="btn-small btn-green" style="font-size: 0.75rem; padding: 0.25rem 0.6rem; display: none;">
								✓ Finalizar Polígono
							</button>
							<button type="button" id="toggle-conch-classify-btn" class="btn-small btn-outline" style="font-size: 0.75rem; padding: 0.25rem 0.6rem;" title="Clasificar detecciones con CONCH zero-shot">
								🔬 Clasificar CONCH
							</button>
							<span class="separator">|</span>
							<label class="toggle-container">
								<input type="checkbox" id="toggle-polygons" checked />
								<span class="toggle-label">Polígonos</span>
							</label>
							<label class="toggle-container">
								<input type="checkbox" id="toggle-boxes" />
								<span class="toggle-label">Boxes</span>
							</label>
							<span class="separator">|</span>
							<span id="detections-counter" class="counter-badge">0 detecciones</span>
						</div>
					</div>

					<!-- Selection toolbar -->
					<div class="selection-toolbar" id="selection-toolbar" style="display: none;">
						<span id="selection-count">0 seleccionadas</span>
						<select id="reassign-select" class="form-input-sm">
							<option value="">Mover a clase...</option>
						</select>
						<button type="button" id="delete-selected-btn" class="btn-small btn-danger">🗑️ Eliminar</button>
						<button type="button" id="deselect-btn" class="btn-small btn-outline">✕ Deseleccionar</button>
					</div>

					<div class="viewer-content">
						<div class="empty-viewer" id="empty-viewer">
							<svg xmlns="http://www.w3.org/2000/svg" class="empty-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
							</svg>
							<p>Sube imágenes y la segmentación comenzará automáticamente.</p>
							<p class="upload-hint">Luego podrás editar clases, eliminar detecciones erróneas, y exportar a Roboflow.</p>
						</div>

						<div class="image-viewport" id="image-viewport" style="display: none;">
							<div class="viewer-container" id="viewer-container">
								<img id="display-image" src="" alt="Histología" />
								<svg id="overlay-svg" class="overlay-svg" xmlns="http://www.w3.org/2000/svg"></svg>
							</div>
						</div>
					</div>
				</section>
			</main>
		</div>

		<!-- Tooltip -->
		<div id="box-tooltip" class="box-tooltip" style="display: none;">
			<div class="tooltip-category" id="tooltip-category">-</div>
			<div class="tooltip-score">Confianza: <span id="tooltip-score-val">0.00</span></div>
			<div class="tooltip-coords">Box: <span id="tooltip-coords-val">0, 0</span></div>
			<div class="tooltip-hint">Click = seleccionar · Shift+Click = multi-select</div>
		</div>

		<!-- Context menu -->
		<div id="context-menu" class="context-menu" style="display: none;">
			<div class="ctx-header" id="ctx-header">Detección</div>
			<div class="ctx-item" id="ctx-delete">🗑️ Eliminar</div>
			<div class="ctx-separator"></div>
			<div class="ctx-sub-header">Mover a clase:</div>
			<div id="ctx-class-list" class="ctx-class-list"></div>
		</div>

		<!-- Roboflow Code Snippet Modal -->
		<div id="roboflow-snippet-modal" class="modal-backdrop" style="display: none;">
			<div class="modal-card">
				<div class="modal-header">
					<h3>📦 Código Python Roboflow (Versión Unificada v<span id="modal-version-num">1</span>)</h3>
					<button type="button" id="close-modal-btn" class="btn-small btn-outline" style="padding: 0.2rem 0.5rem;">✕</button>
				</div>
				<div class="modal-body">
					<p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem;">
						Copia este código Python para descargar la versión unificada del dataset directamente en Google Colab, Jupyter Notebook o en tu PC:
					</p>

					<div class="code-box-container" style="position: relative;">
						<button type="button" id="copy-snippet-btn" class="btn-small btn-primary-action" style="position: absolute; top: 8px; right: 8px; font-size: 0.75rem; padding: 0.25rem 0.6rem; z-index: 10;">
							📋 Copiar Código
						</button>
						<pre id="snippet-code-block" style="background: #0d1117; border: 1px solid var(--border-color); color: #e6edf3; padding: 1rem; border-radius: 8px; font-family: monospace; font-size: 0.82rem; overflow-x: auto; white-space: pre-wrap; margin: 0;"></pre>
					</div>

					<div style="margin-top: 1rem; padding: 0.75rem; background: rgba(56, 189, 248, 0.1); border-left: 3px solid #38bdf8; border-radius: 6px;">
						<div style="font-size: 0.78rem; font-weight: 600; color: #38bdf8; margin-bottom: 0.25rem;">Ubicación descargada en tu PC local:</div>
						<code id="modal-export-path" style="font-size: 0.75rem; color: var(--text-main); word-break: break-all;"></code>
					</div>
				</div>
			</div>
		</div>

		<!-- PDF Image Preview Modal (Lightbox) -->
		<div id="image-preview-modal" class="modal-backdrop" style="display: none;">
			<div class="modal-card modal-card-lg">
