							</select>
							<span id="active-tool-status" style="font-size: 0.72rem; color: #38bdf8; font-style: italic; margin-left: 0.3rem;"></span>
						</div>
					</div>

					<!-- Selection toolbar -->
					<div class="selection-toolbar" id="selection-toolbar" style="display: none; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
						<span id="selection-count">0 seleccionadas</span>
						<button type="button" id="toolbar-validate-gemini-btn" class="btn-small btn-primary-action" style="background: linear-gradient(135deg, #0284c7, #38bdf8); color: #fff; font-weight: 700; border: none; padding: 0.25rem 0.65rem; border-radius: 4px; cursor: pointer; display: flex; align-items: center; gap: 0.3rem;" title="Evaluar la estructura seleccionada con Gemini 3.5 / 3.8 para obtener la probabilidad de elección correcta">
							⚖️ Evaluar con Gemini (LLM)
						</button>
						<select id="reassign-select" class="form-input-sm">
							<option value="">Mover a clase...</option>
						</select>
						<button type="button" id="toolbar-dedup-btn" class="btn-small btn-outline" style="font-size: 0.72rem; padding: 0.25rem 0.5rem; color: #fbbf24; border-color: rgba(251,191,36,0.4);" title="Elimina detecciones duplicadas o superpuestas en la misma coordenada">
							🧹 Resolver Duplicados
						</button>
						<button type="button" id="delete-selected-btn" class="btn-small btn-danger">🗑️ Eliminar</button>
						<button type="button" id="deselect-btn" class="btn-small btn-outline">✕ Deseleccionar</button>
					</div>

					<div class="viewer-content">
						<div class="empty-viewer" id="empty-viewer">
							<svg xmlns="http://www.w3.org/2000/svg" class="empty-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
							</svg>
							<p>Sube imágenes o cárgalas desde un PDF ontológico para iniciar la segmentación (Micro o Macro).</p>
							<p class="upload-hint">Haz clic sobre cualquier célula o capa para que Gemini 3.5 evalúe y valide tu reconocimiento histológico.</p>
						</div>

						<div class="image-viewport" id="image-viewport" style="display: none;">
							<div class="viewer-container" id="viewer-container">
								<img id="display-image" src="" alt="Histología" />
								<svg id="overlay-svg" class="overlay-svg" xmlns="http://www.w3.org/2000/svg"></svg>
							</div>
						</div>
					</div>
				</section>
			</main>
		</div>

		<!-- Tooltip -->
		<div id="box-tooltip" class="box-tooltip" style="display: none;">
			<div class="tooltip-category" id="tooltip-category">-</div>
			<div class="tooltip-score">Confianza: <span id="tooltip-score-val">0.00</span></div>
			<div class="tooltip-coords">Box: <span id="tooltip-coords-val">0, 0</span></div>
			<div id="tooltip-reason-val" style="display: none; font-size: 0.72rem; color: #cbd5e1; margin-top: 4px; padding-top: 4px; border-top: 1px dashed rgba(255,255,255,0.2); max-width: 260px; line-height: 1.3;"></div>
			<div class="tooltip-hint">Click = seleccionar · Shift+Click = multi-select</div>
		</div>

		<!-- Context menu -->
		<div id="context-menu" class="context-menu" style="display: none;">
			<div class="ctx-header" id="ctx-header">Estructura Histológica</div>
			<div class="ctx-item" id="ctx-student-validate" style="color: #38bdf8; font-weight: 700;">⚖️ Evaluar con Gemini (Probabilidad LLM)</div>
			<div class="ctx-separator"></div>
			<div class="ctx-item" id="ctx-delete">🗑️ Eliminar</div>
			<div class="ctx-separator"></div>
			<div class="ctx-sub-header">Mover a clase:</div>
			<div id="ctx-class-list" class="ctx-class-list"></div>
		</div>

		<!-- PDF Image Preview Modal (Lightbox) -->
		<div id="image-preview-modal" class="modal-backdrop" style="display: none;">
			<div class="modal-card modal-card-lg">
				<div class="modal-header">
					<h3 id="modal-img-title">🖼️ Vista Previa de Imagen</h3>
					<button type="button" id="close-img-modal-btn" class="btn-small btn-outline" style="padding: 0.2rem 0.5rem;">✕</button>
				</div>
				<div class="modal-body" style="text-align: center;">
					<div class="modal-img-container">
						<img id="modal-img-preview" src="" alt="Vista previa" style="max-height: 55vh; max-width: 100%; border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); object-fit: contain;" />
					</div>
					<div style="margin-top: 1rem; text-align: left;">
						<div id="modal-img-meta" style="font-size: 0.75rem; color: var(--accent-cyan); margin-bottom: 0.35rem;"></div>
						<div class="form-group">
							<label for="modal-img-caption-input" style="font-size: 0.75rem;">Pie de foto / Caption:</label>
							<textarea id="modal-img-caption-input" rows="2" class="form-input" style="width: 100%; font-size: 0.8rem;"></textarea>
						</div>
						<div style="display: flex; justify-content: space-between; margin-top: 0.75rem; gap: 0.5rem;">
							<button type="button" id="modal-save-caption-btn" class="btn-small btn-green">💾 Guardar Cambios</button>
							<button type="button" id="modal-use-single-img-btn" class="btn-small btn-primary-action">🎯 Segmentar esta imagen</button>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Batch Segmentation Progress Modal -->
		<div id="batch-progress-modal" class="modal-backdrop" style="display: none;">
			<div class="modal-card">
				<div class="modal-header">
					<h3>🚀 Segmentación en Lote (SAM 3 + CONCH)</h3>
				</div>
				<div class="modal-body" style="text-align: center; padding: 1.5rem;">
					<div class="spinner-small" style="width: 32px; height: 32px; margin: 0 auto 1rem; border-width: 3px;"></div>
					<h4 id="batch-step-title" style="font-size: 0.95rem; margin-bottom: 0.5rem; color: var(--text-main);">Procesando imágenes...</h4>
					<p id="batch-step-desc" style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 1rem;">Ejecutando inferencia de SAM 3 y clasificación histológica zero-shot con CONCH...</p>
					<div class="progress-bar" style="height: 10px; margin-bottom: 0.5rem; background: rgba(255,255,255,0.1); border-radius: 9999px; overflow: hidden;">
						<div class="progress-fill" id="batch-progress-fill" style="width: 0%; height: 100%; background: linear-gradient(90deg, var(--primary), var(--accent-cyan)); transition: width 0.3s;"></div>
					</div>
					<span id="batch-progress-text" style="font-size: 0.75rem; color: var(--accent-cyan); font-weight: 600;">0 / 0 procesadas (0%)</span>
				</div>
			</div>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--bg-dark: #070913;
		--bg-panel: rgba(15, 23, 42, 0.45);
		--bg-sidebar: rgba(15, 23, 42, 0.65);
		--bg-tertiary: rgba(30, 41, 59, 0.5);
		--bg-main: rgba(15, 23, 42, 0.8);
		--border-color: rgba(255, 255, 255, 0.08);
		--border-active: rgba(139, 92, 246, 0.5);
		--text-main: #f8fafc;
		--text-muted: #94a3b8;
		--primary: #8b5cf6;
		--primary-hover: #a78bfa;
		--primary-glow: rgba(139, 92, 246, 0.4);
		--accent-cyan: #06b6d4;
		--accent-green: #10b981;
		--accent-red: #f43f5e;
		--font-family: 'Inter', sans-serif;
		--font-title: 'Outfit', sans-serif;
	}

	/* Model Status Pills */
	.model-status-pills { display: flex; gap: 0.35rem; margin-left: 0.5rem; flex-wrap: wrap; }
	.model-pill { display: flex; align-items: center; gap: 0.35rem; font-size: 0.65rem; padding: 0.15rem 0.45rem; border-radius: 9999px; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); color: var(--text-muted); font-family: var(--font-family); }
	.model-pill.active { border-color: rgba(6,182,212,0.4); color: var(--text-main); background: rgba(6,182,212,0.08); }
	.model-pill .dot { width: 6px; height: 6px; border-radius: 50%; background: #64748b; }
	.model-pill .dot.green { background: #10b981; box-shadow: 0 0 6px #10b981; }
	.model-pill .dot.purple { background: #a855f7; box-shadow: 0 0 6px #a855f7; }

	/* Prompt Suggestion Chips */
	.prompt-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.68rem;
		padding: 0.2rem 0.5rem;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid var(--border-color);
		color: var(--text-muted);
		cursor: pointer;
		transition: all 0.15s ease;
		user-select: none;
	}
	.prompt-chip:hover {
		background: rgba(139, 92, 246, 0.15);
		border-color: var(--primary);
		color: var(--text-main);
		transform: translateY(-1px);
	}
	.prompt-chip.active {
		background: rgba(6, 182, 212, 0.2);
		border-color: var(--accent-cyan);
		color: #fff;
		font-weight: 600;
	}

	/* Panel Box */
	.panel-box { background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: 10px; padding: 0.75rem; }

	/* PDF Images CRUD Grid */
	.pdf-crud-grid { display: flex; flex-direction: column; gap: 0.5rem; max-height: 380px; overflow-y: auto; margin-top: 0.5rem; }
	.pdf-img-card { display: flex; gap: 0.6rem; padding: 0.5rem; background: var(--bg-main); border: 1px solid var(--border-color); border-radius: 8px; transition: all 0.15s; }
	.pdf-img-card:hover { border-color: rgba(6,182,212,0.3); background: rgba(6,182,212,0.02); }
	.pdf-img-thumb-wrapper { position: relative; width: 70px; height: 70px; flex-shrink: 0; border-radius: 6px; overflow: hidden; cursor: pointer; }
	.pdf-img-thumb { width: 100%; height: 100%; object-fit: cover; }
	.pdf-img-zoom-hint { position: absolute; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.15s; font-size: 1rem; color: #fff; }
	.pdf-img-thumb-wrapper:hover .pdf-img-zoom-hint { opacity: 1; }
	.pdf-img-details { flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
	.pdf-img-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem; }
	.pdf-img-badge { font-size: 0.62rem; color: var(--accent-cyan); background: rgba(6,182,212,0.1); padding: 0.1rem 0.35rem; border-radius: 4px; }
	.pdf-img-caption-input { font-size: 0.72rem; padding: 0.2rem 0.4rem; background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-main); width: 100%; font-family: var(--font-family); }
	.pdf-img-caption-input:focus { border-color: var(--accent-cyan); }
	.pdf-img-actions { display: flex; justify-content: flex-end; gap: 0.3rem; margin-top: 0.3rem; }

	.modal-card-lg { max-width: 800px; width: 95%; }

	* { box-sizing: border-box; margin: 0; padding: 0; }

	body {
		background-color: var(--bg-dark);
		color: var(--text-main);
		font-family: var(--font-family);
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background-image: 
			radial-gradient(circle at 10% 20%, rgba(139, 92, 246, 0.08) 0%, transparent 40%),
			radial-gradient(circle at 90% 80%, rgba(6, 182, 212, 0.08) 0%, transparent 40%);
		background-attachment: fixed;
		overflow-x: hidden;
	}

	.app-container { width: 100%; max-width: 1600px; margin: 0 auto; padding: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; flex-grow: 1; }
	.app-header { text-align: left; position: relative; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color); }
	.logo-area { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.4rem; }
	.glowing-orb { width: 12px; height: 12px; border-radius: 50%; background-color: var(--accent-cyan); box-shadow: 0 0 12px var(--accent-cyan), 0 0 24px var(--accent-cyan); }
	.app-header h1 { font-family: var(--font-title); font-weight: 800; font-size: 2rem; letter-spacing: -0.03em; }
	.gradient-text { background: linear-gradient(135deg, var(--primary) 0%, var(--accent-cyan) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
	.badge { font-size: 0.7rem; font-weight: 600; padding: 0.2rem 0.55rem; border-radius: 9999px; background: rgba(6, 182, 212, 0.15); border: 1px solid rgba(6, 182, 212, 0.3); color: var(--accent-cyan); letter-spacing: 0.05em; }
	.subtitle { color: var(--text-muted); font-size: 0.95rem; font-weight: 400; max-width: 900px; }

	/* ===== LAYOUT ===== */
	.app-main { display: grid; grid-template-columns: 380px 1fr; gap: 1.5rem; align-items: start; }
	@media (max-width: 1024px) { .app-main { grid-template-columns: 1fr; } }

	/* ===== SIDEBAR ===== */
	.sidebar-panel { background: var(--bg-sidebar); backdrop-filter: blur(16px); border: 1px solid var(--border-color); border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.3); }

	/* Tabs */
	.tab-bar { display: flex; border-bottom: 1px solid var(--border-color); }
	.tab-btn { flex: 1; padding: 0.75rem 0.5rem; background: none; border: none; color: var(--text-muted); font-size: 0.8rem; font-weight: 600; cursor: pointer; border-bottom: 2px solid transparent; transition: all 0.15s; font-family: var(--font-family); }
	.tab-btn:hover { color: var(--text-main); background: rgba(255,255,255,0.03); }
	.tab-btn.active { color: var(--accent-cyan); border-bottom-color: var(--accent-cyan); background: rgba(6, 182, 212, 0.05); }
	.tab-content { display: none; padding: 1.25rem; max-height: calc(100vh - 220px); overflow-y: auto; }
	.tab-content.active { display: block; }

	/* Upload Zone */
	.upload-zone { border: 2px dashed rgba(255, 255, 255, 0.15); border-radius: 12px; padding: 1.5rem 1rem; text-align: center; cursor: pointer; position: relative; transition: all 0.2s; background: rgba(255, 255, 255, 0.01); min-height: 120px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
	.upload-zone:hover { border-color: var(--primary); background: rgba(139, 92, 246, 0.03); }
	.upload-zone.dragover { border-color: var(--accent-cyan); background: rgba(6, 182, 212, 0.05); }
	.file-hidden { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; overflow: hidden; }
	.upload-icon { width: 32px; height: 32px; color: var(--text-muted); margin-bottom: 0.5rem; }
	.upload-text { font-size: 0.85rem; color: var(--text-main); margin-bottom: 0.3rem; font-weight: 500; }
	.text-link { color: var(--primary-hover); text-decoration: underline; }
	.upload-hint { font-size: 0.72rem; color: var(--text-muted); }

	/* Image Gallery */
	.image-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin-top: 1rem; }
	.gallery-thumb { position: relative; aspect-ratio: 1; border-radius: 8px; overflow: hidden; cursor: pointer; border: 2px solid transparent; transition: all 0.15s; }
	.gallery-thumb img { width: 100%; height: 100%; object-fit: cover; }
	.gallery-thumb.active { border-color: var(--accent-cyan); box-shadow: 0 0 12px rgba(6, 182, 212, 0.3); }
	.gallery-thumb .thumb-badge { position: absolute; top: 4px; right: 4px; width: 8px; height: 8px; border-radius: 50%; }
	.gallery-thumb .thumb-badge.pending { background: var(--accent-red); }
	.gallery-thumb .thumb-badge.annotated { background: var(--accent-green); }
	.gallery-thumb .thumb-remove { position: absolute; top: 2px; left: 2px; width: 18px; height: 18px; border-radius: 50%; background: rgba(244, 63, 94, 0.8); border: none; color: white; font-size: 10px; cursor: pointer; display: none; align-items: center; justify-content: center; line-height: 1; }
	.gallery-thumb:hover .thumb-remove { display: flex; }
	.gallery-thumb .thumb-count { position: absolute; bottom: 2px; right: 4px; font-size: 0.65rem; background: rgba(0,0,0,0.7); color: white; padding: 1px 4px; border-radius: 4px; }

	/* Parameters */
