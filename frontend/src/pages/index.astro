	async function handlePdfUpload(file) {
		console.log("[PDF] handlePdfUpload starting for:", file.name, file.size);
		const uploadContent = document.getElementById("pdf-upload-content");
		if (uploadContent) {
			uploadContent.innerHTML = `
				<div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
					<span class="spinner-small"></span>
					<span style="font-size: 0.78rem; color: var(--accent-cyan);">[1/3] Extrayendo texto e imágenes de ${file.name}...</span>
				</div>
			`;
		}

		const formData = new FormData();
		formData.append("file", file);

		try {
			console.log("[PDF] Uploading to backend...");
			const res = await fetch(`${API_URL}/upload-pdf`, { method: "POST", body: formData });
			console.log("[PDF] Upload response status:", res.status);
			if (!res.ok) {
				const err = await res.json().catch(() => ({ detail: "Error al procesar PDF" }));
				throw new Error(err.detail || "Error al procesar PDF");
			}

			const data = await res.json();
			console.log("[PDF] Extraction result:", {
				pdf_id: data.pdf_id,
				pages: data.total_pages,
				images: data.total_images,
				text_len: data.text_length,
			});
			_currentPdfData = {
				...data,
				_file: file,
			};

			// Show results safely
			const fnEl = document.getElementById("pdf-filename");
			const pagesEl = document.getElementById("pdf-pages-badge");
			const textLenEl = document.getElementById("pdf-text-len");
			const imgCountEl = document.getElementById("pdf-img-count");
			const previewEl = document.getElementById("pdf-text-preview");

			if (fnEl) fnEl.textContent = data.filename;
			if (pagesEl) pagesEl.textContent = `${data.total_pages} págs`;
			if (textLenEl) textLenEl.textContent = (data.text_length || 0).toLocaleString();
			if (imgCountEl) imgCountEl.textContent = data.total_images || 0;
			if (previewEl) previewEl.textContent = data.text_preview || "";

			if (pdfResults) pdfResults.style.display = "block";

			// Render extracted images in the CRUD gallery
			renderPdfImagesCrud(data.images || [], data.pdf_id);

			// Show workbench
			if (ontologyWorkbench) ontologyWorkbench.style.display = "block";

			// Step-by-step real-time progress
			const explicitDomain = document.getElementById("domain-name-input")?.value?.trim() || null;
			const mergeLabel = explicitDomain
				? `[2/3] Generando ontología "${explicitDomain}" con Gemini IA...`
				: `[2/3] Generando ontología temática con Gemini IA...`;
			if (uploadContent) {
				uploadContent.innerHTML = `
					<div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
						<span class="spinner-small"></span>
						<span style="font-size: 0.78rem; color: var(--accent-cyan);">${mergeLabel}</span>
					</div>
				`;
			}

			// Automatically trigger Gemini ontology extraction with timeout
			try {
				const ontologyPayload = {
					pdf_id: data.pdf_id,
					filename: data.filename,
					text: data.text_preview,
					images: data.images || [],
					domain_name: explicitDomain || null,
				};

				console.log("[PDF] Generating ontology, payload:", {
					pdf_id: ontologyPayload.pdf_id,
					domain_name: ontologyPayload.domain_name || "(auto)",
					text_len: ontologyPayload.text?.length || 0,
					images_count: ontologyPayload.images?.length || 0,
				});

				// Use AbortController with 300s timeout for large multimodal histology ontologies
				const controller = new AbortController();
				const timeoutId = setTimeout(() => controller.abort(), 300000);

				const ontRes = await fetch(`${API_URL}/generate-ontology`, {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(ontologyPayload),
					signal: controller.signal,
				});
				clearTimeout(timeoutId);

				console.log("[PDF] Ontology generation response status:", ontRes.status);

				if (ontRes.ok) {
					const ontResult = await ontRes.json();
					const updatedOntology = ontResult.ontology;
					console.log("[PDF] Ontology generated successfully:", {
						domain: updatedOntology?.domain,
						structures: updatedOntology?.structures?.length,
						images: updatedOntology?.extracted_images?.length,
						merge_stats: ontResult.merge_stats || null,
					});
					displayOntologyEditor(updatedOntology);
					window._activeOntologyName = updatedOntology?.domain || mergeTarget;
					loadSavedOntologies();

					// CRITICAL: Update _currentPdfData with the full merged ontology data so the UI and batch operations have ALL accumulated images
					if (updatedOntology && updatedOntology.extracted_images) {
						_currentPdfData = {
							pdf_id: updatedOntology.pdf_id,
							filename: updatedOntology.source_pdf,
							total_images: updatedOntology.extracted_images.length,
							images: updatedOntology.extracted_images,
							structures: updatedOntology.structures,
							domain: updatedOntology.domain,
							_file: file,
						};
						// Update the PDF gallery to render ALL accumulated images
						renderPdfImagesCrud(updatedOntology.extracted_images, updatedOntology.pdf_id);
					}

					// Show merge stats if applicable
					if (ontResult.merge_stats) {
						const ms = ontResult.merge_stats;
						const statsMsg = `✅ Ontología "${ms.merged_into}" actualizada: +${ms.added} nuevas estructuras (${ms.total_after_merge} total, ${_currentPdfData?.images?.length || 0} imágenes acumuladas)`;
						console.log("[PDF]", statsMsg);
						if (uploadContent) {
							uploadContent.innerHTML = `
								<div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; flex-wrap: wrap;">
									<span style="font-size: 0.78rem; color: #10b981; font-weight: 600;">${statsMsg}</span>
								</div>
							`;
						}
					}
				} else {
					const ontErrData = await ontRes.json().catch(() => ({ detail: "Error al generar ontología" }));
					console.error("[PDF] Ontology generation error:", ontErrData);
					alert("⚠️ No se pudo generar la ontología con Gemini: " + (ontErrData.detail || "Verifique la API Key de Gemini en .env"));
				}
			} catch (ontErr) {
				if (ontErr.name === "AbortError") {
					console.error("[PDF] Ontology generation timed out (300s)");
					alert("⚠️ La generación de ontología tardó más del límite esperado. Intentá de nuevo con el botón 'Generar Ontología con IA'.");
				} else {
					console.error("[PDF] Ontology generation exception:", ontErr);
					alert("⚠️ Error de conexión al generar ontología: " + ontErr.message);
				}
			}

			// Step 3: Load first image into canvas
			if (uploadContent && !uploadContent.innerHTML.includes("✅")) {
				uploadContent.innerHTML = `
					<div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
						<span class="spinner-small"></span>
						<span style="font-size: 0.78rem; color: #10b981;">[3/3] Abriendo primera imagen en el lienzo central...</span>
					</div>
				`;
			}

			if (data.images && data.images.length > 0) {
				await transferPdfImageToGallery(data.images[0], data.pdf_id, false);
			}

			updatePdfSourceSelect();

			if (uploadContent) {
				uploadContent.innerHTML = `
					<div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.35rem; width: 100%; padding: 0.25rem 0;">
						<span style="font-size: 0.8rem; color: #10b981; font-weight: 600;">✅ PDF procesado y ontología lista</span>
						<span style="font-size: 0.72rem; color: var(--text-muted);">${data.total_images || 0} imágenes extraídas (${data.filename})</span>
						<div style="display: flex; gap: 0.4rem; margin-top: 0.25rem; flex-wrap: wrap; justify-content: center;">
							<button type="button" id="go-to-annotate-btn" class="btn-small btn-primary-action" style="font-size: 0.72rem; padding: 0.3rem 0.6rem; pointer-events: auto; cursor: pointer;">
								🎨 Ir a Anotar en Sección Imágenes ➔
							</button>
						</div>
						<span style="font-size: 0.65rem; color: var(--text-muted); margin-top: 0.2rem;">(Hacé click afuera del botón o arrastrá para cambiar de PDF)</span>
					</div>
				`;
				document.getElementById("go-to-annotate-btn")?.addEventListener("click", async (e) => {
					e.stopPropagation();
					e.preventDefault();
					if (data.images && data.images.length > 0) {
						await importAllPdfImagesToGallery(data.images, data.pdf_id, true);
					} else {
						switchTab("images-tab");
					}
				});
			}

		} catch (e) {
			console.error("[PDF] handlePdfUpload error:", e);
			if (uploadContent) {
				uploadContent.innerHTML = `
					<p style="color: #ef4444; font-size: 0.78rem; margin-bottom: 0.3rem;">❌ ${e.message}</p>
					<p class="upload-text" style="font-size: 0.72rem;">Hacé click acá o arrastrá para intentar con otro archivo PDF.</p>
				`;
			}
		} finally {
			if (pdfFileInput) pdfFileInput.value = "";
		}
	}

	// --- 4. Generate Ontology with Gemini ---
	generateOntologyBtn?.addEventListener("click", async () => {
		if (!_currentPdfData) return alert("Primero subí un PDF.");

		if (generateOntologyBtn) generateOntologyBtn.style.display = "none";
		if (ontologyGenerating) ontologyGenerating.style.display = "flex";

		try {
			const mergeTarget = window._activeOntologyName || null;
			const payload = {
				pdf_id: _currentPdfData.pdf_id,
				filename: _currentPdfData.filename,
				text: _currentPdfData.text_preview,
				images: _currentPdfData.images || [],
				domain_name: document.getElementById("domain-name-input")?.value?.trim() || mergeTarget || null,
			};
			// Auto-merge into active ontology if one exists
			if (mergeTarget) {
				payload.merge_into_ontology = mergeTarget;
			}

			console.log("[PDF] Manual generate-ontology, merge_into:", mergeTarget || "(new)");

			const controller = new AbortController();
			const timeoutId = setTimeout(() => controller.abort(), 300000);

			const res = await fetch(`${API_URL}/generate-ontology`, {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(payload),
				signal: controller.signal,
			});
			clearTimeout(timeoutId);

			if (!res.ok) {
				const err = await res.json().catch(() => ({ detail: "Error generando ontología" }));
				throw new Error(err.detail || "Error generando ontología");
			}

			const result = await res.json();
			displayOntologyEditor(result.ontology);
			loadSavedOntologies();

			if (result.merge_stats) {
				const ms = result.merge_stats;
				alert(`✅ Ontología "${ms.merged_into}" actualizada: +${ms.added} nuevas estructuras (${ms.total_after_merge} total)`);
			}

		} catch (e) {
			if (e.name === "AbortError") {
				alert("⚠️ La generación de ontología tardó más del límite esperado. Intentá de nuevo.");
			} else {
				alert("Error: " + e.message);
			}
		} finally {
			if (generateOntologyBtn) generateOntologyBtn.style.display = "block";
			if (ontologyGenerating) ontologyGenerating.style.display = "none";
		}
	});

	function displayOntologyEditor(ontology) {
		if (!ontology) return;
		window._activeOntologyData = ontology;
		ontologyWorkbench.style.display = "block";
		ontologyEditor.style.display = "block";
		ontologyEditor.dataset.domain = ontology.domain;
		window._activeOntologyName = ontology.domain;

		const ontPillName = document.getElementById("ont-pill-name");
		if (ontPillName) ontPillName.textContent = ontology.tissue_name ? `${ontology.domain} (${ontology.tissue_name})` : ontology.domain;

		const ontTissueBadge = document.getElementById("ont-tissue-badge");
		if (ontTissueBadge) {
			const macroCount = ontology.macro_structures?.length || (ontology.structures || []).filter(s => s.is_macro).length;
			const microCount = ontology.micro_structures?.length || (ontology.structures || []).filter(s => !s.is_macro).length;
			ontTissueBadge.innerHTML = `🏷️ Tejido: <strong style="color: #fff;">${ontology.tissue_name || 'Tejido Histológico General'}</strong> <span style="font-size: 0.65rem; color: var(--text-muted); font-weight: normal; margin-left: 0.35rem;">(${macroCount} Macro SAM 3.1 • ${microCount} Micro Cellpose-SAM con Ontología Espacial)</span>`;
		}

		function createStructureRow(struct, isMacro) {
			const row = document.createElement("div");
			row.style.cssText = "background: var(--bg-main); border: 1px solid var(--border-color); border-radius: 8px; padding: 0.55rem; margin-bottom: 0.4rem;";
			row.dataset.key = struct.key;

			const roleBadge = struct.role ? `<span style="font-size: 0.6rem; padding: 1px 5px; border-radius: 4px; background: var(--bg-tertiary); color: var(--text-muted);">${struct.role}</span>` : '';
			const engineBadge = isMacro
				? `<span style="font-size: 0.6rem; padding: 1px 5px; border-radius: 4px; background: rgba(59,130,246,0.18); color: #60a5fa; font-weight: 600;">🏛️ SAM 3.1</span>`
				: `<span style="font-size: 0.6rem; padding: 1px 5px; border-radius: 4px; background: rgba(16,185,129,0.18); color: #34d399; font-weight: 600;">🔬 Cellpose-SAM</span>`;

			let spatialHtml = "";
			if (!isMacro && struct.spatial_rules && Object.keys(struct.spatial_rules).length > 0) {
				const sr = struct.spatial_rules;
				const rulesBadges = [];
				if (sr.compartment) rulesBadges.push(`<span style="color: #38bdf8;">📍 Compartimento: ${sr.compartment}</span>`);
				if (sr.forbidden_in && sr.forbidden_in.length > 0) {
					rulesBadges.push(`<span style="color: #f87171;">🚫 Prohibido en: ${Array.isArray(sr.forbidden_in) ? sr.forbidden_in.join(", ") : sr.forbidden_in}</span>`);
				}
				if (sr.parent_macro) rulesBadges.push(`<span style="color: #a78bfa;">🏢 En: ${sr.parent_macro}</span>`);
				if (sr.relative_radial_position && Array.isArray(sr.relative_radial_position)) {
					rulesBadges.push(`<span style="color: #fbbf24;">📏 Radio: [${sr.relative_radial_position.join(" - ")}]</span>`);
				}

				spatialHtml = `
					<div style="font-size: 0.65rem; background: rgba(0,0,0,0.25); padding: 0.35rem 0.5rem; border-radius: 5px; margin-top: 0.35rem; border-left: 2px solid #34d399;">
						<div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.15rem; font-weight: 600;">${rulesBadges.join(" • ")}</div>
						${sr.rule_description ? `<div style="color: var(--text-muted); font-style: italic;">💡 ${sr.rule_description}</div>` : ''}
					</div>
				`;
			}

			row.innerHTML = `
				<div style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.3rem; flex-wrap: wrap;">
					<input type="color" value="${struct.color || '#8b5cf6'}" class="ont-color" style="width: 20px; height: 20px; border: none; cursor: pointer; background: none; border-radius: 4px;" />
					<input type="text" value="${struct.label || struct.name}" class="ont-label" style="flex: 1; min-width: 110px; font-size: 0.78rem; font-weight: 600; background: transparent; border: none; color: var(--text-main); outline: none;" />
					<div style="display: flex; gap: 0.25rem; align-items: center;">
						${roleBadge}
						${engineBadge}
					</div>
				</div>
				<div style="display: flex; align-items: center; gap: 0.35rem;">
					<span style="font-size: 0.65rem; color: var(--text-muted); min-width: 44px;">Prompt:</span>
					<input type="text" value="${struct.prompt || ''}" class="ont-prompt" style="flex: 1; font-size: 0.7rem; padding: 0.2rem 0.35rem; background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--accent-cyan); font-family: monospace;" />
				</div>
				${struct.name_en ? `<div style="font-size: 0.65rem; color: var(--text-muted); margin-top: 0.2rem;">EN: ${struct.name_en}</div>` : ''}
				${spatialHtml}
			`;
			return row;
		}

		const container = document.getElementById("ontology-structures-list");
		if (container) {
			container.innerHTML = "";

			const allStructures = ontology.structures || [];
			const macroList = allStructures.filter(s => s.is_macro);
			const microList = allStructures.filter(s => !s.is_macro);

			if (macroList.length > 0) {
				const macroHeader = document.createElement("div");
				macroHeader.style.cssText = "font-size: 0.72rem; font-weight: 700; color: #60a5fa; margin: 0.4rem 0 0.35rem; display: flex; align-items: center; justify-content: space-between; padding-bottom: 0.2rem; border-bottom: 1px solid rgba(96,165,250,0.2);";
				macroHeader.innerHTML = `<span>🏛️ Macroestructuras Anatómicas</span><span style="font-size: 0.62rem; background: rgba(59,130,246,0.18); color: #93c5fd; padding: 1px 6px; border-radius: 4px;">SAM 3.1 (Límites & Cavidades)</span>`;
				container.appendChild(macroHeader);

				for (const struct of macroList) {
					container.appendChild(createStructureRow(struct, true));
				}
			}

			if (microList.length > 0) {
				const microHeader = document.createElement("div");
				microHeader.style.cssText = "font-size: 0.72rem; font-weight: 700; color: #34d399; margin: 0.8rem 0 0.35rem; display: flex; align-items: center; justify-content: space-between; padding-bottom: 0.2rem; border-bottom: 1px solid rgba(52,211,153,0.2);";
				microHeader.innerHTML = `<span>🔬 Microestructuras & Células</span><span style="font-size: 0.62rem; background: rgba(16,185,129,0.18); color: #6ee7b7; padding: 1px 6px; border-radius: 4px;">Cellpose-SAM + Reglas Espaciales</span>`;
				container.appendChild(microHeader);

				for (const struct of microList) {
					container.appendChild(createStructureRow(struct, false));
				}
			}

			if (macroList.length === 0 && microList.length === 0) {
				for (const struct of allStructures) {
					container.appendChild(createStructureRow(struct, Boolean(struct.is_macro)));
				}
			}
		}

		// Synchronize with classRegistry
		if (ontology.structures && ontology.structures.length > 0) {
			classRegistry = ontology.structures.map((s, idx) => ({
				id: s.id || (idx + 1),
				key: s.key,
				name: s.label || s.name || s.key,
				prompt: s.prompt,
				color: s.color || "#8b5cf6",
				is_macro: Boolean(s.is_macro),
				target_engine: s.target_engine || (s.is_macro ? "sam3" : "cellpose"),
				role: s.role || (s.is_macro ? "compartment" : "cell"),
				spatial_rules: s.spatial_rules || {},
				expected_diameter_px: s.expected_diameter_px || (s.is_macro ? null : 20),
			}));
			updateClassesList();
		}

		// Also load images if available in the ontology document or backend disk
		if (ontology.pdf_id || (ontology.extracted_images && ontology.extracted_images.length > 0)) {
			const targetPdfId = ontology.pdf_id || (ontology.extracted_images && ontology.extracted_images[0]?.pdf_id) || "unknown";
			_currentPdfData = {
				pdf_id: targetPdfId,
				filename: ontology.source_pdf || "paper.pdf",
				images: ontology.extracted_images || [],
			};
			updatePdfSourceSelect();

			if (ontology.pdf_id) {
				// Fetch live images list from backend
				fetch(`${API_URL}/pdf-images/${ontology.pdf_id}`)
					.then(r => r.ok ? r.json() : null)
					.then(data => {
						if (data && data.images && data.images.length > 0) {
							_currentPdfData.images = data.images;
							renderPdfImagesCrud(data.images, ontology.pdf_id);
							updatePdfSourceSelect();
						} else if (ontology.extracted_images && ontology.extracted_images.length > 0) {
							renderPdfImagesCrud(ontology.extracted_images, ontology.pdf_id);
						}
					})
					.catch(err => {
						console.warn("Could not fetch live PDF images:", err);
						if (ontology.extracted_images && ontology.extracted_images.length > 0) {
							renderPdfImagesCrud(ontology.extracted_images, ontology.pdf_id);
						}
					});
			} else if (ontology.extracted_images && ontology.extracted_images.length > 0) {
				renderPdfImagesCrud(ontology.extracted_images, targetPdfId);
			}
		}
	}

	// Save ontology structures
	document.getElementById("save-ontology-btn")?.addEventListener("click", async () => {
		const domain = ontologyEditor.dataset.domain;
		if (!domain) return;

		const existingMap = new Map((window._activeOntologyData?.structures || []).map(s => [s.key, s]));
		const rows = document.querySelectorAll("#ontology-structures-list > div[data-key]");
		const structures = [];
		for (const row of rows) {
			const k = row.dataset.key;
			const prev = existingMap.get(k) || {};
			structures.push({
				...prev,
				key: k,
				name: row.querySelector(".ont-label")?.value || prev.name || k,
				label: row.querySelector(".ont-label")?.value || prev.label || k,
				prompt: row.querySelector(".ont-prompt")?.value || prev.prompt || "",
				color: row.querySelector(".ont-color")?.value || prev.color || "#8b5cf6",
			});
		}

		try {
			const res = await fetch(`${API_URL}/ontology/${domain}`, {
				method: "PUT",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ structures }),
			});
			if (!res.ok) throw new Error("Error al guardar");
			alert("✅ Ontología guardada correctamente.");
			loadSavedOntologies();
		} catch (e) {
			alert("Error: " + e.message);
		}
	});

	// Validate Spatial Ontology Constraints
	document.getElementById("validate-spatial-btn")?.addEventListener("click", async () => {
		if (!activeImageKey) return alert("Por favor selecciona una imagen primero.");
		const activeData = imageStore.get(activeImageKey);
		if (!activeData || !activeData.groups || activeData.groups.length === 0) {
			return alert("No hay anotaciones ni detecciones en la imagen activa para validar.");
		}

		// Separate macro annotations from cell/micro detections
		const macroAnnotations = [];
		const microDetections = [];

		for (const group of activeData.groups) {
			const clsMeta = classRegistry.find(c => c.key === group.key) || {};
			const isMacro = clsMeta.is_macro || ["cavity", "boundary_outer", "boundary_inner", "stroma", "layer", "compartment"].includes(clsMeta.role);

			for (const det of group.detections) {
				if (det._deleted) continue;
				if (isMacro) {
					macroAnnotations.push({
						class_key: group.key,
						label: group.label || group.key,
						segmentation: det.segmentation || [],
						box: det.box,
						bbox: det.bbox,
					});
				} else {
					microDetections.push({
						class_key: group.key,
						label: group.label || group.key,
						box: det.box,
						bbox: det.bbox,
						centroid: det.centroid,
						detRef: det,
					});
				}
			}
		}

		if (macroAnnotations.length === 0) {
			return alert("⚠️ No se encontraron macroestructuras anatómicas segmentadas (ej: luz, membrana basal, estroma) en esta imagen para contrastar con las células. Segmenta primero las macroestructuras con SAM 3.1.");
		}

		if (microDetections.length === 0) {
			return alert("⚠️ No hay detecciones celulares/microestructurales en la imagen activa.");
		}

		try {
			const payload = {
				domain: window._activeOntologyName || null,
				detections: microDetections.map(d => ({
					class_key: d.class_key,
					label: d.label,
					box: d.box,
					bbox: d.bbox,
					centroid: d.centroid,
				})),
				macro_annotations: macroAnnotations,
				spatial_rules: window._activeOntologyData?.spatial_rules || [],
			};

			const res = await fetch(`${API_URL}/validate-spatial-ontology`, {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(payload),
			});

			if (!res.ok) {
				const err = await res.json().catch(() => ({ detail: "Error validando ontología espacial" }));
				throw new Error(err.detail || "Error en validación espacial");
			}

			const result = await res.json();
			if (result.violations_count === 0) {
				alert(`✅ Validación Anatómica Exitosa:\n\nTodas las ${result.valid_count} células evaluadas cumplen estrictamente con la ontología espacial y distribución anatómica del tejido.`);
			} else {
				const sampleViolations = result.violations.slice(0, 5).map(v => `• ${v.reason}`).join("\n");
				const extraMsg = result.violations_count > 5 ? `\n... y ${result.violations_count - 5} más.` : "";
				const confirmDelete = confirm(
					`⚠️ Se detectaron ${result.violations_count} violaciones espaciales anatómicas:\n\n${sampleViolations}${extraMsg}\n\n¿Deseas marcar o eliminar automáticamente las detecciones en zonas prohibidas?`
				);
				if (confirmDelete) {
					for (const v of result.violations) {
						if (microDetections[v.detection_index]?.detRef) {
							microDetections[v.detection_index].detRef._deleted = true;
						}
					}
					renderOverlay();
					renderGallery();
					updateClassesList();
					updateExportStats();
					alert(`🗑️ Se eliminaron ${result.violations_count} detecciones que violaban las restricciones espaciales.`);
				}
			}
		} catch (e) {
			alert("Error en validación espacial: " + e.message);
		}
	});

	// Apply ontology
	document.getElementById("apply-ontology-btn")?.addEventListener("click", () => {
		const domain = ontologyEditor.dataset.domain;
		if (!domain) return;
		window._activeOntologyName = domain;

		// Switch to images tab
		switchTab("images-tab");

		// Update status
		statusIdle.innerHTML = `
			<span class="status-dot" style="background: #10b981;"></span>
			<span>Ontología activa: <strong style="color: var(--accent-cyan);">${domain}</strong></span>
		`;
		statusIdle.style.display = "flex";
	});


	// --- 5. PDF Images CRUD Interface & Lightbox ---

	function renderPdfImagesCrud(images, pdf_id) {
		if (!pdfImagesCrudGrid) return;
		pdfImagesCrudGrid.innerHTML = "";

		const countBadge = document.getElementById("batch-img-badge");
		if (countBadge) countBadge.textContent = `${images.length} imágenes`;

		if (!images || images.length === 0) {
			pdfImagesCrudGrid.innerHTML = '<p class="empty-hint" style="font-size: 0.72rem;">No hay imágenes extraídas disponibles.</p>';
			return;
		}

		for (const img of images) {
			const card = document.createElement("div");
			card.className = "pdf-img-card";
			card.dataset.filename = img.filename;

			const targetPdfId = img.pdf_id || pdf_id;
			const imgUrl = `${API_URL}/pdf-image/${targetPdfId}/${img.filename}`;

			card.innerHTML = `
				<div class="pdf-img-thumb-wrapper" title="Click para vista previa y zoom">
					<img src="${imgUrl}" class="pdf-img-thumb" alt="Fig ${img.page || ''}" />
					<div class="pdf-img-zoom-hint">🔍</div>
				</div>
				<div class="pdf-img-details">
					<div class="pdf-img-header">
						<span class="pdf-img-badge">Pág ${img.page || '1'} · ${img.width || 0}x${img.height || 0}px</span>
						<button type="button" class="btn-small btn-danger pdf-img-del-btn" style="padding: 0.15rem 0.4rem; font-size: 0.65rem;" title="Eliminar imagen">🗑️</button>
					</div>
					<input type="text" class="pdf-img-caption-input" value="${img.caption || ''}" placeholder="Pie de figura / caption..." title="Edita el pie de figura y presiona Enter o el botón Guardar" />
					<div class="pdf-img-actions">
						<button type="button" class="btn-small btn-green pdf-img-save-btn" style="padding: 0.15rem 0.45rem; font-size: 0.65rem;" title="Guardar caption">💾</button>
						<button type="button" class="btn-small btn-primary-action pdf-img-use-btn" style="padding: 0.15rem 0.55rem; font-size: 0.68rem; font-weight: 600;" title="Abrir y anotar esta imagen en la sección Imágenes">🎯 Anotar</button>
					</div>
				</div>
			`;

			// Event: Open Lightbox preview
			card.querySelector(".pdf-img-thumb-wrapper").addEventListener("click", () => {
				openImagePreviewModal(img, pdf_id);
			});

			// Event: Save caption
			const captionInput = card.querySelector(".pdf-img-caption-input");
			const saveCaption = async () => {
				const newCaption = captionInput.value.trim();
				const targetPdfId = img.pdf_id || pdf_id || (_currentPdfData && _currentPdfData.pdf_id);
				if (!targetPdfId) return;
				try {
					const res = await fetch(`${API_URL}/pdf-image/${encodeURIComponent(targetPdfId)}/${encodeURIComponent(img.filename)}`, {
						method: "PUT",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ caption: newCaption }),
					});
					if (res.ok) {
						img.caption = newCaption;
						captionInput.style.borderColor = "#10b981";
						setTimeout(() => { captionInput.style.borderColor = ""; }, 1500);
					}
				} catch (e) {
					console.error("Error updating caption:", e);
				}
			};

			card.querySelector(".pdf-img-save-btn").addEventListener("click", saveCaption);
			captionInput.addEventListener("keydown", (e) => {
				if (e.key === "Enter") {
					e.preventDefault();
					saveCaption();
				}
			});

			// Event: Delete image
			card.querySelector(".pdf-img-del-btn").addEventListener("click", async (e) => {
				e.stopPropagation();
				if (!confirm(`¿Eliminar la imagen ${img.filename}?`)) return;

				const targetPdfId = img.pdf_id || pdf_id || (_currentPdfData && _currentPdfData.pdf_id);
				if (!targetPdfId) return;

				try {
					const res = await fetch(`${API_URL}/pdf-image/${encodeURIComponent(targetPdfId)}/${encodeURIComponent(img.filename)}`, {
						method: "DELETE",
					});
					if (res.ok) {
						if (_currentPdfData && _currentPdfData.images) {
							_currentPdfData.images = _currentPdfData.images.filter(i => i.filename !== img.filename);
						}
						card.style.opacity = "0";
