		statusIdle.style.display = "none";
		statusRunning.style.display = "flex";
		let totalProcessed = 0;
		let totalClassifiedDets = 0;

		for (let idx = 0; idx < keysToProcess.length; idx++) {
			const key = keysToProcess[idx];
			const data = imageStore.get(key);
			if (!data) continue;

			if (!data.groups || data.groups.length === 0) {
				statusText.textContent = `[${idx + 1}/${keysToProcess.length}] Auto-segmentando ${data.filename}...`;
				await runAutoSegmentation(key);
			}

			let allDets = [];
			(data.groups || []).forEach((g) => {
				if (g.detections) {
					g.detections.forEach((d) => {
						allDets.push({
							...d,
							id: d.id,
							class_key: d.class_key || g.key,
							class_label: d.class_label || g.label,
							category_id: d.category_id || g.key,
							color: d.color || g.color,
							bbox: d.bbox || (d.box ? [d.box[0], d.box[1], d.box[2] - d.box[0], d.box[3] - d.box[1]] : null),
							box: d.box || (d.bbox ? [d.bbox[0], d.bbox[1], d.bbox[0] + d.bbox[2], d.bbox[1] + d.bbox[3]] : null),
							score: d.score !== undefined ? d.score : 0.95,
						});
					});
				}
			});

			if (allDets.length === 0) continue;

			let candidateClasses = classRegistry.map(c => ({
				key: c.key,
				name: c.name,
				label: c.name,
				prompt: c.prompt || c.name,
				color: c.color,
			}));

			if (candidateClasses.length === 0) {
				candidateClasses = data.groups.map(g => ({
					key: g.key,
					name: g.label,
					label: g.label,
					prompt: g.label,
					color: g.color,
				}));
			}

			statusText.textContent = `[${idx + 1}/${keysToProcess.length}] 🦕 DINO (Lunit ViT-S/8): Clasificando ${allDets.length} células en ${data.filename}...`;

			try {
				let imageFile = data.file;
				if (!(imageFile instanceof File || imageFile instanceof Blob) && data.dataUrl) {
					const arr = data.dataUrl.split(",");
					const mime = arr[0].match(/:(.*?);/)[1];
					const bstr = atob(arr[1]);
					let n = bstr.length;
					const u8arr = new Uint8Array(n);
					while (n--) u8arr[n] = bstr.charCodeAt(n);
					imageFile = new File([u8arr], data.filename || "image.png", { type: mime });
				}

				const formData = new FormData();
				formData.append("image", imageFile);
				formData.append("detections", JSON.stringify(allDets));
				formData.append("classes", JSON.stringify(candidateClasses));
				formData.append("temperature", "0.08");
				if (window._activeOntologyName) {
					formData.append("ontology_name", window._activeOntologyName);
				}

				let res = await fetch(`${API_URL}/classify-dino`, {
					method: "POST",
					body: formData,
				});

				if (!res.ok) {
					console.warn(`Error en DINO ${data.filename}: ${res.status}`);
					continue;
				}

				const result = await res.json();
				const classified = result.detections || [];

				if (classified.length > 0) {
					const groupsMap = new Map();
					for (let i = 0; i < classified.length; i++) {
						const det = classified[i];
						const origDet = allDets[i] || {};

						det.segmentation = det.segmentation || origDet.segmentation || [];
						det.box = det.box || origDet.box;
						det.bbox = det.bbox || origDet.bbox;
						det.score = det.confidence !== undefined ? det.confidence : (origDet.score || 0.95);

						const groupKey = det.class_key || det.category_id || "clase_1";
						if (!groupsMap.has(groupKey)) {
							groupsMap.set(groupKey, {
								key: groupKey,
								label: det.class_label || groupKey,
								color: det.color || getClassColor(groupKey),
								detections: [],
							});
						}
						groupsMap.get(groupKey).detections.push(det);

						if (!classRegistry.find(c => c.key === groupKey)) {
							classRegistry.push({
								id: classIdCounter++,
								name: det.class_label || groupKey,
								color: det.color || "#8b5cf6",
								key: groupKey,
								prompt: det.class_label || groupKey,
							});
						}
					}
					data.groups = Array.from(groupsMap.values());
					totalClassifiedDets += classified.length;
					totalProcessed++;
					renderGallery();
					updateExportStats();
				}
			} catch (err) {
				console.error(`Error en DINO ${data.filename}:`, err);
			}
		}

		if (activeImageKey) {
			viewerControls.style.display = "flex";
			renderOverlay();
			updateClassesList();
		}
		renderGallery();
		updateExportStats();

		statusText.textContent = `✅ DINO Lunit Lote: ${totalProcessed} imágenes clasificadas (${totalClassifiedDets} células).`;
		setTimeout(() => {
			statusRunning.style.display = "none";
			statusIdle.style.display = "flex";
		}, 3500);
	}

	classifyDinoBtn?.addEventListener("click", () => runDinoClassification());

	// --- 3. Virchow 2 + UNI + CONCH + DINO Quad-Ensemble (Batch-Aware) ---
	const extractVirchowBtn = document.getElementById("extract-virchow-btn");

	async function runVirchowExtraction(targetKey = null) {
		const keysToProcess = (typeof targetKey === "string" && targetKey)
			? [targetKey]
			: Array.from(imageStore.keys());

		if (keysToProcess.length === 0) {
			alert("No hay imágenes cargadas para clasificar con el ensamble.");
			return;
		}

		statusIdle.style.display = "none";
		statusRunning.style.display = "flex";
		let totalProcessed = 0;
		let totalClassifiedDets = 0;

		for (let idx = 0; idx < keysToProcess.length; idx++) {
			const key = keysToProcess[idx];
			const data = imageStore.get(key);
			if (!data) continue;

			// Auto-segment if this image doesn't have detections yet
			if (!data.groups || data.groups.length === 0) {
				statusText.textContent = `[${idx + 1}/${keysToProcess.length}] Auto-segmentando ${data.filename}...`;
				await runAutoSegmentation(key);
			}

			let allDets = [];
			(data.groups || []).forEach((g) => {
				if (g.detections) {
					g.detections.forEach((d) => {
						allDets.push({
							...d,
							id: d.id,
							class_key: d.class_key || g.key,
							class_label: d.class_label || g.label,
							category_id: d.category_id || g.key,
							color: d.color || g.color,
							bbox: d.bbox || (d.box ? [d.box[0], d.box[1], d.box[2] - d.box[0], d.box[3] - d.box[1]] : null),
							box: d.box || (d.bbox ? [d.bbox[0], d.bbox[1], d.bbox[0] + d.bbox[2], d.bbox[1] + d.bbox[3]] : null),
							score: d.score !== undefined ? d.score : 0.95,
						});
					});
				}
			});

			if (allDets.length === 0) continue;

			let candidateClasses = classRegistry.map(c => ({
				key: c.key,
				name: c.name,
				label: c.name,
				prompt: c.prompt || c.name,
				color: c.color,
			}));

			if (candidateClasses.length === 0) {
				candidateClasses = data.groups.map(g => ({
					key: g.key,
					name: g.label,
					label: g.label,
					prompt: g.label,
					color: g.color,
				}));
			}

			statusText.textContent = `[${idx + 1}/${keysToProcess.length}] 🧬 Ensamble (Virchow+UNI+CONCH+DINO): Clasificando ${allDets.length} células en ${data.filename}...`;

			try {
				let imageFile = data.file;
				if (!(imageFile instanceof File || imageFile instanceof Blob) && data.dataUrl) {
					const arr = data.dataUrl.split(",");
					const mime = arr[0].match(/:(.*?);/)[1];
					const bstr = atob(arr[1]);
					let n = bstr.length;
					const u8arr = new Uint8Array(n);
					while (n--) u8arr[n] = bstr.charCodeAt(n);
					imageFile = new File([u8arr], data.filename || "image.png", { type: mime });
				}

				const formData = new FormData();
				formData.append("image", imageFile);
				formData.append("detections", JSON.stringify(allDets));
				formData.append("classes", JSON.stringify(candidateClasses));
				formData.append("temperature", "0.05");
				if (window._activeOntologyName) {
					formData.append("ontology_name", window._activeOntologyName);
				}

				let res = await fetch(`${API_URL}/classify-virchow-prototypes`, {
					method: "POST",
					body: formData,
				});

				if (!res.ok && res.status === 404) {
					res = await fetch(`${API_URL}/classify-detections-conch`, {
						method: "POST",
						body: formData,
					});
				}

				if (!res.ok) {
					console.warn(`Error en ensamble ${data.filename}: ${res.status}`);
					continue;
				}

				const result = await res.json();
				const classified = result.detections || [];

				if (classified.length > 0) {
					const groupsMap = new Map();
					for (let i = 0; i < classified.length; i++) {
						const det = classified[i];
						const origDet = allDets[i] || {};

						det.segmentation = det.segmentation || origDet.segmentation || [];
						det.box = det.box || origDet.box;
						det.bbox = det.bbox || origDet.bbox;
						det.score = det.virchow_confidence !== undefined ? det.virchow_confidence : (det.conch_confidence || origDet.score || 0.95);

						const groupKey = det.class_key || det.category_id || "clase_1";
						if (!groupsMap.has(groupKey)) {
							groupsMap.set(groupKey, {
								key: groupKey,
								label: det.class_label || groupKey,
								color: det.color || getClassColor(groupKey),
								detections: [],
							});
						}
						groupsMap.get(groupKey).detections.push(det);

						if (!classRegistry.find(c => c.key === groupKey)) {
							classRegistry.push({
								id: classIdCounter++,
								name: det.class_label || groupKey,
								color: det.color || "#8b5cf6",
								key: groupKey,
								prompt: det.class_label || groupKey,
							});
						}
					}
					data.groups = Array.from(groupsMap.values());
					totalClassifiedDets += classified.length;
					totalProcessed++;
					renderGallery();
					updateExportStats();
				}
			} catch (err) {
				console.error(`Error en ensamble ${data.filename}:`, err);
			}
		}

		if (activeImageKey) {
			viewerControls.style.display = "flex";
			renderOverlay();
			updateClassesList();
		}
		renderGallery();
		updateExportStats();

		statusText.textContent = `✅ Ensamble de Patología Lote: ${totalProcessed} imágenes clasificadas (${totalClassifiedDets} células).`;
		setTimeout(() => {
			statusRunning.style.display = "none";
			statusIdle.style.display = "flex";
		}, 3500);
	}

	extractVirchowBtn?.addEventListener("click", () => runVirchowExtraction());

		// =========================================================================
	// --- 4. MICRO/MACRO STRUCTURE SEGMENTATION & STUDENT EVALUATION (GEMINI 3.5) ---
	// =========================================================================

	// Structure Scale State ("micro" vs "macro")
	let currentStructureScale = "micro";

	// Student Evaluation State
	let studentEvaluations = [];
	let studentStats = {
