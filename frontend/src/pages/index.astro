	// --- 2. Zero-Shot Classification with CONCH ---
	async function runConchClassification() {
		if (!activeImageKey) {
			alert("Selecciona primero una imagen con segmentaciones.");
			return;
		}

		const data = imageStore.get(activeImageKey);
		if (!data || !data.groups || data.groups.length === 0) {
			alert("Esta imagen no tiene detecciones para clasificar. Ejecuta primero la segmentación.");
			return;
		}

		// Flatten all detections
		let allDets = [];
		data.groups.forEach((g) => {
			if (g.detections) {
				g.detections.forEach((d) => {
					allDets.push({
						id: d.id,
						bbox: d.bbox,
						polygon: d.polygon,
						score: d.score,
						class_key: g.key,
						label: g.label,
						color: g.color,
					});
				});
			}
		});

		if (allDets.length === 0) {
			alert("No hay detecciones válidas en la imagen actual.");
			return;
		}

		// Build candidate classes from classRegistry or active ontology
		let candidateClasses = classRegistry.map(c => ({
			key: c.key,
			name: c.name,
			label: c.name,
			prompt: c.prompt || c.name,
			color: c.color,
		}));

		if (candidateClasses.length === 0) {
			candidateClasses = data.groups.map(g => ({
				key: g.key,
				name: g.label,
				label: g.label,
				prompt: g.label,
				color: g.color,
			}));
		}

		statusIdle.style.display = "none";
		statusRunning.style.display = "flex";
		statusText.textContent = `🔬 CONCH: Clasificando ${allDets.length} células/estructuras...`;

		try {
			const formData = new FormData();
			formData.append("image", data.file);
			formData.append("detections", JSON.stringify(allDets));
			formData.append("classes", JSON.stringify(candidateClasses));
			formData.append("temperature", "0.05");

			const res = await fetch(`${API_URL}/classify-detections-conch`, {
				method: "POST",
				body: formData,
			});

			if (!res.ok) {
				const err = await res.json();
				throw new Error(err.detail || "Error en clasificación CONCH");
			}

			const result = await res.json();
			const classified = result.detections || [];

			// Rebuild groups from classified results
			const groupsMap = new Map();
			for (const det of classified) {
				const groupKey = det.class_key || det.category_id || "clase_1";
				if (!groupsMap.has(groupKey)) {
					groupsMap.set(groupKey, {
						key: groupKey,
						label: det.class_label || groupKey,
						color: det.color || getClassColor(groupKey),
						detections: [],
					});
				}
				groupsMap.get(groupKey).detections.push(det);

				// Ensure class is registered
				if (!classRegistry.find(c => c.key === groupKey)) {
					classRegistry.push({
						id: classIdCounter++,
						name: det.class_label || groupKey,
						color: det.color || "#8b5cf6",
						key: groupKey,
						prompt: det.class_label || groupKey,
					});
				}
			}

			data.groups = Array.from(groupsMap.values());

			// Refresh UI
			selectedDetections.clear();
			updateSelectionToolbar();
			renderOverlay();
			updateClassesList();
			renderGallery();
			updateExportStats();

			statusText.textContent = `✅ CONCH: ${classified.length} detecciones re-clasificadas`;
			setTimeout(() => {
				statusRunning.style.display = "none";
				statusIdle.style.display = "flex";
			}, 3000);

		} catch (e) {
			alert("Error al clasificar con CONCH: " + e.message);
			statusRunning.style.display = "none";
			statusIdle.style.display = "flex";
		}
	}

