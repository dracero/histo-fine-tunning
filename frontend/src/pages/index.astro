---
// SAM 3 Histology Auto-Segmenter with Annotation Editor & Roboflow Export
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>SAM 3 — Annotator + Roboflow Trainer</title>
		<meta name="description" content="Segmentación automática con SAM 3, edición de anotaciones y entrenamiento en Roboflow" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<div class="app-container">
			<header class="app-header">
				<div class="logo-area">
					<div class="glowing-orb"></div>
					<h1>SAM 3 <span class="gradient-text">Annotator</span></h1>
					<span class="badge">Multi-Image + Roboflow</span>
				</div>
				<p class="subtitle">Segmentación automática → edición de clases → entrenamiento en Roboflow. Pensado para imágenes de histología con cientos de células.</p>
			</header>

			<main class="app-main">
				<!-- LEFT COLUMN: Image Gallery + Controls -->
				<aside class="sidebar-panel">
					<!-- Tab Buttons -->
					<div class="tab-bar">
						<button class="tab-btn active" data-tab="images-tab">🖼️ Imágenes</button>
						<button class="tab-btn" data-tab="classes-tab">🏷️ Clases</button>
						<button class="tab-btn" data-tab="export-tab">🚀 Exportar</button>
					</div>

					<!-- ==================== IMAGES TAB ==================== -->
					<div class="tab-content active" id="images-tab">
						<div class="upload-zone" id="drop-zone">
							<input type="file" id="file-input" accept="image/*" multiple class="file-hidden" />
							<div class="upload-content" id="upload-content">
								<svg xmlns="http://www.w3.org/2000/svg" class="upload-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
								</svg>
								<p class="upload-text">Arrastra imágenes o <span class="text-link">seleccionalas</span></p>
								<p class="upload-hint">PNG, JPG, JPEG, TIFF — Múltiples archivos</p>
							</div>
						</div>

						<!-- Image Gallery -->
						<div class="image-gallery" id="image-gallery"></div>

						<!-- Segmentation controls -->
						<div class="parameters-area">
							<div class="form-group">
								<label for="custom-prompt-input">Patrón visual adicional:</label>
								<div class="input-with-btn">
									<input type="text" id="custom-prompt-input" placeholder="Ej: elongated dark nucleus" class="form-input" />
									<button type="button" id="re-segment-btn" class="btn-small">Re-segmentar</button>
								</div>
							</div>

							<div class="form-group">
								<div class="slider-header">
									<label for="threshold-slider">Umbral de confianza</label>
									<span id="threshold-val" class="slider-val">0.05</span>
								</div>
								<input type="range" id="threshold-slider" min="0.01" max="0.95" step="0.01" value="0.05" class="form-range" />
							</div>
						</div>

						<!-- Status -->
						<div class="status-area" id="status-area">
							<div class="status-idle" id="status-idle">
								<span class="status-dot idle"></span>
								<span>Esperando imágenes...</span>
							</div>
							<div class="status-running" id="status-running" style="display:none;">
								<span class="spinner-small"></span>
								<span id="status-text">Segmentando...</span>
							</div>
						</div>
					</div>

					<!-- ==================== CLASSES TAB ==================== -->
					<div class="tab-content" id="classes-tab">
						<div class="classes-header" style="flex-direction: column; gap: 0.5rem; align-items: stretch; margin-bottom: 0.5rem;">
							<div style="display: flex; justify-content: space-between; align-items: center;">
								<h3 class="section-title-sm">Clases y Categorías</h3>
								<button type="button" id="merge-classes-btn" class="btn-small btn-outline" disabled>Fusionar</button>
							</div>
							<div style="display: flex; gap: 0.35rem;">
								<input type="text" id="new-class-input" placeholder="Añadir clase (ej: Limón)" style="flex: 1; font-size: 0.78rem; padding: 0.35rem 0.5rem; background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-main);" />
								<button type="button" id="add-class-btn" class="btn-small btn-green" style="white-space: nowrap;">➕ Clase</button>
							</div>
						</div>
						<div id="classes-list" class="classes-list">
							<p class="empty-hint">Segmenta una imagen para ver las clases detectadas.</p>
						</div>
					</div>

					<!-- ==================== EXPORT TAB ==================== -->
					<div class="tab-content" id="export-tab">
						<div class="export-section">
							<h3 class="section-title-sm">Exportar Dataset</h3>

							<div class="export-stats" id="export-stats">
								<div class="stat-item">
									<span class="stat-value" id="stat-images">0</span>
									<span class="stat-label">Imágenes</span>
								</div>
								<div class="stat-item">
									<span class="stat-value" id="stat-annotations">0</span>
									<span class="stat-label">Anotaciones</span>
								</div>
								<div class="stat-item">
									<span class="stat-value" id="stat-classes">0</span>
									<span class="stat-label">Clases</span>
								</div>
							</div>

							<button type="button" id="export-coco-btn" class="btn-action btn-primary-action">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
								Descargar COCO JSON
							</button>

							<div class="divider"></div>

							<h3 class="section-title-sm">Roboflow</h3>
							<div class="roboflow-status" id="roboflow-status">
								<span class="status-dot idle"></span>
								<span>Verificando conexión...</span>
							</div>

							<div class="roboflow-options-panel" style="margin-bottom: 0.75rem;">
								<div style="margin-bottom: 0.5rem;">
									<label for="roboflow-version-select" style="font-size: 0.75rem; font-weight: 500; color: var(--text-muted); display: block; margin-bottom: 0.2rem;">Versión del Dataset:</label>
									<select id="roboflow-version-select" class="select-input" style="width: 100%; font-size: 0.8rem; padding: 0.35rem 0.5rem; background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-main); border-radius: 6px;">
										<option value="new">⚡ UNIFICAR TODAS LAS IMÁGENES (Nueva Versión Unificada)</option>
									</select>
								</div>

								<div style="margin-bottom: 0.5rem;">
									<label for="roboflow-model-select" style="font-size: 0.75rem; font-weight: 500; color: var(--text-muted); display: block; margin-bottom: 0.2rem;">Formato Dataset (Local PC):</label>
									<select id="roboflow-model-select" class="select-input" style="width: 100%; font-size: 0.8rem; padding: 0.35rem 0.5rem; background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-main); border-radius: 6px;">
										<option value="yolov8-obb">YOLOv8-OBB (Oriented Bounding Boxes)</option>
										<option value="yolov8">YOLOv8 PyTorch / Ultralytics</option>
										<option value="yolov11">YOLOv11 PyTorch</option>
										<option value="yolov9">YOLOv9 PyTorch</option>
										<option value="yolov7">YOLOv7 PyTorch</option>
										<option value="yolov5">YOLOv5 PyTorch</option>
										<option value="coco">COCO JSON Format</option>
										<option value="coco-segmentation">COCO Instance Segmentation</option>
										<option value="pascal_voc">Pascal VOC XML</option>
										<option value="yolact">YOLACT Segmentation</option>
										<option value="tfrecord">TensorFlow TFRecord</option>
										<option value="coreml">Apple CoreML</option>
									</select>
								</div>
							</div>

							<button type="button" id="upload-roboflow-btn" class="btn-action btn-roboflow" disabled>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" /></svg>
								1. Subir Lote a Roboflow
							</button>

							<button type="button" id="unify-versions-btn" class="btn-action" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: #fff;" disabled>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
								⚡ Unificar Versiones
							</button>

							<button type="button" id="train-roboflow-btn" class="btn-action btn-train" disabled>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
								2. Exportar / Descargar Dataset
							</button>

							<div class="divider"></div>

							<button type="button" id="full-pipeline-btn" class="btn-action btn-primary-action" disabled>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
								🚀 Subir, Unificar y Exportar para PC
							</button>

							<div class="progress-area" id="progress-area" style="display:none;">
								<div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
								<span class="progress-text" id="progress-text">Subiendo...</span>
							</div>
						</div>
					</div>
				</aside>

				<!-- CENTER: Viewer -->
				<section class="viewer-panel panel-card">
					<div class="viewer-header">
						<h2 class="section-title">Visor de Anotaciones</h2>
						<div class="viewer-controls" id="viewer-controls" style="display: none;">
							<button type="button" id="toggle-click-mode" class="btn-small btn-primary-action" style="font-size: 0.75rem; padding: 0.25rem 0.6rem;">
								👆 Modo Click (SAM 3)
							</button>
							<button type="button" id="toggle-draw-mode" class="btn-small btn-outline" style="font-size: 0.75rem; padding: 0.25rem 0.6rem;">
								✏️ Dibujar Polígono
							</button>
							<button type="button" id="finish-polygon-btn" class="btn-small btn-green" style="font-size: 0.75rem; padding: 0.25rem 0.6rem; display: none;">
								✓ Finalizar Polígono
							</button>
							<span class="separator">|</span>
							<label class="toggle-container">
								<input type="checkbox" id="toggle-polygons" checked />
								<span class="toggle-label">Polígonos</span>
							</label>
							<label class="toggle-container">
								<input type="checkbox" id="toggle-boxes" />
								<span class="toggle-label">Boxes</span>
							</label>
							<span class="separator">|</span>
							<span id="detections-counter" class="counter-badge">0 detecciones</span>
						</div>
					</div>

					<!-- Selection toolbar -->
					<div class="selection-toolbar" id="selection-toolbar" style="display: none;">
						<span id="selection-count">0 seleccionadas</span>
						<select id="reassign-select" class="form-input-sm">
							<option value="">Mover a clase...</option>
						</select>
						<button type="button" id="delete-selected-btn" class="btn-small btn-danger">🗑️ Eliminar</button>
						<button type="button" id="deselect-btn" class="btn-small btn-outline">✕ Deseleccionar</button>
					</div>

					<div class="viewer-content">
						<div class="empty-viewer" id="empty-viewer">
							<svg xmlns="http://www.w3.org/2000/svg" class="empty-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
							</svg>
							<p>Sube imágenes y la segmentación comenzará automáticamente.</p>
							<p class="upload-hint">Luego podrás editar clases, eliminar detecciones erróneas, y exportar a Roboflow.</p>
						</div>

						<div class="image-viewport" id="image-viewport" style="display: none;">
							<div class="viewer-container" id="viewer-container">
								<img id="display-image" src="" alt="Histología" />
								<svg id="overlay-svg" class="overlay-svg" xmlns="http://www.w3.org/2000/svg"></svg>
							</div>
						</div>
					</div>
				</section>
			</main>
		</div>

		<!-- Tooltip -->
		<div id="box-tooltip" class="box-tooltip" style="display: none;">
			<div class="tooltip-category" id="tooltip-category">-</div>
			<div class="tooltip-score">Confianza: <span id="tooltip-score-val">0.00</span></div>
			<div class="tooltip-coords">Box: <span id="tooltip-coords-val">0, 0</span></div>
			<div class="tooltip-hint">Click = seleccionar · Shift+Click = multi-select</div>
		</div>

		<!-- Context menu -->
		<div id="context-menu" class="context-menu" style="display: none;">
			<div class="ctx-header" id="ctx-header">Detección</div>
			<div class="ctx-item" id="ctx-delete">🗑️ Eliminar</div>
			<div class="ctx-separator"></div>
			<div class="ctx-sub-header">Mover a clase:</div>
			<div id="ctx-class-list" class="ctx-class-list"></div>
		</div>

		<!-- Roboflow Code Snippet Modal -->
		<div id="roboflow-snippet-modal" class="modal-backdrop" style="display: none;">
			<div class="modal-card">
				<div class="modal-header">
					<h3>📦 Código Python Roboflow (Versión Unificada v<span id="modal-version-num">1</span>)</h3>
					<button type="button" id="close-modal-btn" class="btn-small btn-outline" style="padding: 0.2rem 0.5rem;">✕</button>
				</div>
				<div class="modal-body">
					<p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem;">
						Copia este código Python para descargar la versión unificada del dataset directamente en Google Colab, Jupyter Notebook o en tu PC:
					</p>

					<div class="code-box-container" style="position: relative;">
						<button type="button" id="copy-snippet-btn" class="btn-small btn-primary-action" style="position: absolute; top: 8px; right: 8px; font-size: 0.75rem; padding: 0.25rem 0.6rem; z-index: 10;">
							📋 Copiar Código
						</button>
						<pre id="snippet-code-block" style="background: #0d1117; border: 1px solid var(--border-color); color: #e6edf3; padding: 1rem; border-radius: 8px; font-family: monospace; font-size: 0.82rem; overflow-x: auto; white-space: pre-wrap; margin: 0;"></pre>
					</div>

					<div style="margin-top: 1rem; padding: 0.75rem; background: rgba(56, 189, 248, 0.1); border-left: 3px solid #38bdf8; border-radius: 6px;">
						<div style="font-size: 0.78rem; font-weight: 600; color: #38bdf8; margin-bottom: 0.25rem;">Ubicación descargada en tu PC local:</div>
						<code id="modal-export-path" style="font-size: 0.75rem; color: var(--text-main); word-break: break-all;"></code>
					</div>
				</div>
			</div>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--bg-dark: #070913;
		--bg-panel: rgba(15, 23, 42, 0.45);
		--bg-sidebar: rgba(15, 23, 42, 0.65);
		--border-color: rgba(255, 255, 255, 0.08);
		--border-active: rgba(139, 92, 246, 0.5);
		--text-main: #f8fafc;
		--text-muted: #94a3b8;
		--primary: #8b5cf6;
		--primary-hover: #a78bfa;
		--primary-glow: rgba(139, 92, 246, 0.4);
		--accent-cyan: #06b6d4;
		--accent-green: #10b981;
		--accent-red: #f43f5e;
		--font-family: 'Inter', sans-serif;
		--font-title: 'Outfit', sans-serif;
	}

	* { box-sizing: border-box; margin: 0; padding: 0; }

	body {
		background-color: var(--bg-dark);
		color: var(--text-main);
		font-family: var(--font-family);
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background-image: 
			radial-gradient(circle at 10% 20%, rgba(139, 92, 246, 0.08) 0%, transparent 40%),
			radial-gradient(circle at 90% 80%, rgba(6, 182, 212, 0.08) 0%, transparent 40%);
		background-attachment: fixed;
		overflow-x: hidden;
	}

	.app-container { width: 100%; max-width: 1600px; margin: 0 auto; padding: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; flex-grow: 1; }
	.app-header { text-align: left; position: relative; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color); }
	.logo-area { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.4rem; }
	.glowing-orb { width: 12px; height: 12px; border-radius: 50%; background-color: var(--accent-cyan); box-shadow: 0 0 12px var(--accent-cyan), 0 0 24px var(--accent-cyan); }
	.app-header h1 { font-family: var(--font-title); font-weight: 800; font-size: 2rem; letter-spacing: -0.03em; }
	.gradient-text { background: linear-gradient(135deg, var(--primary) 0%, var(--accent-cyan) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
	.badge { font-size: 0.7rem; font-weight: 600; padding: 0.2rem 0.55rem; border-radius: 9999px; background: rgba(6, 182, 212, 0.15); border: 1px solid rgba(6, 182, 212, 0.3); color: var(--accent-cyan); letter-spacing: 0.05em; }
	.subtitle { color: var(--text-muted); font-size: 0.95rem; font-weight: 400; max-width: 900px; }

	/* ===== LAYOUT ===== */
	.app-main { display: grid; grid-template-columns: 380px 1fr; gap: 1.5rem; align-items: start; }
	@media (max-width: 1024px) { .app-main { grid-template-columns: 1fr; } }

	/* ===== SIDEBAR ===== */
	.sidebar-panel { background: var(--bg-sidebar); backdrop-filter: blur(16px); border: 1px solid var(--border-color); border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.3); }

	/* Tabs */
	.tab-bar { display: flex; border-bottom: 1px solid var(--border-color); }
	.tab-btn { flex: 1; padding: 0.75rem 0.5rem; background: none; border: none; color: var(--text-muted); font-size: 0.8rem; font-weight: 600; cursor: pointer; border-bottom: 2px solid transparent; transition: all 0.15s; font-family: var(--font-family); }
	.tab-btn:hover { color: var(--text-main); background: rgba(255,255,255,0.03); }
	.tab-btn.active { color: var(--accent-cyan); border-bottom-color: var(--accent-cyan); background: rgba(6, 182, 212, 0.05); }
	.tab-content { display: none; padding: 1.25rem; max-height: calc(100vh - 220px); overflow-y: auto; }
	.tab-content.active { display: block; }

	/* Upload Zone */
	.upload-zone { border: 2px dashed rgba(255, 255, 255, 0.15); border-radius: 12px; padding: 1.5rem 1rem; text-align: center; cursor: pointer; position: relative; transition: all 0.2s; background: rgba(255, 255, 255, 0.01); min-height: 120px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
	.upload-zone:hover { border-color: var(--primary); background: rgba(139, 92, 246, 0.03); }
	.upload-zone.dragover { border-color: var(--accent-cyan); background: rgba(6, 182, 212, 0.05); }
	.file-hidden { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
	.upload-icon { width: 32px; height: 32px; color: var(--text-muted); margin-bottom: 0.5rem; }
	.upload-text { font-size: 0.85rem; color: var(--text-main); margin-bottom: 0.3rem; font-weight: 500; }
	.text-link { color: var(--primary-hover); text-decoration: underline; }
	.upload-hint { font-size: 0.72rem; color: var(--text-muted); }

	/* Image Gallery */
	.image-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin-top: 1rem; }
	.gallery-thumb { position: relative; aspect-ratio: 1; border-radius: 8px; overflow: hidden; cursor: pointer; border: 2px solid transparent; transition: all 0.15s; }
	.gallery-thumb img { width: 100%; height: 100%; object-fit: cover; }
	.gallery-thumb.active { border-color: var(--accent-cyan); box-shadow: 0 0 12px rgba(6, 182, 212, 0.3); }
	.gallery-thumb .thumb-badge { position: absolute; top: 4px; right: 4px; width: 8px; height: 8px; border-radius: 50%; }
	.gallery-thumb .thumb-badge.pending { background: var(--accent-red); }
	.gallery-thumb .thumb-badge.annotated { background: var(--accent-green); }
