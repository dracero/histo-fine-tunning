	async function runSam3Segmentation(targetKey = null) {
		const keysToProcess = (typeof targetKey === "string" && targetKey)
			? [targetKey]
			: Array.from(imageStore.keys());

		if (keysToProcess.length === 0) {
			alert("No hay imágenes cargadas para segmentar.");
			return;
		}

		statusIdle.style.display = "none";
		statusRunning.style.display = "flex";
		const engineName = currentEngine === "cellpose" ? `Cellpose (${currentCellposeModel})` : "SAM 3.1";
		let totalProcessed = 0;
		let totalDetectionsAll = 0;

		for (let i = 0; i < keysToProcess.length; i++) {
			const key = keysToProcess[i];
			const data = imageStore.get(key);
			if (!data) continue;

			statusText.textContent = `[${i + 1}/${keysToProcess.length}] Segmentando ${data.filename} con ${engineName}...`;

			const elementsText = customPromptInput.value.trim() || (currentEngine === "cellpose" ? "cell" : "cell nucleus");
			const formData = new FormData();
			formData.append("image", data.file);
			formData.append("elements", elementsText);
			formData.append("prompt", elementsText);
			formData.append("umbral", thresholdSlider.value);
			formData.append("model_engine", currentEngine);
			formData.append("cellpose_model", currentCellposeModel);

			const diamVal = cellposeDiameterInput ? parseFloat(cellposeDiameterInput.value) : null;
			if (diamVal && diamVal > 0) {
				formData.append("cell_diameter", diamVal.toString());
			}
			if (window._activeOntologyName) {
				formData.append("ontology_name", window._activeOntologyName);
			}

			try {
				const response = await fetch(`${API_URL}/segment`, {
					method: "POST",
					body: formData
				});

				if (!response.ok) {
					const err = await response.json();
					console.warn(`Error en segmentación de ${data.filename}:`, err);
					continue;
				}

				const result = await response.json();
				data.groups = result.groups || [];
				data.width = result.width || data.width;
				data.height = result.height || data.height;
				data.annotated = true;

				for (const group of data.groups) {
					if (!classRegistry.find(c => c.key === group.key)) {
						classRegistry.push({
							id: classIdCounter++,
							name: group.label,
							color: group.color,
							key: group.key,
						});
					}
				}

				const detCount = result.total_detections || (result.detections ? result.detections.length : 0);
				totalDetectionsAll += detCount;
				totalProcessed++;

				renderGallery();
				updateExportStats();

				if (key === activeImageKey) {
					viewerControls.style.display = "flex";
					selectedDetections.clear();
					updateSelectionToolbar();
					renderOverlay();
					updateClassesList();
				}
			} catch (error) {
				console.error(`Error en ${data.filename}:`, error);
			}
		}

		if (activeImageKey) {
			viewerControls.style.display = "flex";
			renderOverlay();
			updateClassesList();
		}
		renderGallery();
		updateExportStats();

		statusText.textContent = `✓ [${engineName}] Lote: ${totalProcessed} imágenes procesadas (${totalDetectionsAll} instancias).`;
		setTimeout(() => {
			statusRunning.style.display = "none";
			statusIdle.style.display = "flex";
		}, 3500);
	}

