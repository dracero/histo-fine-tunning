	// ======================= RENDER OVERLAY =======================
	function renderOverlay() {
		overlaySvg.innerHTML = "";
		if (!activeImageKey) return;

		const data = imageStore.get(activeImageKey);
		if (!data || !data.groups.length) return;

		const w = data.width || displayImage.naturalWidth || 1;
		const h = data.height || displayImage.naturalHeight || 1;

		overlaySvg.setAttribute("viewBox", `0 0 ${w} ${h}`);
		overlaySvg.setAttribute("preserveAspectRatio", "xMidYMid meet");

		const threshold = parseFloat(thresholdSlider.value);
		const showPolygons = togglePolygons.checked;
		const showBoxes = toggleBoxes.checked;
		const showLabels = toggleLabels ? toggleLabels.checked : true;
		let totalCount = 0;

		const rawItems = [];
		data.groups.forEach(group => {
			if (hiddenCategories.has(group.key)) return;

			const color = getClassColor(group.key);
			const label = getClassName(group.key);
			const isGroupMacro = Boolean(group.is_macro || group.scale === "macro" || group.role === "compartment" || group.role === "boundary_outer" || group.role === "cavity" || group.role === "stroma");

			group.detections.forEach((det, detIdx) => {
				if (det.score < threshold) return;
				if (det._deleted) return;
				const isDetMacro = Boolean(isGroupMacro || det.is_macro || det.scale === "macro");
				rawItems.push({
					group,
					det,
					detIdx,
					color,
					label,
					isMacro: isDetMacro,
					detId: `${group.key}:${detIdx}`,
				});
			});
		});

		// Filter by active scale filter ("all" | "macro" | "micro")
		const filteredItems = rawItems.filter(item => {
			if (currentViewerScaleFilter === "macro") return item.isMacro;
			if (currentViewerScaleFilter === "micro") return !item.isMacro;
			return true;
		});

		// Sort: Macro structures drawn FIRST (background), micro cells on TOP (foreground)
		filteredItems.sort((a, b) => {
			if (a.isMacro && !b.isMacro) return -1;
			if (!a.isMacro && b.isMacro) return 1;
			return 0;
		});

		const placedLabelCoords = [];

		filteredItems.forEach(item => {
			const { group, det, detIdx, color, label, isMacro, detId } = item;
			totalCount++;
			const isSelected = selectedDetections.has(detId);
			const detClasses = isSelected ? "selected" : "";

			// Draw polygon
			if (showPolygons && det.segmentation && det.segmentation.length > 0) {
				det.segmentation.forEach(poly => {
					const points = [];
					for (let i = 0; i < poly.length; i += 2) {
						points.push(`${poly[i]},${poly[i+1]}`);
					}
					const polygon = document.createElementNS("http://www.w3.org/2000/svg", "polygon");
					polygon.setAttribute("points", points.join(" "));
					polygon.setAttribute("class", `det-polygon ${detClasses} ${isMacro ? 'det-macro' : 'det-micro'}`.trim());
					polygon.style.fill = hexToRgba(color, isSelected ? 0.35 : (isMacro ? 0.12 : 0.22));
					polygon.style.stroke = isSelected ? "#38bdf8" : color;
					polygon.style.strokeWidth = isSelected ? "3.5" : (isMacro ? "2.2" : "1.5");
					if (isMacro) {
						polygon.style.strokeDasharray = "6 3";
					}
					polygon.dataset.detId = detId;
					polygon.dataset.scale = isMacro ? "macro" : "micro";
					addDetectionListeners(polygon, group, det, detIdx, color, label);
					overlaySvg.appendChild(polygon);
				});
			}

			// Draw bounding box
			if (showBoxes && det.box) {
				const [x1, y1, x2, y2] = det.box;
				const rect = document.createElementNS("http://www.w3.org/2000/svg", "rect");
				rect.setAttribute("x", x1);
				rect.setAttribute("y", y1);
				rect.setAttribute("width", x2 - x1);
				rect.setAttribute("height", y2 - y1);
				rect.setAttribute("class", `det-box ${detClasses} ${isMacro ? 'det-macro-box' : 'det-micro-box'}`.trim());
				rect.style.stroke = isSelected ? "#38bdf8" : color;
				rect.style.strokeWidth = isSelected ? "3.5" : (isMacro ? "2" : "1.2");
				if (isMacro) {
					rect.style.strokeDasharray = "5 3";
				}
				rect.dataset.detId = detId;
				rect.dataset.scale = isMacro ? "macro" : "micro";
				addDetectionListeners(rect, group, det, detIdx, color, label);
				overlaySvg.appendChild(rect);
			}

			// If neither mode shows anything, still draw boxes
			if (!showPolygons && !showBoxes && det.box) {
				const [x1, y1, x2, y2] = det.box;
				const rect = document.createElementNS("http://www.w3.org/2000/svg", "rect");
				rect.setAttribute("x", x1);
				rect.setAttribute("y", y1);
				rect.setAttribute("width", x2 - x1);
				rect.setAttribute("height", y2 - y1);
				rect.setAttribute("class", `det-box ${detClasses}`.trim());
				rect.style.stroke = isSelected ? "#38bdf8" : color;
				rect.style.strokeWidth = isSelected ? "3" : "1.2";
				rect.style.fill = hexToRgba(color, isMacro ? 0.06 : 0.08);
				rect.dataset.detId = detId;
				rect.dataset.scale = isMacro ? "macro" : "micro";
				addDetectionListeners(rect, group, det, detIdx, color, label);
				overlaySvg.appendChild(rect);
			}

			// Draw text label directly over structure if labels toggle is active
			let lx, ly;
			if (det.box) {
				lx = (det.box[0] + det.box[2]) / 2;
				ly = Math.max(14, det.box[1] - 4);
			} else if (det.bbox) {
				lx = det.bbox[0] + det.bbox[2] / 2;
				ly = Math.max(14, det.bbox[1] - 4);
			}

			if (showLabels && lx !== undefined && ly !== undefined) {
				// Anti-collision: shift label down if overlapping with another label
				let shiftCount = 0;
				for (const placed of placedLabelCoords) {
					if (Math.abs(placed.x - lx) < 45 && Math.abs(placed.y - ly) < 14) {
						shiftCount++;
					}
				}
				if (shiftCount > 0) {
					ly += (shiftCount * 14);
				}
				placedLabelCoords.push({ x: lx, y: ly });

				const txt = document.createElementNS("http://www.w3.org/2000/svg", "text");
				txt.setAttribute("x", lx);
				txt.setAttribute("y", ly);
				txt.setAttribute("text-anchor", "middle");
				txt.style.fill = color;
				txt.style.fontSize = isMacro ? "11px" : "10px";
				txt.style.fontWeight = isMacro ? "800" : "700";
				txt.style.paintOrder = "stroke";
				txt.style.stroke = "#000000";
				txt.style.strokeWidth = isMacro ? "3px" : "2.5px";
				txt.style.strokeLinejoin = "round";
				txt.style.pointerEvents = "none";
				txt.textContent = (isMacro ? "🏛️ " : "") + label;
				overlaySvg.appendChild(txt);
			}

			// Render Gemini Validation / Teacher Correction Badge directly on the structure
			if (det.gemini_validated) {
				let bx, by;
				if (det.box) {
					bx = (det.box[0] + det.box[2]) / 2;
					by = det.box[3] + 16;
				} else if (det.bbox) {
					bx = det.bbox[0] + det.bbox[2] / 2;
					by = det.bbox[1] + det.bbox[3] + 16;
				} else {
					bx = lx || 50;
					by = (ly || 50) + 20;
				}

				const isCorrect = det.gemini_status === "correct" || det.gemini_status === "correcta";
				const isPartial = det.gemini_status === "partially_correct" || det.gemini_status === "parcialmente_correcta";
				const badgeBg = isCorrect ? "rgba(6, 78, 59, 0.94)" : (isPartial ? "rgba(120, 53, 15, 0.94)" : "rgba(127, 29, 29, 0.94)");
				const badgeBorder = isCorrect ? "#10b981" : (isPartial ? "#f59e0b" : "#ef4444");
				const badgeTextColor = isCorrect ? "#a7f3d0" : (isPartial ? "#fde68a" : "#fca5a5");
				const badgeIcon = isCorrect ? "🎯" : (isPartial ? "⚠️" : "❌");
				const structureName = det.gemini_structure || det.label;
				const probVal = det.gemini_eval_probability !== undefined ? Math.round(det.gemini_eval_probability * 100) : (det.gemini_score !== undefined ? det.gemini_score : 100);
				const badgeText = `${badgeIcon} Gemini: ${structureName} (${probVal}%)`;

				const gGroup = document.createElementNS("http://www.w3.org/2000/svg", "g");
				gGroup.setAttribute("class", "gemini-correction-badge");
				gGroup.style.cursor = "pointer";

				const approxWidth = Math.max(130, badgeText.length * 6.8);
				const rect = document.createElementNS("http://www.w3.org/2000/svg", "rect");
				rect.setAttribute("x", bx - approxWidth / 2);
				rect.setAttribute("y", by - 12);
				rect.setAttribute("width", approxWidth);
				rect.setAttribute("height", 18);
				rect.setAttribute("rx", "5");
				rect.setAttribute("ry", "5");
				rect.style.fill = badgeBg;
				rect.style.stroke = badgeBorder;
				rect.style.strokeWidth = "1.5";
				rect.style.filter = "drop-shadow(0 2px 5px rgba(0,0,0,0.65))";

				const badgeTxt = document.createElementNS("http://www.w3.org/2000/svg", "text");
				badgeTxt.setAttribute("x", bx);
				badgeTxt.setAttribute("y", by + 1);
				badgeTxt.setAttribute("text-anchor", "middle");
				badgeTxt.style.fill = badgeTextColor;
				badgeTxt.style.fontSize = "9.5px";
				badgeTxt.style.fontWeight = "800";
				badgeTxt.style.fontFamily = "system-ui, -apple-system, sans-serif";
				badgeTxt.textContent = badgeText;

				gGroup.appendChild(rect);
				gGroup.appendChild(badgeTxt);

				gGroup.addEventListener("click", (e) => {
					e.stopPropagation();
					selectedDetections.clear();
					selectedDetections.add(detId);
					updateSelectionToolbar();
					renderOverlay();
					switchTab("student-quiz-tab");
					if (typeof onDetectionSelectedForStudent === "function") {
						onDetectionSelectedForStudent(detId);
					}
				});

				overlaySvg.appendChild(gGroup);
			}
		});

		detectionsCounter.textContent = `${totalCount} detecciones`;

		// Render live drawing polygon points if in drawing mode
		if (activeInteractiveTool === 'polygon' && currentPolygonPoints.length > 0) {
			const ptsString = currentPolygonPoints.map(p => `${p[0]},${p[1]}`).join(" ");

			// Draw temporary polygon outline
			const tempPoly = document.createElementNS("http://www.w3.org/2000/svg", "polygon");
			tempPoly.setAttribute("points", ptsString);
			tempPoly.style.fill = "rgba(245, 158, 11, 0.25)";
			tempPoly.style.stroke = "#f59e0b";
			tempPoly.style.strokeWidth = "2";
			tempPoly.style.strokeDasharray = "4";
			overlaySvg.appendChild(tempPoly);

			// Draw vertex handles
			currentPolygonPoints.forEach((p, idx) => {
				const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
				circle.setAttribute("cx", p[0]);
				circle.setAttribute("cy", p[1]);
				circle.setAttribute("r", "5");
				circle.style.fill = idx === 0 ? "#ef4444" : "#f59e0b";
				circle.style.stroke = "#ffffff";
				circle.style.strokeWidth = "1.5";
				overlaySvg.appendChild(circle);
			});
		}
	}

	function addDetectionListeners(el, group, det, detIdx, color, label) {
		const detId = `${group.key}:${detIdx}`;

		// Tooltip
		el.addEventListener("mouseenter", () => {
			tooltipCategory.textContent = label;
			tooltipCategory.style.color = color;
			let scoreText = `${(det.score * 100).toFixed(0)}%`;
			if (det.conch_confidence) {
				scoreText += ` · 🔬 CONCH: ${(det.conch_confidence * 100).toFixed(0)}%`;
			}
			if (det.virchow_similarity || det.morphological_ensemble_similarity) {
				const vScore = det.virchow_similarity || det.morphological_ensemble_similarity;
				scoreText += ` · 🧬 Virchow2: ${(vScore * 100).toFixed(0)}%`;
			}
			if (det.model_contributions && det.model_contributions.lunit_dino) {
				scoreText += ` · 🦠 DINO: ${(det.model_contributions.lunit_dino * 100).toFixed(0)}%`;
			}
			if (det.similarity_score !== undefined) {

			}
			if (det.is_prototype) {
				scoreText += ` · 🌟 Prototipo`;
			}
			tooltipScore.textContent = scoreText;
			if (det.box) {
				const [x1, y1, x2, y2] = det.box;
				tooltipCoords.textContent = `${Math.round(x1)},${Math.round(y1)} → ${Math.round(x2)},${Math.round(y2)}`;
			}
			if (tooltipReason) {
				const comp = det.spatial_compartment || det.containing_layer || det.compartment;
				const compBadge = comp ? `[${comp.toUpperCase()}] ` : "";
				const reasoningText = det.cytological_reasoning || det.gemini_reasoning || det.agent_reasoning || "";
				const corrBadge = det.spatial_corrected ? ` · ⚡ Corregida de '${det.original_class_key || "prev"}'` : "";

				if (reasoningText || compBadge) {
					tooltipReason.textContent = `💡 ${compBadge}${reasoningText}${corrBadge}`;
					tooltipReason.style.display = "block";
				} else {
					tooltipReason.style.display = "none";
				}
			}
			tooltip.style.display = "block";
		});
		el.addEventListener("mousemove", (e) => {
			tooltip.style.left = `${e.clientX}px`;
			tooltip.style.top = `${e.clientY}px`;
		});
		el.addEventListener("mouseleave", () => { tooltip.style.display = "none"; });

		// Click to select, validate, or erase
		el.addEventListener("click", (e) => {
			if (activeInteractiveTool === 'polygon') {
				return; // Allow event to bubble to viewer-container for Polygon drawing
			}
			e.stopPropagation();

			if (activeInteractiveTool === 'eraser') {
				det._deleted = true;
				if (typeof selectedDetections !== "undefined") {
					selectedDetections.delete(detId);
				}
				tooltip.style.display = "none";
				updateSelectionToolbar();
				renderOverlay();
				updateClassesList();
				updateExportStats();
				return;
			}

			// If Clic SAM was active, user clicked an existing cell: deactivate tool to prevent duplicate SAM overlays!
			if (activeInteractiveTool === 'click') {
				if (typeof setActiveInteractiveTool === "function") {
					setActiveInteractiveTool(null);
				}
			}

			if (e.shiftKey) {
				// Multi-select
				if (selectedDetections.has(detId)) selectedDetections.delete(detId);
				else selectedDetections.add(detId);
			} else {
				// Single select: always select this detection (do not toggle off on rapid click)
				selectedDetections.clear();
				selectedDetections.add(detId);
			}
			updateSelectionToolbar();
			renderOverlay();

			if (selectedDetections.size === 1) {
				const [firstId] = selectedDetections;
				if (typeof onDetectionSelectedForStudent === "function") {
					onDetectionSelectedForStudent(firstId);
				}
			} else if (selectedDetections.size === 0) {
				if (typeof onDetectionSelectedForStudent === "function") {
					onDetectionSelectedForStudent(null);
				}
			}
		});

		// Right-click context menu
		el.addEventListener("contextmenu", (e) => {
			e.preventDefault();
			e.stopPropagation();
			if (!selectedDetections.has(detId)) {
				selectedDetections.clear();
				selectedDetections.add(detId);
				updateSelectionToolbar();
				renderOverlay();
			}
			showContextMenu(e.clientX, e.clientY, detId);
		});
	}

	// Click on viewer background = deselect all (or forward to interactive tool if not handled by displayImage)
	document.getElementById("viewer-container").addEventListener("click", (e) => {
		if (activeInteractiveTool === 'click' || activeInteractiveTool === 'polygon') {
			// If target was already displayImage, it is handled directly by displayImage listener
			if (e.target !== displayImage && typeof handleCanvasPointClick === "function") {
				handleCanvasPointClick(e);
			}
			return;
		}
		if (e.target === displayImage || e.target === overlaySvg) {
			selectedDetections.clear();
			updateSelectionToolbar();
			renderOverlay();
		}
	});

	// ======================= SELECTION TOOLBAR =======================
	function updateSelectionToolbar() {
		if (selectedDetections.size > 0) {
			selectionToolbar.style.display = "flex";
			selectionCount.textContent = `${selectedDetections.size} seleccionada${selectedDetections.size > 1 ? "s" : ""}`;
			updateReassignDropdown();
		} else {
			selectionToolbar.style.display = "none";
		}
	}

	function updateReassignDropdown() {
		reassignSelect.innerHTML = '<option value="">Mover a clase...</option>';
		classRegistry.forEach(cls => {
			const opt = document.createElement("option");
			opt.value = cls.key;
			opt.textContent = cls.name;
			reassignSelect.appendChild(opt);
		});
		if (typeof updateCorrectionClassDropdown === "function") {
			updateCorrectionClassDropdown();
		}
	}

	deleteSelectedBtn.addEventListener("click", () => { deleteSelectedDetections(); });
	deselectBtn.addEventListener("click", () => {
		selectedDetections.clear();
		updateSelectionToolbar();
		renderOverlay();
	});

	reassignSelect.addEventListener("change", () => {
		const targetKey = reassignSelect.value;
		if (!targetKey || !activeImageKey) return;
		reassignDetections(targetKey);
		reassignSelect.value = "";
	});

	// Keyboard shortcuts
	document.addEventListener("keydown", (e) => {
		if (e.key === "Delete" || e.key === "Backspace") {
			if (selectedDetections.size > 0 && document.activeElement.tagName !== "INPUT") {
				e.preventDefault();
				deleteSelectedDetections();
			}
		}
		if (e.key === "Escape") {
			selectedDetections.clear();
			updateSelectionToolbar();
			if (typeof setActiveInteractiveTool === "function" && activeInteractiveTool) {
				setActiveInteractiveTool(null);
			}
			renderOverlay();
			contextMenu.style.display = "none";
		}
		// Quick correction tool hotkeys (when not editing text inputs)
		if (document.activeElement.tagName !== "INPUT" && !e.ctrlKey && !e.metaKey && !e.altKey) {
			if (typeof setActiveInteractiveTool === "function") {
				if (e.key === "b" || e.key === "B") {
					setActiveInteractiveTool("box");
				} else if (e.key === "c" || e.key === "C") {
					setActiveInteractiveTool("click");
				} else if (e.key === "p" || e.key === "P") {
					setActiveInteractiveTool("polygon");
				} else if (e.key === "x" || e.key === "X") {
					setActiveInteractiveTool("eraser");
				}
			}
		}
		// Ctrl+A = select all visible
		if (e.key === "a" && (e.ctrlKey || e.metaKey) && document.activeElement.tagName !== "INPUT") {
			e.preventDefault();
			selectAllVisible();
		}
	});

	function selectAllVisible() {
		if (!activeImageKey) return;
		const data = imageStore.get(activeImageKey);
		if (!data) return;
		const threshold = parseFloat(thresholdSlider.value);
		selectedDetections.clear();
		data.groups.forEach(group => {
			if (hiddenCategories.has(group.key)) return;
			group.detections.forEach((det, idx) => {
				if (det.score >= threshold && !det._deleted) {
					selectedDetections.add(`${group.key}:${idx}`);
				}
			});
		});
		updateSelectionToolbar();
		renderOverlay();
	}

	// ======================= DETECTION OPERATIONS =======================
	function deleteSelectedDetections() {
		if (!activeImageKey || selectedDetections.size === 0) return;
		const data = imageStore.get(activeImageKey);
		if (!data) return;

		selectedDetections.forEach(detId => {
			const [groupKey, detIdx] = parseDetId(detId);
			const group = data.groups.find(g => g.key === groupKey);
			if (group && group.detections[detIdx]) {
				group.detections[detIdx]._deleted = true;
			}
		});

		selectedDetections.clear();
		updateSelectionToolbar();
		renderOverlay();
		renderGallery();
		updateClassesList();
		updateExportStats();
	}

	function reassignDetections(targetKey) {
		if (!activeImageKey || selectedDetections.size === 0) return;
		const data = imageStore.get(activeImageKey);
		if (!data) return;

		const targetGroup = data.groups.find(g => g.key === targetKey);
		if (!targetGroup) {
			// Create new group if doesn't exist for this image
			const cls = classRegistry.find(c => c.key === targetKey);
			if (!cls) return;
			const newGroup = { key: targetKey, prompt: "", label: cls.name, color: cls.color, detections: [], count: 0 };
			data.groups.push(newGroup);
			reassignDetections(targetKey); // Retry
			return;
		}

		const detsToMove = [];
		selectedDetections.forEach(detId => {
			const [groupKey, detIdx] = parseDetId(detId);
			if (groupKey === targetKey) return; // Already in target
			const group = data.groups.find(g => g.key === groupKey);
			if (group && group.detections[detIdx] && !group.detections[detIdx]._deleted) {
				detsToMove.push({ fromGroup: group, det: { ...group.detections[detIdx] }, detIdx });
			}
		});

		// Move detections
		detsToMove.forEach(({ fromGroup, det, detIdx }) => {
			fromGroup.detections[detIdx]._deleted = true;
			delete det._deleted;
			targetGroup.detections.push(det);
		});

		selectedDetections.clear();
		updateSelectionToolbar();
		renderOverlay();
		updateClassesList();
		updateExportStats();
	}

	function parseDetId(detId) {
		const lastColon = detId.lastIndexOf(":");
		return [detId.substring(0, lastColon), parseInt(detId.substring(lastColon + 1))];
	}

	function findDetectionById(detId) {
		if (!detId || !activeImageKey) return null;
		const data = imageStore.get(activeImageKey);
		if (!data || !data.groups) return null;
		const [groupKey, detIdx] = parseDetId(detId);
		const group = data.groups.find(g => g.key === groupKey);
		if (!group || !group.detections || !group.detections[detIdx]) return null;
		return {
			group,
			groupKey,
			detIndex: detIdx,
			det: group.detections[detIdx]
		};
	}
	window.parseDetId = parseDetId;
	window.findDetectionById = findDetectionById;


	// ======================= CONTEXT MENU =======================
	let contextDetId = null;

	function showContextMenu(x, y, detId) {
		contextDetId = detId;
		const [groupKey] = parseDetId(detId);
		const cls = classRegistry.find(c => c.key === groupKey);

		ctxHeader.textContent = cls ? cls.name : "Detección";
		ctxHeader.style.color = cls ? cls.color : "var(--accent-cyan)";

		// Build class list for reassignment
		ctxClassList.innerHTML = "";
		classRegistry.forEach(c => {
			if (c.key === groupKey) return; // Don't show current class
			const item = document.createElement("div");
			item.className = "ctx-class-item";
			item.innerHTML = `<span class="ctx-class-swatch" style="background:${c.color}"></span>${c.name}`;
			item.addEventListener("click", () => {
				// Move selected detections to this class
				if (!selectedDetections.has(detId)) {
					selectedDetections.clear();
					selectedDetections.add(detId);
				}
				reassignDetections(c.key);
				contextMenu.style.display = "none";
			});
			ctxClassList.appendChild(item);
		});

		contextMenu.style.left = `${x}px`;
		contextMenu.style.top = `${y}px`;
		contextMenu.style.display = "block";
	}

	ctxDelete.addEventListener("click", () => {
		if (contextDetId && !selectedDetections.has(contextDetId)) {
			selectedDetections.add(contextDetId);
		}
		deleteSelectedDetections();
		contextMenu.style.display = "none";
	});



	document.addEventListener("click", () => { contextMenu.style.display = "none"; });

	// ======================= CLASSES TAB =======================
	function updateClassesList() {
		classesList.innerHTML = "";
		if (classRegistry.length === 0) {
			classesList.innerHTML = '<p class="empty-hint">Segmenta una imagen para ver las clases.</p>';
			return;
		}

		const threshold = parseFloat(thresholdSlider.value);

		classRegistry.forEach(cls => {
			// Count total annotations across all images
			let totalCount = 0;
			imageStore.forEach(data => {
				const group = data.groups.find(g => g.key === cls.key);
				if (group) {
					totalCount += group.detections.filter(d => d.score >= threshold && !d._deleted).length;
				}
			});

			const isHidden = hiddenCategories.has(cls.key);
			const macroBadge = cls.is_macro
				? `<span title="Macroestructura anatómica (SAM 3.1)" style="font-size:0.58rem; padding: 1px 4px; border-radius: 3px; background: rgba(59, 130, 246, 0.2); color: #93c5fd; white-space: nowrap;">🏛️ Macro</span>`
				: (cls.spatial_rules && Object.keys(cls.spatial_rules).length > 0
					? `<span title="Microestructura celular con ontología espacial (Cellpose)" style="font-size:0.58rem; padding: 1px 4px; border-radius: 3px; background: rgba(16, 185, 129, 0.2); color: #6ee7b7; white-space: nowrap;">🔬 Micro</span>`
					: '');
			const item = document.createElement("div");
			item.className = `class-item ${isHidden ? "hidden" : ""}`;
			item.innerHTML = `
				<span class="class-swatch" style="background:${cls.color}" title="Click para cambiar color"></span>
				<div style="flex: 1; display: flex; align-items: center; gap: 0.35rem; min-width: 0;">
					<input class="class-name" type="text" value="${cls.name}" data-key="${cls.key}" style="flex: 1; min-width: 60px;" />
					${macroBadge}
				</div>
				<span class="class-count">${totalCount}</span>
				<button class="class-toggle" title="${isHidden ? "Mostrar" : "Ocultar"}">${isHidden ? "👁️‍🗨️" : "👁️"}</button>
				<button class="class-delete" title="Eliminar clase">✕</button>
			`;

			// Rename class
			const nameInput = item.querySelector(".class-name");
			nameInput.addEventListener("change", (e) => {
				cls.name = e.target.value.trim() || cls.name;
				// Update group labels in all images
				imageStore.forEach(data => {
					const group = data.groups.find(g => g.key === cls.key);
					if (group) group.label = cls.name;
				});
				renderOverlay();
			});

			// Toggle visibility
			item.querySelector(".class-toggle").addEventListener("click", (e) => {
				e.stopPropagation();
				if (hiddenCategories.has(cls.key)) hiddenCategories.delete(cls.key);
				else hiddenCategories.add(cls.key);
				updateClassesList();
				renderOverlay();
			});

			// Delete class
			item.querySelector(".class-delete").addEventListener("click", (e) => {
				e.stopPropagation();
				if (!confirm(`¿Eliminar la clase "${cls.name}" y todas sus detecciones?`)) return;
				// Mark all detections as deleted
				imageStore.forEach(data => {
					const group = data.groups.find(g => g.key === cls.key);
					if (group) group.detections.forEach(d => d._deleted = true);
				});
				classRegistry = classRegistry.filter(c => c.key !== cls.key);
				hiddenCategories.delete(cls.key);
				updateClassesList();
				renderOverlay();
				renderGallery();
				updateExportStats();
			});

			// Color picker
			item.querySelector(".class-swatch").addEventListener("click", (e) => {
				e.stopPropagation();
				const colorInput = document.createElement("input");
				colorInput.type = "color";
				colorInput.value = cls.color;
				colorInput.style.position = "absolute";
				colorInput.style.opacity = "0";
				document.body.appendChild(colorInput);
				colorInput.addEventListener("input", (ev) => {
					cls.color = ev.target.value;
					imageStore.forEach(data => {
						const group = data.groups.find(g => g.key === cls.key);
						if (group) group.color = cls.color;
					});
					updateClassesList();
					renderOverlay();
				});
				colorInput.addEventListener("change", () => { document.body.removeChild(colorInput); });
				colorInput.click();
			});

			classesList.appendChild(item);
		});

		if (typeof updateStudentSuggestionChips === "function") {
			updateStudentSuggestionChips();
		}
		if (typeof updateCorrectionClassDropdown === "function") {
			updateCorrectionClassDropdown();
		}
	}

	function updateStudentSuggestionChips() {
		const container = document.getElementById("student-quick-chips");
		if (!container) return;
		const existing = new Set(Array.from(container.querySelectorAll(".student-chip-btn")).map(b => b.dataset.name.toLowerCase()));
		if (classRegistry && classRegistry.length > 0) {
			classRegistry.forEach(c => {
				if (!existing.has(c.name.toLowerCase())) {
					existing.add(c.name.toLowerCase());
					const btn = document.createElement("button");
					btn.type = "button";
					btn.className = "faiss-chip-btn student-chip-btn";
					btn.dataset.name = c.name;
					btn.textContent = c.name;
					btn.addEventListener("click", () => {
						const input = document.getElementById("student-choice-input");
						if (input) {
							input.value = c.name;
							input.focus();
						}
					});
					container.appendChild(btn);
				}
			});
		}
	}

	// Add new class
	if (addClassBtn) {
		addClassBtn.addEventListener("click", () => {
			const text = newClassInput ? newClassInput.value.trim() : "";
			const className = text ? text : `Clase ${classRegistry.length + 1}`;
			const newKey = `clase_custom_${classIdCounter}`;
			const colors = ["#f472b6", "#a78bfa", "#34d399", "#fbbf24", "#60a5fa", "#fb923c", "#c084fc", "#2dd4bf"];
			const color = colors[classRegistry.length % colors.length];

			classRegistry.push({
				id: classIdCounter++,
				name: className,
				color: color,
				key: newKey,
			});

			if (newClassInput) newClassInput.value = "";
			updateClassesList();
			updateReassignDropdown();
			updateExportStats();
		});
	}

	// ======================= INTERACTIVE CORRECTION TOOLS (HUMAN-IN-THE-LOOP) =======================

	function updateCorrectionClassDropdown() {
		if (!correctionClassSelect) return;
		const currentVal = correctionClassSelect.value;
		correctionClassSelect.innerHTML = "";
		if (classRegistry.length === 0) {
			const opt = document.createElement("option");
			opt.value = "Estructura";
			opt.textContent = "Estructura";
			correctionClassSelect.appendChild(opt);
			return;
		}

		const macroClasses = classRegistry.filter(c => c.is_macro);
		const microClasses = classRegistry.filter(c => !c.is_macro);

		if (macroClasses.length > 0) {
			const grpMacro = document.createElement("optgroup");
			grpMacro.label = "🏛️ Macroestructuras (SAM 3.1)";
			macroClasses.forEach(cls => {
				const opt = document.createElement("option");
				opt.value = cls.name;
				opt.dataset.key = cls.key;
				opt.dataset.scale = "macro";
				opt.textContent = cls.name;
				grpMacro.appendChild(opt);
			});
			correctionClassSelect.appendChild(grpMacro);
		}

		if (microClasses.length > 0) {
			const grpMicro = document.createElement("optgroup");
			grpMicro.label = "🔬 Células / Microestructuras";
			microClasses.forEach(cls => {
				const opt = document.createElement("option");
				opt.value = cls.name;
				opt.dataset.key = cls.key;
				opt.dataset.scale = "micro";
				opt.textContent = cls.name;
				grpMicro.appendChild(opt);
			});
			correctionClassSelect.appendChild(grpMicro);
		}

		if (macroClasses.length === 0 && microClasses.length === 0) {
			classRegistry.forEach(cls => {
				const opt = document.createElement("option");
				opt.value = cls.name;
				opt.dataset.key = cls.key;
				opt.textContent = cls.name;
				correctionClassSelect.appendChild(opt);
			});
		}

		if (currentVal && Array.from(correctionClassSelect.options).some(o => o.value === currentVal)) {
			correctionClassSelect.value = currentVal;
		}
	}

	correctionClassSelect?.addEventListener("change", () => {
		const selectedOpt = correctionClassSelect.selectedOptions[0];
		if (selectedOpt && selectedOpt.dataset.scale) {
			setStructureScale(selectedOpt.dataset.scale);
		}
	});

	function setActiveInteractiveTool(toolName) {
		if (activeInteractiveTool === toolName) {
			activeInteractiveTool = null; // Toggle off
		} else {
			activeInteractiveTool = toolName;
		}

		currentPolygonPoints = [];
		isDraggingBox = false;
		const tempBox = document.getElementById("temp-box-drag");
		if (tempBox) tempBox.remove();

		// Update button visual styles
		if (toolBoxMode) {
			const isActive = (activeInteractiveTool === 'box');
			toolBoxMode.style.background = isActive ? "#0284c7" : "rgba(56,189,248,0.15)";
			toolBoxMode.style.color = isActive ? "#ffffff" : "#38bdf8";
			toolBoxMode.style.borderColor = isActive ? "#38bdf8" : "rgba(56,189,248,0.4)";
			toolBoxMode.style.fontWeight = isActive ? "700" : "600";
		}
		if (toolClickMode) {
			const isActive = (activeInteractiveTool === 'click');
			toolClickMode.style.background = isActive ? "#16a34a" : "rgba(34,197,94,0.15)";
			toolClickMode.style.color = isActive ? "#ffffff" : "#22c55e";
			toolClickMode.style.borderColor = isActive ? "#22c55e" : "rgba(34,197,94,0.4)";
			toolClickMode.style.fontWeight = isActive ? "700" : "600";
		}
		if (toolDrawMode) {
			const isActive = (activeInteractiveTool === 'polygon');
			toolDrawMode.style.background = isActive ? "#d97706" : "rgba(245,158,11,0.15)";
			toolDrawMode.style.color = isActive ? "#ffffff" : "#fbbf24";
			toolDrawMode.style.borderColor = isActive ? "#fbbf24" : "rgba(245,158,11,0.4)";
			toolDrawMode.style.fontWeight = isActive ? "700" : "600";
		}
		if (finishPolygonBtn) {
			finishPolygonBtn.style.display = (activeInteractiveTool === 'polygon') ? "inline-block" : "none";
			finishPolygonBtn.textContent = "✓ Finalizar Polígono (0 pts)";
		}
		if (toolEraserMode) {
			const isActive = (activeInteractiveTool === 'eraser');
			toolEraserMode.style.background = isActive ? "#dc2626" : "rgba(239,68,68,0.15)";
			toolEraserMode.style.color = isActive ? "#ffffff" : "#f87171";
			toolEraserMode.style.borderColor = isActive ? "#f87171" : "rgba(239,68,68,0.4)";
			toolEraserMode.style.fontWeight = isActive ? "700" : "600";
		}

		// Cursor & Status bar
		if (activeToolStatus) {
			if (activeInteractiveTool === 'box') {
				activeToolStatus.textContent = "🟦 Arrastra un recuadro sobre la imagen";
				displayImage.style.cursor = "crosshair";
			} else if (activeInteractiveTool === 'click') {
				activeToolStatus.textContent = "👆 Haz clic sobre una célula u objeto";
				displayImage.style.cursor = "crosshair";
			} else if (activeInteractiveTool === 'polygon') {
				activeToolStatus.textContent = "✏️ Clic para vértices, doble clic para cerrar";
				displayImage.style.cursor = "crosshair";
			} else if (activeInteractiveTool === 'eraser') {
				activeToolStatus.textContent = "🧹 Haz clic en cualquier detección para borrarla";
				displayImage.style.cursor = "not-allowed";
			} else {
				activeToolStatus.textContent = "";
				displayImage.style.cursor = "default";
			}
		}

		renderOverlay();
	}

	if (toolBoxMode) toolBoxMode.addEventListener("click", () => setActiveInteractiveTool('box'));
	if (toolClickMode) toolClickMode.addEventListener("click", () => setActiveInteractiveTool('click'));
	if (toolDrawMode) toolDrawMode.addEventListener("click", () => setActiveInteractiveTool('polygon'));
	if (toolEraserMode) toolEraserMode.addEventListener("click", () => setActiveInteractiveTool('eraser'));
	if (finishPolygonBtn) finishPolygonBtn.addEventListener("click", () => finishPolygonDrawing());

	function addDetectionToActiveImage(targetClass, detData) {
		if (!activeImageKey) return;
		const activeData = imageStore.get(activeImageKey);
		if (!activeData) return;

		let matchedCls = classRegistry.find(c => c.name.toLowerCase() === targetClass.toLowerCase() || c.key === targetClass);
		if (!matchedCls) {
			const colors = ["#f472b6", "#a78bfa", "#34d399", "#fbbf24", "#60a5fa", "#fb923c", "#c084fc", "#2dd4bf"];
			const color = colors[classRegistry.length % colors.length];
			const newKey = `clase_custom_${classIdCounter}`;
			matchedCls = { id: classIdCounter++, name: targetClass, color: color, key: newKey };
			classRegistry.push(matchedCls);
			updateClassesList();
			updateReassignDropdown();
		}

		const isMacro = Boolean(matchedCls.is_macro || detData.scale === "macro" || currentStructureScale === "macro");
		detData.scale = isMacro ? "macro" : "micro";
		detData.is_macro = isMacro;
		detData.structure_type = isMacro ? "macro_compartment" : "cell";

		let group = activeData.groups.find(g => g.label.toLowerCase() === matchedCls.name.toLowerCase() || g.key === matchedCls.key);
		if (!group) {
			group = {
				key: matchedCls.key,
				prompt: matchedCls.name,
				label: matchedCls.name,
				color: matchedCls.color,
				is_macro: isMacro,
				scale: isMacro ? "macro" : "micro",
				detections: [],
				count: 0
			};
			activeData.groups.push(group);
		} else if (isMacro) {
			group.is_macro = true;
			group.scale = "macro";
		}

		if (!detData.box && detData.bbox) {
			const [bx, by, bw, bh] = detData.bbox;
			detData.box = [bx, by, bx + bw, by + bh];
		}
		if (detData.score === undefined) {
			detData.score = detData.confidence || 0.95;
		}
		detData.class_id = matchedCls.id;

		group.detections.push(detData);
		group.count = group.detections.length;
		activeData.annotated = true;

		renderOverlay();
		updateClassesList();
		updateExportStats();
		renderGallery();
	}

	function finishPolygonDrawing() {
		if (currentPolygonPoints.length < 3) {
			alert("Un polígono requiere al menos 3 puntos. Haz clic sobre la imagen para añadir vértices.");
			return;
		}

		const activeData = imageStore.get(activeImageKey);
		if (!activeData) return;

		let targetClass = (correctionClassSelect && correctionClassSelect.value) ? correctionClassSelect.value.trim() : "";
		if (!targetClass) {
			targetClass = classRegistry.length > 0 ? classRegistry[classRegistry.length - 1].name : "Estructura";
		}

		let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
		const flatPoly = [];
		currentPolygonPoints.forEach(([px, py]) => {
			if (px < minX) minX = px;
			if (py < minY) minY = py;
			if (px > maxX) maxX = px;
			if (py > maxY) maxY = py;
			flatPoly.push(Math.round(px), Math.round(py));
		});

		const bbox = [Math.round(minX), Math.round(minY), Math.round(maxX - minX), Math.round(maxY - minY)];
		const box = [Math.round(minX), Math.round(minY), Math.round(maxX), Math.round(maxY)];

		const newDet = {
			score: 1.0,
			bbox: bbox,
			box: box,
			segmentation: [flatPoly]
		};

		addDetectionToActiveImage(targetClass, newDet);
		currentPolygonPoints = [];
		setActiveInteractiveTool(null);
	}

	// Canvas mouse event handlers for Box, Click, and Polygon modes
	displayImage.addEventListener("mousedown", (e) => {
		if (!activeImageKey || activeInteractiveTool !== 'box') return;
		const activeData = imageStore.get(activeImageKey);
		if (!activeData) return;

		const rect = displayImage.getBoundingClientRect();
		const relX = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
		const relY = Math.max(0, Math.min(1, (e.clientY - rect.top) / rect.height));
		startBoxX = Math.round(relX * activeData.width);
		startBoxY = Math.round(relY * activeData.height);
		isDraggingBox = true;

		// Create temporary SVG drag rectangle
		let tempBox = document.getElementById("temp-box-drag");
		if (!tempBox) {
			tempBox = document.createElementNS("http://www.w3.org/2000/svg", "rect");
			tempBox.setAttribute("id", "temp-box-drag");
			tempBox.style.fill = "rgba(56, 189, 248, 0.2)";
			tempBox.style.stroke = "#38bdf8";
			tempBox.style.strokeWidth = "2.5";
			tempBox.style.strokeDasharray = "5 3";
			overlaySvg.appendChild(tempBox);
		}
		tempBox.setAttribute("x", startBoxX.toString());
		tempBox.setAttribute("y", startBoxY.toString());
		tempBox.setAttribute("width", "0");
		tempBox.setAttribute("height", "0");
	});

	window.addEventListener("mousemove", (e) => {
		if (!isDraggingBox || activeInteractiveTool !== 'box' || !activeImageKey) return;
		const activeData = imageStore.get(activeImageKey);
		if (!activeData) return;

		const rect = displayImage.getBoundingClientRect();
		const relX = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
		const relY = Math.max(0, Math.min(1, (e.clientY - rect.top) / rect.height));
		const curX = Math.round(relX * activeData.width);
		const curY = Math.round(relY * activeData.height);

		const tempBox = document.getElementById("temp-box-drag");
		if (tempBox) {
			const x = Math.min(startBoxX, curX);
			const y = Math.min(startBoxY, curY);
			const w = Math.abs(curX - startBoxX);
			const h = Math.abs(curY - startBoxY);
			tempBox.setAttribute("x", x.toString());
			tempBox.setAttribute("y", y.toString());
			tempBox.setAttribute("width", w.toString());
			tempBox.setAttribute("height", h.toString());
		}
	});

	window.addEventListener("mouseup", async (e) => {
		if (!isDraggingBox || activeInteractiveTool !== 'box' || !activeImageKey) return;
		isDraggingBox = false;

		const tempBox = document.getElementById("temp-box-drag");
		if (tempBox) tempBox.remove();

		const activeData = imageStore.get(activeImageKey);
		if (!activeData || !activeData.file) return;

		const rect = displayImage.getBoundingClientRect();
		const relX = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
		const relY = Math.max(0, Math.min(1, (e.clientY - rect.top) / rect.height));
		const endX = Math.round(relX * activeData.width);
		const endY = Math.round(relY * activeData.height);

		const x1 = Math.min(startBoxX, endX);
		const y1 = Math.min(startBoxY, endY);
		const x2 = Math.max(startBoxX, endX);
		const y2 = Math.max(startBoxY, endY);

		if (Math.abs(x2 - x1) < 8 || Math.abs(y2 - y1) < 8) return;

		let targetClass = (correctionClassSelect && correctionClassSelect.value) ? correctionClassSelect.value.trim() : "";
		if (!targetClass) {
			targetClass = classRegistry.length > 0 ? classRegistry[0].name : "Estructura";
		}

		if (progressArea && progressFill && progressTextEl) {
			progressArea.style.display = "block";
			progressFill.style.width = "40%";
			progressTextEl.textContent = `Segmentando caja SAM '${targetClass}' [${x1},${y1} → ${x2},${y2}]...`;
		}

		try {
			const formData = new FormData();
			formData.append("image", activeData.file);
			formData.append("x1", x1.toString());
			formData.append("y1", y1.toString());
			formData.append("x2", x2.toString());
			formData.append("y2", y2.toString());
			formData.append("prompt", targetClass);
			formData.append("umbral", "0.05");
			formData.append("structure_scale", currentStructureScale || "micro");

			const resp = await fetch(`${API_URL}/segment-box`, {
				method: "POST",
				body: formData
			});

			if (!resp.ok) {
				const err = await resp.json();
				throw new Error(err.detail || "Error en segment-box");
			}

			const res = await resp.json();
			if (res.success && res.detection) {
				addDetectionToActiveImage(targetClass, res.detection);
				if (progressFill && progressTextEl) {
					progressFill.style.width = "100%";
					progressTextEl.textContent = `✓ Estructura '${targetClass}' segmentada con éxito`;
					setTimeout(() => { progressArea.style.display = "none"; }, 2500);
				}
			}
		} catch (err) {
			console.error("Error en segment-box:", err);
			if (progressTextEl) progressTextEl.textContent = `Error: ${err.message}`;
		}
	});

	let isSegmentingPoint = false;

	// Canvas Click: Handle Clic SAM and Draw Polygon modes
	async function handleCanvasPointClick(e) {
		if (e) {
			e.stopPropagation();
		}
		if (!activeImageKey) return;
		const activeData = imageStore.get(activeImageKey);
		if (!activeData) return;

		const rect = displayImage.getBoundingClientRect();
		if (!rect.width || !rect.height) return;
		const relX = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
		const relY = Math.max(0, Math.min(1, (e.clientY - rect.top) / rect.height));
		const pixelX = Math.round(relX * activeData.width);
		const pixelY = Math.round(relY * activeData.height);

		// 1. Polygon Drawing Mode
		if (activeInteractiveTool === 'polygon') {
			currentPolygonPoints.push([pixelX, pixelY]);
			if (finishPolygonBtn) {
				finishPolygonBtn.textContent = `✓ Finalizar Polígono (${currentPolygonPoints.length} pts)`;
			}
			renderOverlay();
			return;
		}

		// 2. Click SAM Mode
		if (activeInteractiveTool === 'click') {
			if (isSegmentingPoint) {
				console.debug("handleCanvasPointClick: ya se está procesando un punto, ignorando clic concurrente.");
				return;
			}
			isSegmentingPoint = true;

			let fileToSend = activeData.file;
			if (!fileToSend && activeData.dataUrl) {
				try {
					const blobRes = await fetch(activeData.dataUrl);
					const blob = await blobRes.blob();
					fileToSend = new File([blob], activeData.filename || "image.png", { type: "image/png" });
				} catch (be) {
					console.warn("Could not create File from dataUrl:", be);
				}
			}
			if (!fileToSend) {
				alert("⚠️ No hay imagen activa para segmentar.");
				isSegmentingPoint = false;
				return;
			}

			let targetClass = (correctionClassSelect && correctionClassSelect.value) ? correctionClassSelect.value.trim() : "";
			if (!targetClass) {
				targetClass = classRegistry.length > 0 ? classRegistry[0].name : "Célula";
			}

			statusRunning.style.display = "flex";
			statusIdle.style.display = "none";
			const engineLabel = currentEngine === "cellpose" ? "Cellpose-SAM (cpsam / MedSAM)" : "SAM 3.1";
			statusText.textContent = `👆 Segmentando '${targetClass}' en (${pixelX}, ${pixelY}) con ${engineLabel}...`;

			if (progressArea && progressFill && progressTextEl) {
				progressArea.style.display = "block";
				progressFill.style.width = "40%";
				progressTextEl.textContent = `Segmentando '${targetClass}' en (${pixelX}, ${pixelY})...`;
			}

			try {
				const formData = new FormData();
				formData.append("image", fileToSend);
				formData.append("x", relX.toString());
				formData.append("y", relY.toString());
				formData.append("prompt", targetClass);
				formData.append("umbral", thresholdSlider ? thresholdSlider.value : "0.05");
				formData.append("model_engine", currentEngine || "auto");
				formData.append("cellpose_model", currentCellposeModel || "cpsam");
				formData.append("structure_scale", currentStructureScale || "micro");

				const resp = await fetch(`${API_URL}/segment-point`, {
					method: "POST",
					body: formData
				});

				if (!resp.ok) {
					const err = await resp.json().catch(() => ({}));
					throw new Error(err.detail || `HTTP ${resp.status}`);
				}

				const res = await resp.json();
				if (res.success && res.detection) {
					addDetectionToActiveImage(targetClass, res.detection);
					statusText.textContent = `✓ Objeto '${targetClass}' segmentado y agregado (${res.engine || engineLabel})`;
					if (progressFill && progressTextEl) {
						progressFill.style.width = "100%";
						progressTextEl.textContent = `✓ Objeto '${targetClass}' segmentado y agregado`;
						setTimeout(() => { progressArea.style.display = "none"; }, 2500);
					}
					setTimeout(() => {
						statusRunning.style.display = "none";
						statusIdle.style.display = "flex";
					}, 2500);
				} else {
					statusText.textContent = `⚠️ No se detectó ninguna estructura en (${pixelX}, ${pixelY}).`;
					setTimeout(() => {
						statusRunning.style.display = "none";
						statusIdle.style.display = "flex";
					}, 2500);
				}
			} catch (err) {
				console.error("Error al segmentar punto:", err);
				alert(`Error al segmentar con SAM: ${err.message}`);
				statusRunning.style.display = "none";
				statusIdle.style.display = "flex";
			} finally {
				isSegmentingPoint = false;
			}
		}
	}

	displayImage.addEventListener("click", handleCanvasPointClick);

	// Double-click to finish polygon in draw mode
	displayImage.addEventListener("dblclick", (e) => {
		if (activeInteractiveTool === 'polygon' && currentPolygonPoints.length >= 3) {
			e.preventDefault();
			finishPolygonDrawing();
		}
	});

	// ======================= EXPORT =======================
	function updateExportStats() {
		const threshold = parseFloat(thresholdSlider.value);
		let totalImages = imageStore.size;
		let annotatedImages = 0;
		let totalAnnotations = 0;
		const classSet = new Set();

		imageStore.forEach(data => {
			if (!data.annotated) return;
			annotatedImages++;
			data.groups.forEach(group => {
				group.detections.forEach(det => {
					if (det.score >= threshold && !det._deleted) {
						totalAnnotations++;
						classSet.add(group.key);
					}
				});
			});
		});

		const totalImgsEl = document.getElementById("stat-total-imgs");
		const annotatedImgsEl = document.getElementById("stat-annotated-imgs");
		const totalDetsEl = document.getElementById("stat-total-dets");
		const totalClassesEl = document.getElementById("stat-total-classes");

		if (totalImgsEl) totalImgsEl.textContent = totalImages;
		if (annotatedImgsEl) annotatedImgsEl.textContent = annotatedImages;
		if (totalDetsEl) totalDetsEl.textContent = totalAnnotations;
		if (totalClassesEl) totalClassesEl.textContent = classSet.size;

		// Enable/disable buttons
		const hasData = annotatedImages > 0 && totalAnnotations > 0;
		if (exportCocoBtn) exportCocoBtn.disabled = !hasData;
	}

	// Build export payload
	function buildExportPayload() {
		const threshold = parseFloat(thresholdSlider.value);
		const imagesPayload = [];

		imageStore.forEach((data, key) => {
			if (!data.annotated) return;

			const classes = [];
			const annotations = [];
			let annId = 1;

			data.groups.forEach(group => {
				let cls = classRegistry.find(c => c.key === group.key);
				if (!cls) {
					const newId = classRegistry.length + 1;
					cls = {
						id: newId,
						key: group.key,
						name: group.label || group.key,
						color: group.color || "#8b5cf6",
					};
					classRegistry.push(cls);
				}

				if (!cls.id) {
					cls.id = classRegistry.indexOf(cls) + 1;
				}

				let hasAnnotations = false;
				group.detections.forEach(det => {
					if (det.score < threshold || det._deleted) return;
					hasAnnotations = true;

					const [x1, y1, x2, y2] = det.box || [0, 0, 0, 0];
					const bbox = [x1, y1, x2 - x1, y2 - y1]; // COCO: [x, y, width, height]

					annotations.push({
						id: annId++,
						class_id: cls.id,
						bbox: bbox,
						segmentation: det.segmentation || [],
						area: det.area || ((x2 - x1) * (y2 - y1)),
						score: det.score,
					});
				});

				if (hasAnnotations) {
					if (!classes.find(c => c.id === cls.id)) {
						classes.push({ id: cls.id, name: cls.name, color: cls.color });
					}
				}
			});

			if (annotations.length > 0) {
				imagesPayload.push({
					image_filename: data.filename,
					image_width: data.width,
					image_height: data.height,
					classes: classes,
					annotations: annotations,
				});
			}
		});

		return imagesPayload;
	}

