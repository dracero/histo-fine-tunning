	// --- 2. Zero-Shot Classification with CONCH (Batch-Aware) ---
	async function runConchClassification(targetKey = null) {
		const keysToProcess = (typeof targetKey === "string" && targetKey)
			? [targetKey]
			: Array.from(imageStore.keys());

		if (keysToProcess.length === 0) {
			alert("No hay imágenes cargadas para clasificar.");
			return;
		}

		statusIdle.style.display = "none";
		statusRunning.style.display = "flex";
		let totalProcessed = 0;
		let totalClassifiedDets = 0;

		for (let idx = 0; idx < keysToProcess.length; idx++) {
			const key = keysToProcess[idx];
			const data = imageStore.get(key);
			if (!data) continue;

			// Auto-segment if this image doesn't have detections yet
			if (!data.groups || data.groups.length === 0) {
				statusText.textContent = `[${idx + 1}/${keysToProcess.length}] Auto-segmentando ${data.filename}...`;
				await runAutoSegmentation(key);
			}

			let allDets = [];
			(data.groups || []).forEach((g) => {
				if (g.detections) {
					g.detections.forEach((d) => {
						allDets.push({
							...d,
							id: d.id,
							bbox: d.bbox,
							box: d.box || (d.bbox ? [d.bbox[0], d.bbox[1], d.bbox[0] + d.bbox[2], d.bbox[1] + d.bbox[3]] : null),
							segmentation: d.segmentation || [],
							score: d.score !== undefined ? d.score : 0.95,
							class_key: g.key,
							label: g.label,
							color: g.color,
						});
					});
				}
			});

			if (allDets.length === 0) continue;

			let candidateClasses = classRegistry.map(c => ({
				key: c.key,
				name: c.name,
				label: c.name,
				prompt: c.prompt || c.name,
				color: c.color,
			}));

			if (candidateClasses.length === 0) {
				candidateClasses = data.groups.map(g => ({
					key: g.key,
					name: g.label,
					label: g.label,
					prompt: g.label,
					color: g.color,
				}));
			}

			statusText.textContent = `[${idx + 1}/${keysToProcess.length}] 🔬 CONCH: Clasificando ${allDets.length} instancias en ${data.filename}...`;

			try {
				let imageFile = data.file;
				if (!(imageFile instanceof File || imageFile instanceof Blob) && data.dataUrl) {
					const arr = data.dataUrl.split(",");
					const mime = arr[0].match(/:(.*?);/)[1];
					const bstr = atob(arr[1]);
					let n = bstr.length;
					const u8arr = new Uint8Array(n);
					while (n--) u8arr[n] = bstr.charCodeAt(n);
					imageFile = new File([u8arr], data.filename || "image.png", { type: mime });
				}

				const formData = new FormData();
				formData.append("image", imageFile);
				formData.append("detections", JSON.stringify(allDets));
				formData.append("classes", JSON.stringify(candidateClasses));
				formData.append("temperature", "0.05");
				if (window._activeOntologyName) {
					formData.append("ontology_name", window._activeOntologyName);
				}

				const res = await fetch(`${API_URL}/classify-detections-conch`, {
					method: "POST",
					body: formData,
				});

				if (!res.ok) {
					console.warn(`Error CONCH en ${data.filename}: ${res.status}`);
					continue;
				}

				const result = await res.json();
				const classified = result.detections || [];
				if (classified.length > 0) {
					const groupsMap = new Map();
					for (let i = 0; i < classified.length; i++) {
						const det = classified[i];
						const origDet = allDets[i] || {};

						det.segmentation = det.segmentation || origDet.segmentation || [];
						det.box = det.box || origDet.box;
						det.bbox = det.bbox || origDet.bbox;
						det.score = det.conch_confidence !== undefined ? det.conch_confidence : (origDet.score || 0.95);

						const groupKey = det.class_key || det.category_id || "clase_1";
						if (!groupsMap.has(groupKey)) {
							groupsMap.set(groupKey, {
								key: groupKey,
								label: det.class_label || groupKey,
								color: det.color || getClassColor(groupKey),
								detections: [],
							});
						}
						groupsMap.get(groupKey).detections.push(det);

						if (!classRegistry.find(c => c.key === groupKey)) {
							classRegistry.push({
								id: classIdCounter++,
								name: det.class_label || groupKey,
								color: det.color || "#8b5cf6",
								key: groupKey,
								prompt: det.class_label || groupKey,
							});
						}
					}
					data.groups = Array.from(groupsMap.values());
					totalClassifiedDets += classified.length;
					totalProcessed++;
					renderGallery();
					updateExportStats();
				}
			} catch (err) {
				console.error(`Error en CONCH ${data.filename}:`, err);
			}
		}

		if (activeImageKey) {
			viewerControls.style.display = "flex";
			renderOverlay();
			updateClassesList();
		}
		renderGallery();
		updateExportStats();

		statusText.textContent = `✅ CONCH Lote: ${totalProcessed} imágenes clasificadas (${totalClassifiedDets} instancias).`;
		setTimeout(() => {
			statusRunning.style.display = "none";
			statusIdle.style.display = "flex";
		}, 3500);
	}

	// --- Gemini Vision Batch Cell Classification ---
	const classifyGeminiBtn = document.getElementById("classify-gemini-btn");
	const viewerClassifyGeminiBtn = document.getElementById("viewer-classify-gemini-btn");

	async function runGeminiClassification(targetKey = null) {
		const key = targetKey || activeImageKey;
		if (!key) {
			alert("Por favor selecciona o sube una imagen con células segmentadas primero.");
			return;
		}

		const data = imageStore.get(key);
		if (!data) return;

		let cellDets = [];
		let macroDets = [];
		const existingMacroGroups = [];
		const knownMacroKeys = new Set([
			"tubulo_seminifero", "tubulo", "tubule", "membrana_basal",
			"luz_tubular", "luz", "lumen", "espacio_intersticial", "intersticio"
		]);

		(data.groups || []).forEach((g) => {
			const isGroupMacro = Boolean(
				g.is_macro ||
				g.role === "compartment" ||
				g.role === "boundary_outer" ||
				g.role === "cavity" ||
				g.role === "stroma" ||
				knownMacroKeys.has(String(g.key || "").toLowerCase())
			);

			if (isGroupMacro) {
				existingMacroGroups.push(g);
			}

			(g.detections || []).forEach((d) => {
				const isDetMacro = isGroupMacro || Boolean(
					d.is_macro ||
					d.role === "compartment" ||
					d.role === "boundary_outer" ||
					d.role === "cavity" ||
					d.role === "stroma" ||
					knownMacroKeys.has(String(d.class_key || g.key || "").toLowerCase())
				);

				const formatted = {
					...d,
					id: d.id,
					bbox: d.bbox,
					box: d.box || (d.bbox ? [d.bbox[0], d.bbox[1], d.bbox[0] + d.bbox[2], d.bbox[1] + d.bbox[3]] : null),
					segmentation: d.segmentation || [],
					score: d.score !== undefined ? d.score : 0.95,
					class_key: g.key,
					label: g.label,
					color: g.color,
					is_macro: isDetMacro,
				};

				if (isDetMacro) {
					macroDets.push(formatted);
				} else {
					cellDets.push(formatted);
				}
			});
		});

		if (cellDets.length === 0) {
			alert("No hay células segmentadas en esta imagen. Primero segmenta con Cellpose o usa el Pipeline Integral.");
			return;
		}

		statusIdle.style.display = "none";
		statusRunning.style.display = "flex";
		statusText.textContent = `✨ Gemini Vision: Clasificando ${cellDets.length} células en batch (con respeto ontológico espacial)...`;

		try {
			let imageFile = data.file;
			if (!(imageFile instanceof File || imageFile instanceof Blob) && data.dataUrl) {
				const arr = data.dataUrl.split(",");
				const mime = arr[0].match(/:(.*?);/)[1];
				const bstr = atob(arr[1]);
				let n = bstr.length;
				const u8arr = new Uint8Array(n);
				while (n--) u8arr[n] = bstr.charCodeAt(n);
				imageFile = new File([u8arr], data.filename || "image.png", { type: mime });
			}

			let candidateClasses = classRegistry.map(c => ({
				key: c.key,
				name: c.name,
				label: c.name,
				prompt: c.prompt || c.name,
				color: c.color,
			}));

			const formData = new FormData();
			formData.append("image", imageFile);
			formData.append("detections", JSON.stringify(cellDets));
			if (macroDets.length > 0) {
				formData.append("macro_annotations", JSON.stringify(macroDets));
			}
			if (candidateClasses.length > 0) {
				formData.append("classes", JSON.stringify(candidateClasses));
			}
			if (window._activeOntologyName) {
				formData.append("ontology_name", window._activeOntologyName);
			}

			const res = await fetch(`${API_URL}/classify-gemini`, {
				method: "POST",
				body: formData,
			});

			if (!res.ok) {
				const err = await res.json().catch(() => ({}));
				throw new Error(err.detail || `Error HTTP ${res.status}`);
			}

			const result = await res.json();
			const classified = result.detections || [];
			if (classified.length > 0) {
				const groupsMap = new Map();

				// Preserve existing macro groups intact
				for (const mg of existingMacroGroups) {
					groupsMap.set(mg.key, {
						...mg,
						detections: mg.detections || [],
					});
				}

				for (let i = 0; i < classified.length; i++) {
					const det = classified[i];
					const origDet = cellDets[i] || {};

					det.segmentation = det.segmentation || origDet.segmentation || [];
					det.box = det.box || origDet.box;
					det.bbox = det.bbox || origDet.bbox;
					det.score = det.score !== undefined ? det.score : (origDet.score || 0.95);

					const groupKey = det.class_key || det.category_id || "clase_1";
					const groupLabel = det.class_label || det.label || groupKey;
					const groupColor = det.color || getClassColor(groupKey);
					det.color = groupColor;
					det.label = groupLabel;
					det.class_label = groupLabel;

					if (!groupsMap.has(groupKey)) {
						groupsMap.set(groupKey, {
							key: groupKey,
							label: groupLabel,
							color: groupColor,
							detections: [],
						});
					}
					groupsMap.get(groupKey).detections.push(det);

					const existingClass = classRegistry.find(c => c.key === groupKey);
					if (!existingClass) {
						classRegistry.push({
							id: classIdCounter++,
							name: groupLabel,
							color: groupColor,
							key: groupKey,
							prompt: groupLabel,
						});
					} else {
						existingClass.name = groupLabel;
						existingClass.color = groupColor;
					}
				}
				data.groups = Array.from(groupsMap.values());
				data.annotated = true;
				renderGallery();
				updateExportStats();

				if (key === activeImageKey) {
					viewerControls.style.display = "flex";
					selectedDetections.clear();
					updateSelectionToolbar();
					renderOverlay();
					updateClassesList();
				}

				const corrMsg = (result.spatial_corrections_count && result.spatial_corrections_count > 0)
					? ` (${result.spatial_corrections_count} correcciones de ontología espacial aplicadas)`
					: " (100% coherencia espacial)";
				statusText.textContent = `✅ Gemini Vision clasificó ${classified.length} células en batch${corrMsg}!`;
				setTimeout(() => {
					statusRunning.style.display = "none";
					statusIdle.style.display = "flex";
				}, 3500);
			}
		} catch (err) {
			console.error("Error clasificando con Gemini:", err);
			alert(`⚠️ Error en clasificación con Gemini: ${err.message}`);
			statusRunning.style.display = "none";
			statusIdle.style.display = "flex";
		}
	}

	classifyGeminiBtn?.addEventListener("click", () => runGeminiClassification());
	viewerClassifyGeminiBtn?.addEventListener("click", () => runGeminiClassification());

	classifyConchBtn?.addEventListener("click", () => runConchClassification());
	toggleConchClassifyBtn?.addEventListener("click", () => runConchClassification());

	// --- 2b. Dedicated Lunit DINO (ViT-Small/8) Feature Classifier (Batch-Aware) ---
	const classifyDinoBtn = document.getElementById("classify-dino-btn");

	async function runDinoClassification(targetKey = null) {
		const keysToProcess = (typeof targetKey === "string" && targetKey)
			? [targetKey]
			: Array.from(imageStore.keys());

		if (keysToProcess.length === 0) {
