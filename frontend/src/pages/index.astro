	.progress-fill { height: 100%; background: linear-gradient(90deg, var(--primary), var(--accent-cyan)); border-radius: 9999px; width: 0%; transition: width 0.3s; }
	.progress-text { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.3rem; display: block; }

	/* ===== VIEWER ===== */
	.panel-card { background: var(--bg-panel); backdrop-filter: blur(16px); border: 1px solid var(--border-color); border-radius: 16px; padding: 1.5rem; box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.3); }
	.section-title { font-family: var(--font-title); font-size: 1.15rem; font-weight: 600; letter-spacing: -0.01em; }
	.viewer-panel { display: flex; flex-direction: column; min-height: 600px; }
	.viewer-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--border-color); flex-wrap: wrap; gap: 0.5rem; }
	.viewer-controls { display: flex; align-items: center; gap: 0.6rem; font-size: 0.8rem; color: var(--text-muted); }
	.separator { color: rgba(255,255,255,0.1); }
	.counter-badge { font-family: var(--font-title); font-weight: 600; color: var(--accent-cyan); background: rgba(6, 182, 212, 0.08); padding: 0.15rem 0.5rem; border-radius: 6px; font-size: 0.8rem; }
	.toggle-container { display: inline-flex; align-items: center; gap: 0.35rem; cursor: pointer; user-select: none; }
	.toggle-container input { position: absolute; opacity: 0; width: 0; height: 0; }
	.toggle-label { color: var(--text-muted); transition: color 0.15s; font-size: 0.8rem; }
	.toggle-container:hover .toggle-label { color: var(--text-main); }
	.toggle-container input:checked + .toggle-label { color: var(--text-main); }

	/* Selection toolbar */
	.selection-toolbar { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem; background: rgba(139, 92, 246, 0.1); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 10px; margin-bottom: 0.75rem; font-size: 0.8rem; color: var(--text-main); flex-wrap: wrap; }

	.viewer-content { position: relative; flex-grow: 1; background: rgba(0,0,0,0.2); border-radius: 12px; border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center; overflow: hidden; min-height: 400px; }
	.empty-viewer { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem; color: var(--text-muted); font-size: 0.9rem; padding: 2rem; text-align: center; }
	.empty-icon { width: 50px; height: 50px; color: rgba(255,255,255,0.1); }

	.image-viewport { position: relative; max-width: 100%; max-height: 100%; display: flex; align-items: center; justify-content: center; padding: 0.75rem; }
	.viewer-container { position: relative; display: inline-block; box-shadow: 0 20px 40px rgba(0,0,0,0.5); border-radius: 8px; overflow: hidden; }
	.viewer-container img { max-width: 100%; max-height: 65vh; display: block; object-fit: contain; border-radius: 8px; }
	.overlay-svg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 10; }

	/* SVG element styles */
	.det-polygon { cursor: pointer; pointer-events: auto; transition: all 0.1s; }
	.det-polygon:hover { filter: brightness(1.3); }
	.det-polygon.selected { stroke-width: 3 !important; filter: drop-shadow(0 0 8px currentColor); }
	.det-box { stroke-width: 1.2; pointer-events: auto; cursor: pointer; transition: all 0.1s; fill: none; }
	.det-box:hover { stroke-width: 2.5; }
	.det-box.selected { stroke-width: 3; stroke-dasharray: 5,3; }

	/* Tooltip */
	.box-tooltip { position: fixed; z-index: 1000; background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; padding: 0.5rem 0.75rem; font-size: 0.75rem; pointer-events: none; color: #fff; box-shadow: 0 4px 20px rgba(0,0,0,0.4); display: flex; flex-direction: column; gap: 0.15rem; transform: translate(15px, 15px); }
	.tooltip-category { font-weight: 700; font-size: 0.8rem; }
	.tooltip-score { font-weight: 600; color: var(--accent-cyan); }
	.tooltip-coords { color: var(--text-muted); font-family: monospace; font-size: 0.7rem; }
	.tooltip-hint { color: rgba(255,255,255,0.3); font-size: 0.65rem; margin-top: 0.15rem; }

	/* Context menu */
	.context-menu { position: fixed; z-index: 1100; background: rgba(15, 23, 42, 0.97); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.15); border-radius: 10px; padding: 0.4rem; min-width: 180px; box-shadow: 0 8px 30px rgba(0,0,0,0.5); }
	.ctx-header { padding: 0.4rem 0.6rem; font-weight: 700; font-size: 0.8rem; color: var(--accent-cyan); }
	.ctx-item { padding: 0.4rem 0.6rem; font-size: 0.8rem; cursor: pointer; border-radius: 6px; transition: background 0.1s; }
	.ctx-item:hover { background: rgba(255,255,255,0.08); }
	.ctx-separator { height: 1px; background: var(--border-color); margin: 0.3rem 0; }
	.ctx-sub-header { padding: 0.3rem 0.6rem; font-size: 0.7rem; color: var(--text-muted); font-weight: 600; }
	.ctx-class-item { padding: 0.35rem 0.6rem; font-size: 0.78rem; cursor: pointer; border-radius: 6px; transition: background 0.1s; display: flex; align-items: center; gap: 0.4rem; }
	.ctx-class-item:hover { background: rgba(255,255,255,0.08); }
	.ctx-class-swatch { width: 10px; height: 10px; border-radius: 3px; }

	/* Modal styles */
	.modal-backdrop {
		position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
		background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(4px);
		display: flex; align-items: center; justify-content: center;
		z-index: 9999;
	}
	.modal-card {
		background: #0f172a; border: 1px solid var(--border-color);
		border-radius: 12px; width: 90%; max-width: 620px;
		box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5); overflow: hidden;
	}
	.modal-header {
		padding: 1rem 1.25rem; background: rgba(255, 255, 255, 0.03);
		border-bottom: 1px solid var(--border-color);
		display: flex; align-items: center; justify-content: space-between;
	}
	.modal-header h3 { margin: 0; font-size: 1rem; color: var(--text-main); }
	.modal-body { padding: 1.25rem; }
</style>

<script>
	const hostname = typeof window !== "undefined" && window.location.hostname ? window.location.hostname : "127.0.0.1";
	const API_URL = `http://${hostname}:8000/api`;

	// ======================= STATE =======================
	// Multi-image state
	let imageStore = new Map();  // filename -> { file, dataUrl, width, height, groups, annotated }
	let activeImageKey = null;

	// Detection editing state
	let selectedDetections = new Set();  // "groupKey:detIndex" identifiers

	// Interactive mode states
	let isClickMode = false;
	let isDrawMode = false;
	let currentPolygonPoints = [];

	// Global class registry (shared across images)
	// { id, name, color, key }
	let classRegistry = [];
	let classIdCounter = 1;

	// Hidden categories
	let hiddenCategories = new Set();

	// ======================= DOM =======================
	const dropZone = document.getElementById("drop-zone");
	const fileInput = document.getElementById("file-input");
	const uploadContent = document.getElementById("upload-content");
	const imageGallery = document.getElementById("image-gallery");

	const thresholdSlider = document.getElementById("threshold-slider");
	const thresholdVal = document.getElementById("threshold-val");

	const statusIdle = document.getElementById("status-idle");
	const statusRunning = document.getElementById("status-running");
	const statusText = document.getElementById("status-text");

	const emptyViewer = document.getElementById("empty-viewer");
	const imageViewport = document.getElementById("image-viewport");
	const displayImage = document.getElementById("display-image");
	const overlaySvg = document.getElementById("overlay-svg");
	const detectionsCounter = document.getElementById("detections-counter");
	const viewerControls = document.getElementById("viewer-controls");
	const togglePolygons = document.getElementById("toggle-polygons");
	const toggleBoxes = document.getElementById("toggle-boxes");

	const selectionToolbar = document.getElementById("selection-toolbar");
	const selectionCount = document.getElementById("selection-count");
	const reassignSelect = document.getElementById("reassign-select");
	const deleteSelectedBtn = document.getElementById("delete-selected-btn");
	const deselectBtn = document.getElementById("deselect-btn");

	const tooltip = document.getElementById("box-tooltip");
	const tooltipCategory = document.getElementById("tooltip-category");
	const tooltipScore = document.getElementById("tooltip-score-val");
	const tooltipCoords = document.getElementById("tooltip-coords-val");

	const contextMenu = document.getElementById("context-menu");
	const ctxHeader = document.getElementById("ctx-header");
	const ctxDelete = document.getElementById("ctx-delete");
	const ctxClassList = document.getElementById("ctx-class-list");

	const classesList = document.getElementById("classes-list");
	const addClassBtn = document.getElementById("add-class-btn");
	const newClassInput = document.getElementById("new-class-input");
	const toggleClickMode = document.getElementById("toggle-click-mode");
	const toggleDrawMode = document.getElementById("toggle-draw-mode");
	const finishPolygonBtn = document.getElementById("finish-polygon-btn");

	const exportCocoBtn = document.getElementById("export-coco-btn");
	const uploadRoboflowBtn = document.getElementById("upload-roboflow-btn");
	const unifyVersionsBtn = document.getElementById("unify-versions-btn");
	const trainRoboflowBtn = document.getElementById("train-roboflow-btn");
	const fullPipelineBtn = document.getElementById("full-pipeline-btn");
	const roboflowStatus = document.getElementById("roboflow-status");
	const progressArea = document.getElementById("progress-area");
	const progressFill = document.getElementById("progress-fill");
	const progressTextEl = document.getElementById("progress-text");

	// ======================= TABS =======================
	document.querySelectorAll(".tab-btn").forEach(btn => {
		btn.addEventListener("click", () => {
			document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
			document.querySelectorAll(".tab-content").forEach(c => c.classList.remove("active"));
			btn.classList.add("active");
			document.getElementById(btn.dataset.tab).classList.add("active");
			if (btn.dataset.tab === "pdf-tab") {
				loadSavedOntologies(true);
			}
		});
	});

	// ======================= FILE UPLOAD =======================
	["dragenter", "dragover"].forEach(ev => {
		dropZone.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.add("dragover"); }, false);
	});
	["dragleave", "drop"].forEach(ev => {
		dropZone.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.remove("dragover"); }, false);
	});

	dropZone.addEventListener("drop", (e) => {
		if (e.dataTransfer.files.length > 0) handleFiles(Array.from(e.dataTransfer.files));
	});
	fileInput.addEventListener("change", () => {
		if (fileInput.files.length > 0) handleFiles(Array.from(fileInput.files));
	});

	async function handleFiles(files) {
		const pdfFiles = files.filter(f => f.name.toLowerCase().endsWith(".pdf") || f.type === "application/pdf");
		if (pdfFiles.length > 0) {
			document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
			document.querySelectorAll(".tab-content").forEach(c => c.classList.remove("active"));
			document.querySelector('[data-tab="pdf-tab"]')?.classList.add("active");
			document.getElementById("pdf-tab")?.classList.add("active");
			handlePdfUpload(pdfFiles[0]);
			return;
		}

		const imageFiles = files.filter(f => f.type.startsWith("image/"));
		if (imageFiles.length === 0) { alert("Selecciona archivos de imagen o un PDF."); return; }

		for (const file of imageFiles) {
			const key = file.name + "_" + Date.now();
			const dataUrl = await readFileAsDataUrl(file);
			const dims = await getImageDimensions(dataUrl);

			imageStore.set(key, {
				file: file,
				filename: file.name,
				dataUrl: dataUrl,
				width: dims.width,
				height: dims.height,
				groups: [],
				annotated: false,
			});
		}

		renderGallery();

		// Auto-segment new images
		for (const file of imageFiles) {
			const key = [...imageStore.keys()].find(k => imageStore.get(k).file === file);
			if (key) {
				selectImage(key);
				await runAutoSegmentation(key);
			}
		}

		fileInput.value = "";
	}

	function readFileAsDataUrl(file) {
		return new Promise((resolve) => {
			const reader = new FileReader();
			reader.onload = (e) => resolve(e.target.result);
			reader.readAsDataURL(file);
		});
	}

	function getImageDimensions(dataUrl) {
		return new Promise((resolve) => {
			const img = new Image();
			img.onload = () => resolve({ width: img.width, height: img.height });
			img.src = dataUrl;
		});
	}

	// ======================= IMAGE GALLERY =======================
	function renderGallery() {
		imageGallery.innerHTML = "";
		imageStore.forEach((data, key) => {
			const thumb = document.createElement("div");
			thumb.className = `gallery-thumb ${key === activeImageKey ? "active" : ""}`;
			thumb.dataset.key = key;

			const detCount = countDetections(data);
			thumb.innerHTML = `
				<img src="${data.dataUrl}" alt="${data.filename}" />
				<span class="thumb-badge ${data.annotated ? "annotated" : "pending"}"></span>
				<button class="thumb-remove" title="Quitar imagen">✕</button>
				${detCount > 0 ? `<span class="thumb-count">${detCount}</span>` : ""}
			`;

			thumb.addEventListener("click", (e) => {
				if (e.target.classList.contains("thumb-remove")) {
					e.stopPropagation();
					removeImage(key);
					return;
				}
				selectImage(key);
			});

			imageGallery.appendChild(thumb);
		});
	}

	function removeImage(key) {
		imageStore.delete(key);
		if (activeImageKey === key) {
			activeImageKey = null;
			const first = imageStore.keys().next().value;
			if (first) selectImage(first);
			else resetViewer();
		}
		renderGallery();
		updateExportStats();
	}

	function selectImage(key) {
		activeImageKey = key;
		const data = imageStore.get(key);
		if (!data) return;

		displayImage.src = data.dataUrl;
		emptyViewer.style.display = "none";
		imageViewport.style.display = "flex";

		selectedDetections.clear();
		updateSelectionToolbar();
		renderOverlay();
		renderGallery();
		updateClassesList();
		updateExportStats();

		if (data.groups.length > 0) {
			viewerControls.style.display = "flex";
		} else {
			viewerControls.style.display = "none";
		}
	}

	function resetViewer() {
		emptyViewer.style.display = "flex";
		imageViewport.style.display = "none";
		viewerControls.style.display = "none";
		overlaySvg.innerHTML = "";
		statusRunning.style.display = "none";
		statusIdle.style.display = "flex";
	}

	function countDetections(data) {
		const threshold = parseFloat(thresholdSlider.value);
		let count = 0;
		(data.groups || []).forEach(g => {
			count += g.detections.filter(d => d.score >= threshold).length;
		});
		return count;
	}

	// ======================= SEGMENTATION =======================
	const customPromptInput = document.getElementById("custom-prompt-input");
	const reSegmentBtn = document.getElementById("re-segment-btn");

	reSegmentBtn.addEventListener("click", () => {
		if (activeImageKey) runAutoSegmentation(activeImageKey);
	});
	customPromptInput.addEventListener("keydown", (e) => {
		if (e.key === "Enter" && activeImageKey) runAutoSegmentation(activeImageKey);
	});

	async function runAutoSegmentation(key) {
		const data = imageStore.get(key);
		if (!data) return;

		statusIdle.style.display = "none";
		statusRunning.style.display = "flex";
		statusText.textContent = `Segmentando ${data.filename}...`;

		const formData = new FormData();
		formData.append("image", data.file);
		formData.append("umbral", thresholdSlider.value);
		if (customPromptInput.value.trim()) {
			formData.append("custom_prompt", customPromptInput.value.trim());
		}
		// Use ontology prompts if an active ontology is selected
		if (window._activeOntologyName) {
			formData.append("ontology_name", window._activeOntologyName);
		}

		try {
			const response = await fetch(`${API_URL}/segment-auto`, {
				method: "POST",
				body: formData
			});

			if (!response.ok) {
				const err = await response.json();
				throw new Error(err.detail || "Error del servidor.");
			}

			const result = await response.json();
			data.groups = result.groups || [];
			data.width = result.width || data.width;
			data.height = result.height || data.height;
			data.annotated = true;

			// Register classes from this segmentation
			for (const group of data.groups) {
				if (!classRegistry.find(c => c.key === group.key)) {
					classRegistry.push({
						id: classIdCounter++,
						name: group.label,
						color: group.color,
						key: group.key,
					});
				}
			}

			if (key === activeImageKey) {
				viewerControls.style.display = "flex";
				selectedDetections.clear();
				updateSelectionToolbar();
				renderOverlay();
				updateClassesList();
			}

			renderGallery();
			updateExportStats();

			statusText.textContent = `✓ ${data.filename}: ${result.total_detections} detecciones`;
			setTimeout(() => {
				statusRunning.style.display = "none";
				statusIdle.style.display = "none";
			}, 2500);

		} catch (error) {
			console.error(error);
			alert(`Error: ${error.message}`);
			statusRunning.style.display = "none";
			statusIdle.style.display = "flex";
		}
	}

	// ======================= THRESHOLD =======================
	thresholdSlider.addEventListener("input", (e) => {
		thresholdVal.textContent = parseFloat(e.target.value).toFixed(2);
		renderOverlay();
		renderGallery();
		updateClassesList();
		updateExportStats();
	});

	// ======================= TOGGLE VISIBILITY =======================
	togglePolygons.addEventListener("change", renderOverlay);
	toggleBoxes.addEventListener("change", renderOverlay);

	// ======================= RENDER OVERLAY =======================
	function renderOverlay() {
		overlaySvg.innerHTML = "";
		if (!activeImageKey) return;

		const data = imageStore.get(activeImageKey);
		if (!data || !data.groups.length) return;

		const w = data.width || displayImage.naturalWidth || 1;
		const h = data.height || displayImage.naturalHeight || 1;

		overlaySvg.setAttribute("viewBox", `0 0 ${w} ${h}`);
		overlaySvg.setAttribute("preserveAspectRatio", "xMidYMid meet");

		const threshold = parseFloat(thresholdSlider.value);
		const showPolygons = togglePolygons.checked;
		const showBoxes = toggleBoxes.checked;
		let totalCount = 0;

		data.groups.forEach(group => {
			if (hiddenCategories.has(group.key)) return;

			const color = getClassColor(group.key);
			const label = getClassName(group.key);

			group.detections.forEach((det, detIdx) => {
				if (det.score < threshold) return;
				if (det._deleted) return;
				totalCount++;

				const detId = `${group.key}:${detIdx}`;
				const isSelected = selectedDetections.has(detId);

				// Draw polygon
				if (showPolygons && det.segmentation && det.segmentation.length > 0) {
					det.segmentation.forEach(poly => {
						const points = [];
						for (let i = 0; i < poly.length; i += 2) {
							points.push(`${poly[i]},${poly[i+1]}`);
						}
						const polygon = document.createElementNS("http://www.w3.org/2000/svg", "polygon");
						polygon.setAttribute("points", points.join(" "));
						polygon.setAttribute("class", `det-polygon ${isSelected ? "selected" : ""}`);
						polygon.style.fill = hexToRgba(color, isSelected ? 0.35 : 0.2);
						polygon.style.stroke = color;
						polygon.style.strokeWidth = isSelected ? "3" : "1.5";
						polygon.dataset.detId = detId;
						addDetectionListeners(polygon, group, det, detIdx, color, label);
						overlaySvg.appendChild(polygon);
					});
				}

				// Draw bounding box
				if (showBoxes && det.box) {
					const [x1, y1, x2, y2] = det.box;
					const rect = document.createElementNS("http://www.w3.org/2000/svg", "rect");
					rect.setAttribute("x", x1);
					rect.setAttribute("y", y1);
					rect.setAttribute("width", x2 - x1);
					rect.setAttribute("height", y2 - y1);
					rect.setAttribute("class", `det-box ${isSelected ? "selected" : ""}`);
					rect.style.stroke = color;
					rect.dataset.detId = detId;
					addDetectionListeners(rect, group, det, detIdx, color, label);
					overlaySvg.appendChild(rect);
				}

				// If neither mode shows anything, still draw boxes
				if (!showPolygons && !showBoxes && det.box) {
					const [x1, y1, x2, y2] = det.box;
					const rect = document.createElementNS("http://www.w3.org/2000/svg", "rect");
					rect.setAttribute("x", x1);
					rect.setAttribute("y", y1);
					rect.setAttribute("width", x2 - x1);
					rect.setAttribute("height", y2 - y1);
					rect.setAttribute("class", `det-box ${isSelected ? "selected" : ""}`);
					rect.style.stroke = color;
					rect.style.fill = hexToRgba(color, 0.08);
					rect.dataset.detId = detId;
					addDetectionListeners(rect, group, det, detIdx, color, label);
					overlaySvg.appendChild(rect);
				}
			});
		});

		detectionsCounter.textContent = `${totalCount} detecciones`;

		// Render live drawing polygon points if in drawing mode
		if (isDrawMode && currentPolygonPoints.length > 0) {
			const ptsString = currentPolygonPoints.map(p => `${p[0]},${p[1]}`).join(" ");

			// Draw temporary polygon outline
			const tempPoly = document.createElementNS("http://www.w3.org/2000/svg", "polygon");
			tempPoly.setAttribute("points", ptsString);
			tempPoly.style.fill = "rgba(245, 158, 11, 0.25)";
			tempPoly.style.stroke = "#f59e0b";
			tempPoly.style.strokeWidth = "2";
			tempPoly.style.strokeDasharray = "4";
			overlaySvg.appendChild(tempPoly);

			// Draw vertex handles
			currentPolygonPoints.forEach((p, idx) => {
				const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
				circle.setAttribute("cx", p[0]);
				circle.setAttribute("cy", p[1]);
				circle.setAttribute("r", "5");
				circle.style.fill = idx === 0 ? "#ef4444" : "#f59e0b";
				circle.style.stroke = "#ffffff";
				circle.style.strokeWidth = "1.5";
				overlaySvg.appendChild(circle);
			});
		}
	}

	function addDetectionListeners(el, group, det, detIdx, color, label) {
		const detId = `${group.key}:${detIdx}`;

		// Tooltip
		el.addEventListener("mouseenter", () => {
			tooltipCategory.textContent = label;
			tooltipCategory.style.color = color;
			let scoreText = `${(det.score * 100).toFixed(1)}%`;
			if (det.conch_confidence) {
				scoreText += ` · 🔬 CONCH: ${(det.conch_confidence * 100).toFixed(0)}%`;
			}
			tooltipScore.textContent = scoreText;
			if (det.box) {
				const [x1, y1, x2, y2] = det.box;
				tooltipCoords.textContent = `${Math.round(x1)},${Math.round(y1)} → ${Math.round(x2)},${Math.round(y2)}`;
			}
			tooltip.style.display = "block";
		});
		el.addEventListener("mousemove", (e) => {
			tooltip.style.left = `${e.clientX}px`;
			tooltip.style.top = `${e.clientY}px`;
		});
		el.addEventListener("mouseleave", () => { tooltip.style.display = "none"; });

		// Click to select
		el.addEventListener("click", (e) => {
			e.stopPropagation();
			if (e.shiftKey) {
				// Multi-select
				if (selectedDetections.has(detId)) selectedDetections.delete(detId);
				else selectedDetections.add(detId);
			} else {
				// Single select
				if (selectedDetections.has(detId) && selectedDetections.size === 1) {
					selectedDetections.clear();
				} else {
					selectedDetections.clear();
					selectedDetections.add(detId);
				}
			}
			updateSelectionToolbar();
			renderOverlay();
		});

		// Right-click context menu
		el.addEventListener("contextmenu", (e) => {
			e.preventDefault();
			e.stopPropagation();
			if (!selectedDetections.has(detId)) {
				selectedDetections.clear();
				selectedDetections.add(detId);
				updateSelectionToolbar();
				renderOverlay();
			}
			showContextMenu(e.clientX, e.clientY, detId);
		});
	}

	// Click on viewer background = deselect all
	document.getElementById("viewer-container").addEventListener("click", (e) => {
		if (e.target === displayImage || e.target === overlaySvg) {
			selectedDetections.clear();
			updateSelectionToolbar();
			renderOverlay();
		}
	});

	// ======================= SELECTION TOOLBAR =======================
	function updateSelectionToolbar() {
		if (selectedDetections.size > 0) {
			selectionToolbar.style.display = "flex";
			selectionCount.textContent = `${selectedDetections.size} seleccionada${selectedDetections.size > 1 ? "s" : ""}`;
			updateReassignDropdown();
		} else {
			selectionToolbar.style.display = "none";
		}
	}

	function updateReassignDropdown() {
		reassignSelect.innerHTML = '<option value="">Mover a clase...</option>';
		classRegistry.forEach(cls => {
			const opt = document.createElement("option");
			opt.value = cls.key;
			opt.textContent = cls.name;
			reassignSelect.appendChild(opt);
		});
	}

	deleteSelectedBtn.addEventListener("click", () => { deleteSelectedDetections(); });
	deselectBtn.addEventListener("click", () => {
		selectedDetections.clear();
		updateSelectionToolbar();
		renderOverlay();
	});

	reassignSelect.addEventListener("change", () => {
		const targetKey = reassignSelect.value;
		if (!targetKey || !activeImageKey) return;
		reassignDetections(targetKey);
		reassignSelect.value = "";
	});

	// Keyboard shortcuts
	document.addEventListener("keydown", (e) => {
		if (e.key === "Delete" || e.key === "Backspace") {
			if (selectedDetections.size > 0 && document.activeElement.tagName !== "INPUT") {
				e.preventDefault();
				deleteSelectedDetections();
			}
		}
		if (e.key === "Escape") {
			selectedDetections.clear();
			updateSelectionToolbar();
			renderOverlay();
			contextMenu.style.display = "none";
		}
		// Ctrl+A = select all visible
		if (e.key === "a" && (e.ctrlKey || e.metaKey) && document.activeElement.tagName !== "INPUT") {
			e.preventDefault();
			selectAllVisible();
		}
	});

	function selectAllVisible() {
		if (!activeImageKey) return;
		const data = imageStore.get(activeImageKey);
		if (!data) return;
		const threshold = parseFloat(thresholdSlider.value);
		selectedDetections.clear();
		data.groups.forEach(group => {
			if (hiddenCategories.has(group.key)) return;
			group.detections.forEach((det, idx) => {
				if (det.score >= threshold && !det._deleted) {
					selectedDetections.add(`${group.key}:${idx}`);
				}
			});
		});
		updateSelectionToolbar();
		renderOverlay();
	}

	// ======================= DETECTION OPERATIONS =======================
	function deleteSelectedDetections() {
		if (!activeImageKey || selectedDetections.size === 0) return;
		const data = imageStore.get(activeImageKey);
		if (!data) return;

		selectedDetections.forEach(detId => {
			const [groupKey, detIdx] = parseDetId(detId);
			const group = data.groups.find(g => g.key === groupKey);
			if (group && group.detections[detIdx]) {
				group.detections[detIdx]._deleted = true;
			}
		});

		selectedDetections.clear();
		updateSelectionToolbar();
		renderOverlay();
		renderGallery();
		updateClassesList();
		updateExportStats();
	}

	function reassignDetections(targetKey) {
		if (!activeImageKey || selectedDetections.size === 0) return;
		const data = imageStore.get(activeImageKey);
		if (!data) return;

		const targetGroup = data.groups.find(g => g.key === targetKey);
		if (!targetGroup) {
			// Create new group if doesn't exist for this image
			const cls = classRegistry.find(c => c.key === targetKey);
			if (!cls) return;
			const newGroup = { key: targetKey, prompt: "", label: cls.name, color: cls.color, detections: [], count: 0 };
			data.groups.push(newGroup);
			reassignDetections(targetKey); // Retry
			return;
		}

		const detsToMove = [];
		selectedDetections.forEach(detId => {
			const [groupKey, detIdx] = parseDetId(detId);
			if (groupKey === targetKey) return; // Already in target
			const group = data.groups.find(g => g.key === groupKey);
			if (group && group.detections[detIdx] && !group.detections[detIdx]._deleted) {
				detsToMove.push({ fromGroup: group, det: { ...group.detections[detIdx] }, detIdx });
			}
		});

		// Move detections
		detsToMove.forEach(({ fromGroup, det, detIdx }) => {
			fromGroup.detections[detIdx]._deleted = true;
			delete det._deleted;
			targetGroup.detections.push(det);
		});

		selectedDetections.clear();
		updateSelectionToolbar();
		renderOverlay();
		updateClassesList();
		updateExportStats();
	}

	function parseDetId(detId) {
		const lastColon = detId.lastIndexOf(":");
		return [detId.substring(0, lastColon), parseInt(detId.substring(lastColon + 1))];
	}

	// ======================= CONTEXT MENU =======================
	let contextDetId = null;

	function showContextMenu(x, y, detId) {
		contextDetId = detId;
		const [groupKey] = parseDetId(detId);
		const cls = classRegistry.find(c => c.key === groupKey);

		ctxHeader.textContent = cls ? cls.name : "Detección";
		ctxHeader.style.color = cls ? cls.color : "var(--accent-cyan)";

		// Build class list for reassignment
		ctxClassList.innerHTML = "";
		classRegistry.forEach(c => {
			if (c.key === groupKey) return; // Don't show current class
			const item = document.createElement("div");
			item.className = "ctx-class-item";
			item.innerHTML = `<span class="ctx-class-swatch" style="background:${c.color}"></span>${c.name}`;
			item.addEventListener("click", () => {
				// Move selected detections to this class
				if (!selectedDetections.has(detId)) {
					selectedDetections.clear();
					selectedDetections.add(detId);
				}
				reassignDetections(c.key);
				contextMenu.style.display = "none";
			});
			ctxClassList.appendChild(item);
		});

		contextMenu.style.left = `${x}px`;
		contextMenu.style.top = `${y}px`;
		contextMenu.style.display = "block";
	}

	ctxDelete.addEventListener("click", () => {
		if (contextDetId && !selectedDetections.has(contextDetId)) {
			selectedDetections.add(contextDetId);
		}
		deleteSelectedDetections();
		contextMenu.style.display = "none";
	});

	document.addEventListener("click", () => { contextMenu.style.display = "none"; });

	// ======================= CLASSES TAB =======================
	function updateClassesList() {
		classesList.innerHTML = "";
		if (classRegistry.length === 0) {
			classesList.innerHTML = '<p class="empty-hint">Segmenta una imagen para ver las clases.</p>';
			return;
		}

		const threshold = parseFloat(thresholdSlider.value);

		classRegistry.forEach(cls => {
			// Count total annotations across all images
			let totalCount = 0;
			imageStore.forEach(data => {
				const group = data.groups.find(g => g.key === cls.key);
				if (group) {
					totalCount += group.detections.filter(d => d.score >= threshold && !d._deleted).length;
				}
			});

			const isHidden = hiddenCategories.has(cls.key);
			const item = document.createElement("div");
			item.className = `class-item ${isHidden ? "hidden" : ""}`;
			item.innerHTML = `
				<span class="class-swatch" style="background:${cls.color}" title="Click para cambiar color"></span>
				<input class="class-name" type="text" value="${cls.name}" data-key="${cls.key}" />
				<span class="class-count">${totalCount}</span>
				<button class="class-toggle" title="${isHidden ? "Mostrar" : "Ocultar"}">${isHidden ? "👁️‍🗨️" : "👁️"}</button>
				<button class="class-delete" title="Eliminar clase">✕</button>
			`;

			// Rename class
			const nameInput = item.querySelector(".class-name");
			nameInput.addEventListener("change", (e) => {
				cls.name = e.target.value.trim() || cls.name;
				// Update group labels in all images
				imageStore.forEach(data => {
					const group = data.groups.find(g => g.key === cls.key);
					if (group) group.label = cls.name;
				});
				renderOverlay();
			});

			// Toggle visibility
			item.querySelector(".class-toggle").addEventListener("click", (e) => {
				e.stopPropagation();
				if (hiddenCategories.has(cls.key)) hiddenCategories.delete(cls.key);
				else hiddenCategories.add(cls.key);
				updateClassesList();
				renderOverlay();
			});

			// Delete class
			item.querySelector(".class-delete").addEventListener("click", (e) => {
				e.stopPropagation();
				if (!confirm(`¿Eliminar la clase "${cls.name}" y todas sus detecciones?`)) return;
				// Mark all detections as deleted
				imageStore.forEach(data => {
					const group = data.groups.find(g => g.key === cls.key);
					if (group) group.detections.forEach(d => d._deleted = true);
				});
				classRegistry = classRegistry.filter(c => c.key !== cls.key);
				hiddenCategories.delete(cls.key);
				updateClassesList();
				renderOverlay();
				renderGallery();
				updateExportStats();
			});

			// Color picker
			item.querySelector(".class-swatch").addEventListener("click", (e) => {
				e.stopPropagation();
				const colorInput = document.createElement("input");
				colorInput.type = "color";
				colorInput.value = cls.color;
				colorInput.style.position = "absolute";
				colorInput.style.opacity = "0";
				document.body.appendChild(colorInput);
				colorInput.addEventListener("input", (ev) => {
					cls.color = ev.target.value;
					imageStore.forEach(data => {
						const group = data.groups.find(g => g.key === cls.key);
						if (group) group.color = cls.color;
					});
					updateClassesList();
					renderOverlay();
				});
				colorInput.addEventListener("change", () => { document.body.removeChild(colorInput); });
				colorInput.click();
			});

			classesList.appendChild(item);
		});
	}

	// Add new class
	if (addClassBtn) {
		addClassBtn.addEventListener("click", () => {
			const text = newClassInput ? newClassInput.value.trim() : "";
			const className = text ? text : `Clase ${classRegistry.length + 1}`;
			const newKey = `clase_custom_${classIdCounter}`;
			const colors = ["#f472b6", "#a78bfa", "#34d399", "#fbbf24", "#60a5fa", "#fb923c", "#c084fc", "#2dd4bf"];
			const color = colors[classRegistry.length % colors.length];

			classRegistry.push({
				id: classIdCounter++,
				name: className,
				color: color,
				key: newKey,
			});

			if (newClassInput) newClassInput.value = "";
			updateClassesList();
			updateReassignDropdown();
			updateExportStats();
		});
	}

	// Interactive Click Mode (SAM 3)
	if (toggleClickMode) {
		toggleClickMode.addEventListener("click", () => {
			isClickMode = !isClickMode;
			if (isClickMode) {
				resetDrawMode();
				isClickMode = true;
				toggleClickMode.style.background = "#22c55e";
				toggleClickMode.textContent = "👆 Modo Click (ACTIVO)";
				displayImage.style.cursor = "crosshair";
			} else {
				toggleClickMode.style.background = "";
				toggleClickMode.textContent = "👆 Modo Click (SAM 3)";
				displayImage.style.cursor = "default";
			}
		});
	}

	// Interactive Manual Draw Polygon Mode
	if (toggleDrawMode) {
		toggleDrawMode.addEventListener("click", () => {
			isDrawMode = !isDrawMode;
			if (isDrawMode) {
				isClickMode = false;
				if (toggleClickMode) {
					toggleClickMode.style.background = "";
					toggleClickMode.textContent = "👆 Modo Click (SAM 3)";
				}
				toggleDrawMode.style.background = "#f59e0b";
				toggleDrawMode.style.color = "#000";
				toggleDrawMode.textContent = "✏️ Dibujando Polígono...";
				if (finishPolygonBtn) {
					finishPolygonBtn.style.display = "inline-block";
					finishPolygonBtn.textContent = "✓ Finalizar Polígono (0 pts)";
