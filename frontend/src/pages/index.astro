			statusIdle.style.display = "none";
			statusRunning.style.display = "flex";
			statusText.textContent = `🧬 Cargando células de la ontología '${ontName}'...`;

			try {
				const res = await fetch(`${API_URL}/ontology/${ontName}`);
				if (!res.ok) throw new Error("No se pudo cargar la ontología.");
				const ontData = await res.json();
				if (!ontData.structures || ontData.structures.length === 0) {
					alert("La ontología no contiene estructuras.");
					statusRunning.style.display = "none";
					statusIdle.style.display = "flex";
					return;
				}
				// Filter out top-level macro-containers to focus on fine-grained cellular subtypes
				const cellStructs = ontData.structures.filter(s => !["testis", "testicular_lobule", "seminiferous_tubule", "tubular_wall"].includes(s.key));
				classRegistry = cellStructs.map((s, idx) => ({
					id: idx + 1,
					key: s.key,
					name: s.label || s.name || s.key,
					prompt: s.prompt || s.name_en || s.name,
					color: s.color || getClassColor(s.key)
				}));
				classIdCounter = classRegistry.length + 1;
				updateClassesList();

				// Automatically suggest the key concepts in prompt inputs
				const suggestedPrompt = "large primary spermatocyte with voluminous nucleus, mature spermatozoon with elongated head in lumen, dome-shaped basal spermatogonia, round spermatid";
