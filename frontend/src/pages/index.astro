	.btn-outline { background: transparent; border: 1px solid var(--border-color); color: var(--text-muted); }
	.btn-outline:hover { border-color: var(--text-muted); color: var(--text-main); }

	.btn-action { width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.65rem 1rem; border: none; border-radius: 10px; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.15s; font-family: var(--font-family); margin-bottom: 0.5rem; }
	.btn-action:disabled { opacity: 0.35; cursor: not-allowed; }
	.btn-primary-action { background: linear-gradient(135deg, var(--primary), #7c3aed); color: white; }
	.btn-primary-action:hover:not(:disabled) { box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4); transform: translateY(-1px); }
	.btn-roboflow { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; }
	.btn-roboflow:hover:not(:disabled) { box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4); transform: translateY(-1px); }
	.btn-train { background: linear-gradient(135deg, var(--accent-green), #059669); color: white; }
	.btn-train:hover:not(:disabled) { box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4); transform: translateY(-1px); }

	.slider-header { display: flex; justify-content: space-between; align-items: center; }
	.slider-val { font-family: var(--font-title); font-weight: 700; color: var(--accent-cyan); font-size: 0.9rem; background: rgba(6, 182, 212, 0.1); padding: 0.1rem 0.4rem; border-radius: 6px; }
	.form-range { -webkit-appearance: none; width: 100%; height: 5px; border-radius: 9999px; background: rgba(255,255,255,0.1); outline: none; margin: 0.3rem 0; }
	.form-range::-webkit-slider-thumb { -webkit-appearance: none; width: 16px; height: 16px; border-radius: 50%; background: var(--accent-cyan); cursor: pointer; box-shadow: 0 0 8px var(--accent-cyan); }
	.range-info { font-size: 0.68rem; color: var(--text-muted); }

	/* Status */
	.status-area { padding: 0.6rem; background: rgba(255,255,255,0.02); border-radius: 8px; border: 1px solid var(--border-color); font-size: 0.8rem; color: var(--text-muted); margin-top: 0.75rem; }
	.status-idle, .status-running { display: flex; align-items: center; gap: 0.4rem; }
	.status-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
	.status-dot.idle { background: rgba(148, 163, 184, 0.5); }
	.status-dot.connected { background: var(--accent-green); box-shadow: 0 0 6px var(--accent-green); }
	.status-dot.error { background: var(--accent-red); }
	@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
	.spinner-small { width: 14px; height: 14px; border: 2px solid rgba(6, 182, 212, 0.3); border-radius: 50%; border-top-color: var(--accent-cyan); animation: spin 0.8s linear infinite; flex-shrink: 0; }
	@keyframes spin { to { transform: rotate(360deg); } }

	/* Classes tab */
	.classes-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
	.section-title-sm { font-family: var(--font-title); font-size: 0.95rem; font-weight: 600; }
	.classes-list { display: flex; flex-direction: column; gap: 0.35rem; }
	.class-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.45rem 0.6rem; border-radius: 8px; background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); transition: all 0.15s; cursor: pointer; }
	.class-item:hover { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.12); }
	.class-item.hidden { opacity: 0.3; }
	.class-swatch { width: 14px; height: 14px; border-radius: 4px; flex-shrink: 0; cursor: pointer; }
	.class-name { flex-grow: 1; font-size: 0.82rem; color: var(--text-main); background: none; border: none; outline: none; font-family: var(--font-family); cursor: text; padding: 0.1rem 0; }
	.class-name:focus { border-bottom: 1px solid var(--accent-cyan); }
	.class-count { font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-title); font-weight: 600; min-width: 20px; text-align: right; }
	.class-toggle { background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 0.75rem; padding: 0.2rem; transition: color 0.15s; }
	.class-toggle:hover { color: var(--text-main); }
	.class-delete { background: none; border: none; color: rgba(244, 63, 94, 0.5); cursor: pointer; font-size: 0.8rem; padding: 0.2rem; transition: color 0.15s; }
	.class-delete:hover { color: var(--accent-red); }
	.class-actions { margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--border-color); display: flex; gap: 0.5rem; }
	.empty-hint { font-size: 0.8rem; color: var(--text-muted); font-style: italic; padding: 1rem 0; text-align: center; }

	/* Export tab */
	.export-section { display: flex; flex-direction: column; gap: 0.75rem; }
	.export-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin-bottom: 0.5rem; }
	.stat-item { text-align: center; padding: 0.6rem; background: rgba(255,255,255,0.02); border-radius: 8px; border: 1px solid var(--border-color); }
	.stat-value { display: block; font-family: var(--font-title); font-weight: 700; font-size: 1.4rem; color: var(--accent-cyan); }
	.stat-label { font-size: 0.7rem; color: var(--text-muted); }
	.divider { height: 1px; background: var(--border-color); margin: 0.5rem 0; }
	.roboflow-status { display: flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.5rem; }
