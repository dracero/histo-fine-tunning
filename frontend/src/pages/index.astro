	/* Export tab */
	.export-section { display: flex; flex-direction: column; gap: 0.75rem; }
	.export-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin-bottom: 0.5rem; }
	.stat-item { text-align: center; padding: 0.6rem; background: rgba(255,255,255,0.02); border-radius: 8px; border: 1px solid var(--border-color); }
	.stat-value { display: block; font-family: var(--font-title); font-weight: 700; font-size: 1.4rem; color: var(--accent-cyan); }
	.stat-label { font-size: 0.7rem; color: var(--text-muted); }
