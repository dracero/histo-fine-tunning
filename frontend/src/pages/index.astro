	async function executeTissuePipeline(targetKey = null) {
		const key = targetKey || activeImageKey;
		if (!key) {
			alert("Por favor selecciona o sube una imagen histológica primero.");
			return;
		}

		const data = imageStore.get(key);
		if (!data) return;

		statusIdle.style.display = "none";
		statusRunning.style.display = "flex";

		const cpModel = currentCellposeModel || "cpsam";
		statusText.textContent = `🧬 [1/3] Gemini Vision analizando macro & micro ontología espacial en ${data.filename}...`;

		try {
			const formData = new FormData();
			formData.append("image", data.file);
			formData.append("cellpose_model", cpModel);
			formData.append("confidence_threshold", thresholdSlider ? thresholdSlider.value : "0.50");
			formData.append("include_macro_layers", "true");
			formData.append("use_gemini_validation", "true");
			if (window._activeOntologyName) {
				formData.append("ontology_name", window._activeOntologyName);
			}

			// Call backend unified pipeline
			const response = await fetch(`${API_URL}/tissue/analyze-pipeline`, {
				method: "POST",
				body: formData
			});

			if (!response.ok) {
				const err = await response.json().catch(() => ({}));
				throw new Error(err.detail || `Error HTTP ${response.status}`);
			}

			const result = await response.json();

			data.groups = result.groups || [];
			data.width = result.width || data.width;
			data.height = result.height || data.height;
			data.annotated = true;

			// Register discovered classes in classRegistry
			for (const group of data.groups) {
				if (!classRegistry.find(c => c.key === group.key)) {
					classRegistry.push({
						id: classIdCounter++,
						name: group.label,
						color: group.color,
						key: group.key,
					});
				}
			}

			renderGallery();
			updateExportStats();

			if (key === activeImageKey) {
				viewerControls.style.display = "flex";
				selectedDetections.clear();
				updateSelectionToolbar();
				renderOverlay();
				updateClassesList();
			}

			// Pipeline completado

			statusText.textContent = `✅ Pipeline Integral completado: ${result.macro_layers_count || 0} macro-compartimentos y ${result.cells_count || 0} células etiquetadas con precisión.`;
			setTimeout(() => {
				statusRunning.style.display = "none";
				statusIdle.style.display = "flex";
			}, 4500);

		} catch (error) {
			console.error(`Error en Pipeline Integral:`, error);
			alert(`⚠️ Error en Pipeline Integral: ${error.message}`);
			statusRunning.style.display = "none";
			statusIdle.style.display = "flex";
		}
	}
