	.form-input { flex-grow: 1; background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); color: var(--text-main); border-radius: 8px; padding: 0.45rem 0.65rem; font-size: 0.8rem; font-family: var(--font-family); outline: none; transition: all 0.15s; }
	.form-input:focus { border-color: var(--primary); box-shadow: 0 0 0 2px var(--primary-glow); }
	.form-input-sm { background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); color: var(--text-main); border-radius: 6px; padding: 0.3rem 0.5rem; font-size: 0.75rem; font-family: var(--font-family); outline: none; }

	/* Buttons */
	.btn-small { background: var(--primary); color: #fff; border: none; border-radius: 6px; padding: 0.4rem 0.7rem; font-size: 0.75rem; font-weight: 600; cursor: pointer; white-space: nowrap; transition: all 0.15s; font-family: var(--font-family); }
	.btn-small:hover { background: var(--primary-hover); }
