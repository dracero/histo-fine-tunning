</style>

<script>
	const hostname = typeof window !== "undefined" && window.location.hostname ? window.location.hostname : "127.0.0.1";
	const API_URL = `http://${hostname}:8000/api`;

	// ======================= STATE =======================
	// Multi-image state
	let imageStore = new Map();  // filename -> { file, dataUrl, width, height, groups, annotated }
	let activeImageKey = null;

	// Detection editing state
	let selectedDetections = new Set();  // "groupKey:detIndex" identifiers

	// Interactive mode states: null | 'box' | 'click' | 'polygon' | 'eraser'
	let activeInteractiveTool = null;
	let currentPolygonPoints = [];
	let isDraggingBox = false;
	let startBoxX = 0;
	let startBoxY = 0;

	// Global class registry (shared across images)
	// { id, name, color, key }
	let classRegistry = [];
	let classIdCounter = 1;

	// Hidden categories
	let hiddenCategories = new Set();
	let _ontologiesLoaded = false;

	// ======================= DOM =======================
	const dropZone = document.getElementById("drop-zone");
	const fileInput = document.getElementById("file-input");
	const uploadContent = document.getElementById("upload-content");
	const imageGallery = document.getElementById("image-gallery");

	const thresholdSlider = document.getElementById("threshold-slider");
	const thresholdVal = document.getElementById("threshold-val");

	const statusIdle = document.getElementById("status-idle");
	const statusRunning = document.getElementById("status-running");
	const statusText = document.getElementById("status-text");

	const emptyViewer = document.getElementById("empty-viewer");
	const imageViewport = document.getElementById("image-viewport");
	const displayImage = document.getElementById("display-image");
	const overlaySvg = document.getElementById("overlay-svg");
	const detectionsCounter = document.getElementById("detections-counter");
	const viewerControls = document.getElementById("viewer-controls");
	const togglePolygons = document.getElementById("toggle-polygons");
	const toggleBoxes = document.getElementById("toggle-boxes");
	const toggleLabels = document.getElementById("toggle-labels");

	const viewerFilterAll = document.getElementById("viewer-filter-all");
	const viewerFilterMacro = document.getElementById("viewer-filter-macro");
	const viewerFilterMicro = document.getElementById("viewer-filter-micro");
	const viewerSegmentMacroBtn = document.getElementById("viewer-segment-macro-btn");
	const studentQuickMacroBtn = document.getElementById("student-quick-macro-btn");
	let currentViewerScaleFilter = "all"; // "all" | "macro" | "micro"

	const selectionToolbar = document.getElementById("selection-toolbar");
	const selectionCount = document.getElementById("selection-count");
	const reassignSelect = document.getElementById("reassign-select");
	const deleteSelectedBtn = document.getElementById("delete-selected-btn");
	const deselectBtn = document.getElementById("deselect-btn");

	const tooltip = document.getElementById("box-tooltip");
	const tooltipCategory = document.getElementById("tooltip-category");
	const tooltipScore = document.getElementById("tooltip-score-val");
	const tooltipCoords = document.getElementById("tooltip-coords-val");
	const tooltipReason = document.getElementById("tooltip-reason-val");

	const contextMenu = document.getElementById("context-menu");
	const ctxHeader = document.getElementById("ctx-header");
	const ctxDelete = document.getElementById("ctx-delete");
	const ctxClassList = document.getElementById("ctx-class-list");

	const classesList = document.getElementById("classes-list");
	const addClassBtn = document.getElementById("add-class-btn");
	const toolBoxMode = document.getElementById("tool-box-mode");
	const toolClickMode = document.getElementById("tool-click-mode");
	const toolDrawMode = document.getElementById("tool-draw-mode");
	const finishPolygonBtn = document.getElementById("finish-polygon-btn");
	const toolEraserMode = document.getElementById("tool-eraser-mode");
	const correctionClassSelect = document.getElementById("correction-class-select");
	const activeToolStatus = document.getElementById("active-tool-status");

	const exportCocoBtn = document.getElementById("export-coco-btn");
	const progressArea = document.getElementById("rf-log-area") || document.getElementById("progress-area");
	const progressFill = document.getElementById("progress-fill");
	const progressTextEl = document.getElementById("rf-log-content") || document.getElementById("progress-text");

	// ======================= TABS =======================
	function switchTab(tabId) {
		if (!tabId) return;
		document.querySelectorAll(".tab-btn").forEach(btn => {
			btn.classList.toggle("active", btn.dataset.tab === tabId);
		});
		document.querySelectorAll(".tab-content").forEach(c => {
			c.classList.toggle("active", c.id === tabId);
		});
		if (tabId === "pdf-tab") {
			loadSavedOntologies(true);
		}
		if (tabId === "student-quiz-tab") {
			// Auto deactivate any drawing/clicking tools so user can inspect and select cells directly
			if (typeof setActiveInteractiveTool === "function") {
				setActiveInteractiveTool(null);
			}
			if (selectedDetections && selectedDetections.size === 1) {
				const [firstId] = selectedDetections;
				if (typeof onDetectionSelectedForStudent === "function") {
					onDetectionSelectedForStudent(firstId);
				}
			}
		}
	}

	document.querySelectorAll(".tab-btn").forEach(btn => {
		btn.addEventListener("click", () => {
			switchTab(btn.dataset.tab);
		});
	});

	// ======================= FILE UPLOAD =======================
	["dragenter", "dragover"].forEach(ev => {
		dropZone.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.add("dragover"); }, false);
	});
	["dragleave", "drop"].forEach(ev => {
		dropZone.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.remove("dragover"); }, false);
	});

	dropZone.addEventListener("drop", (e) => {
		if (e.dataTransfer.files.length > 0) handleFiles(Array.from(e.dataTransfer.files));
	});
	fileInput.addEventListener("change", () => {
		if (fileInput.files.length > 0) handleFiles(Array.from(fileInput.files));
	});

	async function handleFiles(files, autoSegment = false) {
		const pdfFiles = files.filter(f => f.name.toLowerCase().endsWith(".pdf") || f.type === "application/pdf");
		if (pdfFiles.length > 0) {
			switchTab("pdf-tab");
			handlePdfUpload(pdfFiles[0]);
			return;
		}

		const imageFiles = files.filter(f => f.type.startsWith("image/") || /\.(png|jpe?g|webp|bmp|tiff?)$/i.test(f.name));
		if (imageFiles.length === 0) { alert("Selecciona archivos de imagen o un PDF."); return; }

		const addedKeys = [];
		for (const file of imageFiles) {
			const key = file.name + "_" + Date.now() + "_" + Math.random().toString(36).substr(2, 5);
			const dataUrl = await readFileAsDataUrl(file);
			const dims = await getImageDimensions(dataUrl);

			imageStore.set(key, {
				file: file,
				filename: file.name,
				dataUrl: dataUrl,
				width: dims.width || 800,
				height: dims.height || 600,
				groups: [],
				annotated: false,
			});
			addedKeys.push(key);
		}

		renderGallery();
		if (addedKeys.length > 0) {
			selectImage(addedKeys[0]);
		}

		if (autoSegment) {
			for (const key of addedKeys) {
				selectImage(key);
				await runSam3Segmentation(key);
			}
		}

		if (fileInput) fileInput.value = "";
	}

	function readFileAsDataUrl(file) {
		return new Promise((resolve) => {
			const reader = new FileReader();
			reader.onload = (e) => resolve(e.target.result);
			reader.onerror = (err) => {
				console.warn("FileReader error, returning empty dataUrl:", err);
				resolve("");
			};
			reader.readAsDataURL(file);
		});
	}

	function getImageDimensions(dataUrl) {
		return new Promise((resolve) => {
			if (!dataUrl) return resolve({ width: 800, height: 600 });
			const img = new Image();
			img.onload = () => resolve({ width: img.naturalWidth || img.width || 800, height: img.naturalHeight || img.height || 600 });
			img.onerror = () => {
				console.warn("Could not decode image dimensions, fallback to 800x600");
				resolve({ width: 800, height: 600 });
			};
			img.src = dataUrl;
		});
	}

	// ======================= IMAGE GALLERY =======================
	function renderGallery() {
		imageGallery.innerHTML = "";
		imageStore.forEach((data, key) => {
			const thumb = document.createElement("div");
			thumb.className = `gallery-thumb ${key === activeImageKey ? "active" : ""}`;
			thumb.dataset.key = key;

			const detCount = countDetections(data);
			thumb.innerHTML = `
				<img src="${data.dataUrl}" alt="${data.filename}" />
				<span class="thumb-badge ${data.annotated ? "annotated" : "pending"}"></span>
				<button class="thumb-remove" title="Quitar imagen">✕</button>
				${detCount > 0 ? `<span class="thumb-count">${detCount}</span>` : ""}
			`;

			thumb.addEventListener("click", (e) => {
				if (e.target.classList.contains("thumb-remove")) {
					e.stopPropagation();
					removeImage(key);
					return;
				}
				selectImage(key);
			});

			imageGallery.appendChild(thumb);
		});
	}

	function removeImage(key) {
		imageStore.delete(key);
		if (activeImageKey === key) {
			activeImageKey = null;
			const first = imageStore.keys().next().value;
			if (first) selectImage(first);
			else resetViewer();
		}
		renderGallery();
		updateExportStats();
	}

	function selectImage(key) {
		activeImageKey = key;
		const data = imageStore.get(key);
		if (!data) return;

		displayImage.src = data.dataUrl;
		emptyViewer.style.display = "none";
		imageViewport.style.display = "flex";

		selectedDetections.clear();
		updateSelectionToolbar();
		renderOverlay();
		renderGallery();
		updateClassesList();
		updateExportStats();

		if (data.groups.length > 0) {
			viewerControls.style.display = "flex";
		} else {
			viewerControls.style.display = "none";
		}
	}

	function resetViewer() {
		emptyViewer.style.display = "flex";
		imageViewport.style.display = "none";
		viewerControls.style.display = "none";
		overlaySvg.innerHTML = "";
		statusRunning.style.display = "none";
		statusIdle.style.display = "flex";
	}

	function countDetections(data) {
		const threshold = parseFloat(thresholdSlider.value);
		let count = 0;
		(data.groups || []).forEach(g => {
			count += g.detections.filter(d => d.score >= threshold).length;
		});
		return count;
	}

