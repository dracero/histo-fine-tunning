	quickSegmentMicroBtn?.addEventListener("click", () => {
		setStructureScale("micro");
		runAutoSegmentation();
	});
	quickSegmentMacroBtn?.addEventListener("click", () => {
		setStructureScale("macro");
		segmentMacrostructures();
	});

	// Draw crop on canvas for selected detection
	function renderStudentCrop(det) {
		if (!studentCropCanvas || !displayImage || !displayImage.complete) return;
		const ctx = studentCropCanvas.getContext("2d");
		if (!ctx) return;

		ctx.clearRect(0, 0, studentCropCanvas.width, studentCropCanvas.height);

		const bbox = det.box || (det.bbox ? [det.bbox[0], det.bbox[1], det.bbox[0] + det.bbox[2], det.bbox[1] + det.bbox[3]] : [0,0,50,50]);
		const [x1, y1, x2, y2] = bbox;
		const bw = Math.max(10, x2 - x1);
		const bh = Math.max(10, y2 - y1);

		// Context margin
		const pad = Math.max(15, Math.floor(Math.max(bw, bh) * 0.35));
		const sx = Math.max(0, x1 - pad);
		const sy = Math.max(0, y1 - pad);
		const sw = Math.min(displayImage.naturalWidth - sx, bw + pad * 2);
		const sh = Math.min(displayImage.naturalHeight - sy, bh + pad * 2);

		try {
			ctx.drawImage(displayImage, sx, sy, sw, sh, 0, 0, studentCropCanvas.width, studentCropCanvas.height);
			// Draw focus border
			ctx.strokeStyle = det.scale === "macro" ? "#3b82f6" : "#06b6d4";
			ctx.lineWidth = 2;
			ctx.strokeRect(2, 2, studentCropCanvas.width - 4, studentCropCanvas.height - 4);
		} catch (err) {
			console.debug("Could not render crop preview canvas:", err);
		}
	}

	// Function invoked when a detection is selected
	function onDetectionSelectedForStudent(detId) {
		_studentActiveDetId = detId;
		if (!detId) {
			if (studentNoSelection) studentNoSelection.style.display = "block";
			if (studentActiveChallenge) studentActiveChallenge.style.display = "none";
			if (studentResultCard) studentResultCard.style.display = "none";
			return;
		}

		const mapEntry = findDetectionById(detId);
		if (!mapEntry || !mapEntry.det) {
			if (studentNoSelection) studentNoSelection.style.display = "block";
			if (studentActiveChallenge) studentActiveChallenge.style.display = "none";
			return;
		}

		const det = mapEntry.det;
		const detScale = (det.scale === "macro" || det.is_macro) ? "macro" : "micro";

		if (studentNoSelection) studentNoSelection.style.display = "none";
		if (studentActiveChallenge) studentActiveChallenge.style.display = "block";

		if (studentStructIdText) {
			studentStructIdText.textContent = `Estructura #${mapEntry.detIndex + 1} (${detScale.toUpperCase()})`;
		}

		setStudentChallengeScale(detScale);

		if (studentNotesInput) {
			studentNotesInput.value = "";
		}

		// Draw preview crop
		renderStudentCrop(det);

		// If this detection was already validated by Gemini, show its correction card immediately!
		if (det.gemini_validated) {
			if (studentChoiceInput) {
				studentChoiceInput.value = det.student_choice || det.label || "";
			}
			renderValidationResult({
				status: det.gemini_status,
				score: det.gemini_score,
				probabilidad_eleccion_correcta: det.gemini_eval_probability !== undefined ? det.gemini_eval_probability : (det.gemini_score ? det.gemini_score / 100 : 0.9),
				porcentaje_probabilidad: det.gemini_eval_probability !== undefined ? Math.round(det.gemini_eval_probability * 100) : (det.gemini_score || 85),
				calidad_segmentacion: det.gemini_quality || 0.9,
				evaluacion_delimitacion: det.gemini_delimitacion || "Límites celulares definidos adecuadamente.",
				verdict_title: det.gemini_verdict_title || (det.gemini_status === "correct" || det.gemini_status === "correcta" ? "¡Diagnóstico Exacto! 🎯" : "Revisión Requerida 💡"),
				actual_structure: det.gemini_structure || det.label,
				didactic_feedback: det.gemini_feedback || "Validación previamente realizada por Gemini.",
				morphological_hallmarks: det.gemini_hallmarks || [],
				differential_diagnosis: det.gemini_differential || "",
				study_tip: det.gemini_study_tip || "",
				model_used: det.gemini_model || "Gemini 3.8 / 3.5",
			}, det, det.student_choice || det.label, false);
		} else {
			if (studentResultCard) studentResultCard.style.display = "none";
			if (studentChoiceInput) {
				studentChoiceInput.value = det.label || "";
			}
		}
	}
	window.onDetectionSelectedForStudent = onDetectionSelectedForStudent;

	// Submit Student Choice or Direct Consultation to Gemini 3.5 / 3.8 for Evaluation
	async function validateStudentSelection(isDirectConsult = false) {
		console.log("validateStudentSelection triggered", { _studentActiveDetId, isDirectConsult });
		if (!_studentActiveDetId) {
			alert("⚠️ Selecciona primero una estructura en el visor haciendo clic sobre ella.");
			return;
		}

		const mapEntry = findDetectionById(_studentActiveDetId);
		if (!mapEntry || !mapEntry.det) {
			alert("⚠️ No se encontró la estructura seleccionada.");
			return;
		}

		const det = mapEntry.det;
		const defaultLabel = det.label || mapEntry.group?.name || (typeof getClassName === "function" ? getClassName(mapEntry.groupKey) : "") || "Estructura";
		let studentChoice = studentChoiceInput ? studentChoiceInput.value.trim() : "";
		if (isDirectConsult) {
			studentChoice = "Consulta y corrección docente directa";
		} else if (!studentChoice) {
			studentChoice = defaultLabel;
			if (studentChoiceInput) studentChoiceInput.value = studentChoice;
		}

		const studentNotes = studentNotesInput ? studentNotesInput.value.trim() : "";
		const detScale = det.scale || (typeof currentStructureScale !== "undefined" ? currentStructureScale : "micro") || "micro";

		if ((!activeImageKey || !imageStore.get(activeImageKey)) && imageStore.size > 0) {
			const firstKey = imageStore.keys().next().value;
			if (firstKey) selectImage(firstKey);
		}

		if (!activeImageKey || !imageStore.get(activeImageKey)) {
			alert("⚠️ No hay imagen activa cargada en el visor.");
			return;
		}

		const originalBtnText = studentValidateBtn ? studentValidateBtn.innerHTML : "";
		if (studentValidateBtn) {
			studentValidateBtn.disabled = true;
			studentValidateBtn.innerHTML = `⏳ Gemini evaluando...`;
		}
		if (statusRunning) statusRunning.style.display = "flex";
		if (statusIdle) statusIdle.style.display = "none";
		if (statusText) statusText.textContent = `🎓 Gemini 3.8 / 3.5 analizando corte histológico y calculando probabilidad de '${studentChoice}'...`;

		try {
			const imgData = imageStore.get(activeImageKey);
			const formData = new FormData();
			if (imgData.file) {
				formData.append("image", imgData.file, imgData.filename || "image.png");
			} else if (imgData.dataUrl) {
				const resBlob = await fetch(imgData.dataUrl);
				const blob = await resBlob.blob();
				formData.append("image", blob, imgData.filename || "image.png");
			} else {
				throw new Error("No se pudo obtener el archivo binario de la imagen.");
			}
			formData.append("structure_choice", studentChoice);
			formData.append("student_choice", studentChoice);
			formData.append("structure_scale", detScale);
			formData.append("preferred_model", "gemini-3.8-flash");

			const bbox = det.box || (det.bbox ? [det.bbox[0], det.bbox[1], det.bbox[0] + det.bbox[2], det.bbox[1] + det.bbox[3]] : [0,0,50,50]);
			formData.append("bbox", JSON.stringify(bbox));

			if (det.segmentation) {
				formData.append("polygon", JSON.stringify(det.segmentation));
			}
			if (studentNotes) {
				formData.append("student_notes", studentNotes);
			}
			if (window._activeOntologyName) {
				formData.append("organ_context", window._activeOntologyName);
			}

			let res = await fetch(`${API_URL}/evaluate-segmentations-gemini`, {
				method: "POST",
				body: formData,
			});

			if (!res.ok) {
				res = await fetch(`${API_URL}/student/validate-structure`, {
					method: "POST",
					body: formData,
				});
			}

			if (!res.ok) {
				const err = await res.json().catch(() => ({}));
				throw new Error(err.detail || `HTTP ${res.status}`);
			}

			const validation = await res.json();
			renderValidationResult(validation, det, studentChoice, true);

		} catch (err) {
			console.error("Validation error:", err);
			alert(`Error al evaluar con Gemini: ${err.message}`);
		} finally {
			if (studentValidateBtn) {
				studentValidateBtn.disabled = false;
				studentValidateBtn.innerHTML = originalBtnText;
			}
			if (statusRunning) statusRunning.style.display = "none";
			if (statusIdle) statusIdle.style.display = "flex";
		}
	}

	function renderValidationResult(val, det, studentChoice, updateStats = true) {
		if (!studentResultCard || !studentResultContent) return;

		const probPct = val.porcentaje_probabilidad !== undefined 
			? val.porcentaje_probabilidad 
			: (val.probabilidad_eleccion_correcta !== undefined ? Math.round(val.probabilidad_eleccion_correcta * 100) : (val.score !== undefined ? val.score : 85));
		const isCorrect = val.status === "correct" || val.estado === "correcta" || probPct >= 80;
		const isPartial = val.status === "partially_correct" || val.estado === "parcialmente_correcta" || (probPct >= 50 && probPct < 80);
		const statusColor = isCorrect ? "#10b981" : (isPartial ? "#f59e0b" : "#ef4444");
		const badgeIcon = isCorrect ? "🎯" : (isPartial ? "⚠️" : "❌");

		// Persist on det so it displays on the canvas overlay
		if (det) {
			det.gemini_validated = true;
			det.gemini_status = isCorrect ? "correct" : (isPartial ? "partially_correct" : "incorrect");
			det.gemini_structure = val.actual_structure || val.diagnostico_verdadero;
			det.gemini_score = probPct;
			det.gemini_eval_probability = probPct / 100;
			det.gemini_quality = val.calidad_segmentacion || 0.90;
			det.gemini_delimitacion = val.evaluacion_delimitacion || "";
			det.gemini_feedback = val.didactic_feedback || val.justificacion;
			det.gemini_hallmarks = val.morphological_hallmarks || val.criterios_morfologicos || [];
			det.gemini_differential = val.differential_diagnosis || val.diagnostico_diferencial || "";
			det.gemini_study_tip = val.study_tip || val.recomendacion || "";
			det.gemini_verdict_title = val.verdict_title;
			det.student_choice = studentChoice;
			det.gemini_model = val.model_used || "Gemini 3.8 / 3.5";
		}

		// Update Stats & History only for new evaluations
		if (updateStats) {
			studentStats.total += 1;
			if (isCorrect) studentStats.correct += 1;
			else if (isPartial) studentStats.partial += 1;
			else studentStats.incorrect += 1;

			if (statCorrectCount) statCorrectCount.textContent = studentStats.correct.toString();
			if (statPartialCount) statPartialCount.textContent = studentStats.partial.toString();
			if (statIncorrectCount) statIncorrectCount.textContent = studentStats.incorrect.toString();
			if (studentScoreBadge) {
				const pct = Math.round((studentStats.correct / studentStats.total) * 100);
				studentScoreBadge.textContent = `${studentStats.correct}/${studentStats.total} (${pct}%)`;
			}

			// Store in history
			studentEvaluations.unshift({
				timestamp: new Date().toLocaleTimeString(),
				detId: _studentActiveDetId,
				studentChoice,
				actualStructure: val.actual_structure || val.diagnostico_verdadero,
				score: probPct,
				status: isCorrect ? "correct" : (isPartial ? "partially_correct" : "incorrect"),
				feedback: val.didactic_feedback || val.justificacion,
			});
			updateStudentHistoryUI();
		}

		studentResultCard.style.borderLeftColor = statusColor;
		studentResultCard.style.display = "block";

		const rawHallmarks = val.morphological_hallmarks || val.criterios_morfologicos || [];
		const hallmarksListHtml = rawHallmarks.map(h => `
			<li style="margin-bottom: 0.25rem;">${h}</li>
		`).join("");

		studentResultContent.innerHTML = `
			<!-- Probability Gauge Hero Badge -->
			<div style="background: rgba(2,132,199,0.12); border: 1px solid rgba(56,189,248,0.35); border-radius: 8px; padding: 0.65rem; margin-bottom: 0.55rem; text-align: center;">
				<div style="font-size: 0.68rem; color: #94a3b8; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.2rem;">
					Probabilidad de Elección Correcta (LLM)
				</div>
				<div style="font-size: 1.7rem; font-weight: 900; color: ${statusColor}; display: flex; align-items: center; justify-content: center; gap: 0.35rem;">
					<span>${badgeIcon}</span> ${probPct}%
				</div>
				<div style="background: rgba(255,255,255,0.1); border-radius: 9999px; height: 6px; width: 100%; margin: 0.4rem 0 0.2rem 0; overflow: hidden;">
					<div style="background: ${statusColor}; width: ${probPct}%; height: 100%; border-radius: 9999px; transition: width 0.5s ease;"></div>
				</div>
				<div style="font-size: 0.66rem; color: #94a3b8; display: flex; justify-content: space-between; margin-top: 0.3rem;">
					<span>Delimitación: <strong style="color: #e2e8f0;">${Math.round((val.calidad_segmentacion || 0.90) * 100)}%</strong></span>
					<span>Modelo: <strong style="color: #38bdf8;">${val.model_used || "Gemini 3.8 / 3.5"}</strong></span>
				</div>
			</div>

			<div style="background: rgba(255,255,255,0.03); border-radius: 6px; padding: 0.5rem; margin-bottom: 0.5rem; font-size: 0.73rem; border: 1px solid var(--border-color);">
				<div>Elección evaluada: <strong style="color: #f1f5f9;">${studentChoice}</strong></div>
				<div style="margin-top: 0.2rem;">Diagnóstico Verificado (Gemini): <strong style="color: ${statusColor};">${val.actual_structure || val.diagnostico_verdadero}</strong></div>
				${val.evaluacion_delimitacion ? `<div style="margin-top: 0.2rem; font-size: 0.68rem; color: #94a3b8;">Delimitación: ${val.evaluacion_delimitacion}</div>` : ''}
			</div>

			<div style="font-size: 0.72rem; color: #cbd5e1; line-height: 1.4; margin-bottom: 0.5rem;">
				<strong>Fundamentación Diagnóstica:</strong><br />
				${val.didactic_feedback || val.justificacion}
			</div>

			${hallmarksListHtml ? `
				<div style="font-size: 0.7rem; color: #94a3b8; margin-bottom: 0.5rem;">
					<strong style="color: #e2e8f0;">Criterios morfológicos observados:</strong>
					<ul style="margin: 0.25rem 0 0 1rem; padding: 0;">${hallmarksListHtml}</ul>
				</div>
			` : ""}

			${(val.differential_diagnosis || val.diagnostico_diferencial) ? `
				<div style="font-size: 0.7rem; color: #38bdf8; background: rgba(56,189,248,0.08); padding: 0.4rem; border-radius: 6px; margin-bottom: 0.4rem; line-height: 1.35;">
					<strong>Diagnóstico Diferencial:</strong> ${val.differential_diagnosis || val.diagnostico_diferencial}
				</div>
			` : ""}

			${(val.study_tip || val.recomendacion) ? `
				<div style="font-size: 0.7rem; color: #a78bfa; background: rgba(167,139,250,0.08); padding: 0.4rem; border-radius: 6px; line-height: 1.35;">
					💡 <strong>Recomendación / Consejo:</strong> ${val.study_tip || val.recomendacion}
				</div>
			` : ""}
		`;

		// Smooth scroll result into view so user sees feedback immediately
		studentResultCard.scrollIntoView({ behavior: "smooth", block: "nearest" });

		// Re-render SVG overlay so Gemini's badge is displayed on the cell
		renderOverlay();
	}

	function updateStudentHistoryUI() {
		if (!studentHistoryList) return;
		if (!studentEvaluations || studentEvaluations.length === 0) {
			studentHistoryList.innerHTML = `<p class="empty-hint" style="font-size: 0.72rem;">Aún no has validado estructuras en esta lámina.</p>`;
			return;
		}

		studentHistoryList.innerHTML = studentEvaluations.map((item, idx) => {
			const prob = item.score !== undefined ? item.score : 85;
			const color = prob >= 80 ? "#10b981" : (prob >= 50 ? "#f59e0b" : "#ef4444");
			const icon = prob >= 80 ? "🎯" : (prob >= 50 ? "⚠️" : "❌");
			const choiceText = item.studentChoice || "Estructura";
			const actualText = item.actualStructure || choiceText;

			return `
				<div class="student-history-item" data-det-id="${item.detId || ''}" style="display: flex; justify-content: space-between; align-items: center; padding: 0.4rem 0.5rem; margin-bottom: 0.35rem; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.72rem; cursor: pointer; transition: background 0.15s ease;">
					<div style="min-width: 0; flex: 1; margin-right: 0.5rem;">
						<div style="font-weight: 700; color: #e2e8f0; display: flex; align-items: center; gap: 0.3rem;">
							<span>${icon}</span>
							<span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${choiceText}</span>
						</div>
						<div style="font-size: 0.66rem; color: #94a3b8; margin-top: 0.1rem;">
							${actualText !== choiceText ? `Diagnóstico: <strong style="color: #38bdf8;">${actualText}</strong> · ` : ""}${item.timestamp || ""}
						</div>
					</div>
					<span class="badge" style="background: ${color}22; color: ${color}; font-weight: 800; font-size: 0.68rem; border: 1px solid ${color}44; flex-shrink: 0;">
						${prob}%
					</span>
				</div>
			`;
		}).join("");

		studentHistoryList.querySelectorAll(".student-history-item").forEach(el => {
			el.addEventListener("click", () => {
				const detId = el.getAttribute("data-det-id");
				if (detId) {
					onDetectionSelectedForStudent(detId);
				}
			});
		});
	}
	window.updateStudentHistoryUI = updateStudentHistoryUI;

	// Evaluate all annotations on the current slide with Gemini
	async function evaluateAnnotationsWithGemini() {
		console.log("evaluateAnnotationsWithGemini triggered", { activeImageKey, storeSize: imageStore.size });

		if ((!activeImageKey || !imageStore.get(activeImageKey)) && imageStore.size > 0) {
			const firstKey = imageStore.keys().next().value;
			if (firstKey) selectImage(firstKey);
		}

		if (!activeImageKey || !imageStore.get(activeImageKey)) {
			if (studentResultCard && studentResultContent) {
				studentResultCard.style.display = "block";
				studentResultCard.style.borderLeftColor = "#f59e0b";
				studentResultContent.innerHTML = `
					<div style="padding: 0.6rem; color: #f59e0b; font-size: 0.78rem;">
						⚠️ <strong>No hay lámina activa cargada en el visor.</strong><br/>
						Ve a la pestaña <em>'Imágenes & Escala'</em> para cargar o seleccionar un corte histológico.
					</div>
				`;
			}
			alert("⚠️ Selecciona o carga primero una imagen en la pestaña 'Imágenes & Escala'.");
			return;
		}

		const imgData = imageStore.get(activeImageKey);
		const allDets = [];
		(imgData.groups || []).forEach(g => {
			const groupLabel = (typeof getClassName === "function" ? getClassName(g.key) : "") || g.name || "Estructura";
			(g.detections || []).forEach((d, dIdx) => {
				if (!d._deleted) {
					allDets.push({
						...d,
						id: d.id || `${g.key}:${dIdx}`,
						label: d.label || groupLabel,
						group_key: g.key,
						scale: d.scale || (g.is_macro || g.scale === "macro" ? "macro" : "micro"),
					});
				}
			});
		});

		if (allDets.length === 0) {
			if (studentResultCard && studentResultContent) {
				studentResultCard.style.display = "block";
				studentResultCard.style.borderLeftColor = "#38bdf8";
				studentResultContent.innerHTML = `
					<div style="padding: 0.65rem; color: #e2e8f0; font-size: 0.76rem; text-align: center;">
						<div style="font-size: 1.4rem; margin-bottom: 0.3rem;">🔬</div>
						<strong>La lámina actual aún no tiene anotaciones ni segmentaciones.</strong>
						<p style="color: #94a3b8; font-size: 0.72rem; margin: 0.4rem 0 0.6rem 0;">
							Para que Gemini evalúe y calcule la probabilidad de elección correcta, segmenta primero las estructuras (células o capas tisulares).
						</p>
						<button type="button" id="gemini-prompt-seg-btn" class="btn-small" style="background: rgba(59,130,246,0.25); border: 1px solid rgba(59,130,246,0.5); color: #93c5fd; padding: 0.45rem 0.85rem; border-radius: 6px; cursor: pointer; font-weight: 700;">
							🏛️ Segmentar Macroestructuras con SAM 3.1
						</button>
					</div>
				`;
				const promptSegBtn = document.getElementById("gemini-prompt-seg-btn");
				promptSegBtn?.addEventListener("click", () => segmentMacrostructures());
			}
			alert("⚠️ No hay anotaciones o segmentaciones en esta lámina.\nSegmenta primero estructuras con SAM 3.1 o Cellpose antes de evaluarlas con Gemini.");
			return;
		}

		// If exactly 1 detection is selected, evaluate that single structure!
		if (_studentActiveDetId) {
			validateStudentSelection(false);
			return;
		}
		if (selectedDetections && selectedDetections.size === 1) {
			const [firstId] = selectedDetections;
			onDetectionSelectedForStudent(firstId);
			validateStudentSelection(false);
			return;
		}

		// UI Loading state
		const origNoSelText = studentEvalNoSelBtn ? studentEvalNoSelBtn.innerHTML : "";
		const origAllBtnText = studentEvalAllGeminiBtn ? studentEvalAllGeminiBtn.innerHTML : "";
		if (studentEvalNoSelBtn) {
			studentEvalNoSelBtn.disabled = true;
			studentEvalNoSelBtn.innerHTML = `⏳ Gemini evaluando...`;
		}
		if (studentEvalAllGeminiBtn) {
			studentEvalAllGeminiBtn.disabled = true;
			studentEvalAllGeminiBtn.innerHTML = `⏳ Gemini evaluando...`;
		}
		if (statusRunning) statusRunning.style.display = "flex";
		if (statusIdle) statusIdle.style.display = "none";
		if (statusText) statusText.textContent = `🎓 Gemini 3.8 / 3.5 evaluando ${allDets.length} anotaciones y calculando probabilidad de elección correcta...`;

		try {
			const formData = new FormData();
			if (imgData.file) {
				formData.append("image", imgData.file, imgData.filename || "image.png");
			} else if (imgData.dataUrl) {
				const resBlob = await fetch(imgData.dataUrl);
				const blob = await resBlob.blob();
				formData.append("image", blob, imgData.filename || "image.png");
			} else {
				throw new Error("No se pudo obtener el archivo de imagen de la lámina.");
			}

			formData.append("all_detections", JSON.stringify(allDets));
			formData.append("structure_scale", (typeof currentStructureScale !== "undefined" ? currentStructureScale : "micro") || "micro");
			formData.append("organ_context", window._activeOntologyName || "Corte histológico óptico");
			formData.append("preferred_model", "gemini-3.8-flash");

			const res = await fetch(`${API_URL}/evaluate-segmentations-gemini`, {
				method: "POST",
				body: formData,
			});

			if (!res.ok) {
				const err = await res.json().catch(() => ({}));
				throw new Error(err.detail || `HTTP ${res.status}`);
			}

			const result = await res.json();
			renderBatchEvaluationResult(result, allDets);

		} catch (err) {
			console.error("Gemini evaluation error:", err);
			alert(`Error al evaluar anotaciones con Gemini: ${err.message}`);
		} finally {
			if (studentEvalNoSelBtn) {
				studentEvalNoSelBtn.disabled = false;
				studentEvalNoSelBtn.innerHTML = origNoSelText;
			}
			if (studentEvalAllGeminiBtn) {
				studentEvalAllGeminiBtn.disabled = false;
				studentEvalAllGeminiBtn.innerHTML = origAllBtnText;
			}
			if (statusRunning) statusRunning.style.display = "none";
			if (statusIdle) statusIdle.style.display = "flex";
		}
	}
	window.evaluateAnnotationsWithGemini = evaluateAnnotationsWithGemini;

	function renderBatchEvaluationResult(result, allDets) {
		if (!studentResultCard || !studentResultContent) return;

		const probPct = result.porcentaje_probabilidad || result.porcentaje_global || Math.round((result.probabilidad_eleccion_correcta || 0.9) * 100);
		const probColor = probPct >= 80 ? "#10b981" : (probPct >= 50 ? "#f59e0b" : "#ef4444");

		// Update global stats
		studentStats.total += result.total_evaluadas || allDets.length;
		studentStats.correct += result.correctas || Math.round(allDets.length * (probPct / 100));
		studentStats.partial += result.parciales || 0;
		studentStats.incorrect += result.incorrectas || 0;

		if (statCorrectCount) statCorrectCount.textContent = studentStats.correct.toString();
		if (statPartialCount) statPartialCount.textContent = studentStats.partial.toString();
		if (statIncorrectCount) statIncorrectCount.textContent = studentStats.incorrect.toString();
		if (studentScoreBadge) {
			const pct = Math.round((studentStats.correct / studentStats.total) * 100);
			studentScoreBadge.textContent = `${studentStats.correct}/${studentStats.total} (${pct}%)`;
		}

		// Apply individual evaluations to detections
		if (result.evaluaciones_individuales && Array.isArray(result.evaluaciones_individuales)) {
			result.evaluaciones_individuales.forEach(item => {
				const idx = item.index;
				if (idx !== undefined && allDets[idx]) {
					const targetDet = allDets[idx];
					targetDet.gemini_validated = true;
					targetDet.gemini_eval_probability = item.probabilidad_eleccion_correcta;
					targetDet.gemini_score = Math.round((item.probabilidad_eleccion_correcta || 0.9) * 100);
					targetDet.gemini_status = item.estado || "correcta";
					targetDet.gemini_structure = item.diagnostico_sugerido || targetDet.label;
					targetDet.gemini_feedback = item.justificacion_breve || "";
				}
			});
		} else {
			allDets.forEach(targetDet => {
				targetDet.gemini_validated = true;
				targetDet.gemini_eval_probability = result.probabilidad_eleccion_correcta || (probPct / 100);
				targetDet.gemini_score = probPct;
				targetDet.gemini_status = probPct >= 80 ? "correct" : (probPct >= 50 ? "partially_correct" : "incorrect");
				targetDet.gemini_structure = targetDet.label;
			});
		}

		studentResultCard.style.borderLeftColor = probColor;
		studentResultCard.style.display = "block";

		let indHtml = "";
		if (result.evaluaciones_individuales && result.evaluaciones_individuales.length > 0) {
			indHtml = `
				<div style="margin-top: 0.65rem; max-height: 200px; overflow-y: auto; background: rgba(0,0,0,0.25); border-radius: 6px; padding: 0.4rem; border: 1px solid var(--border-color);">
					<div style="font-size: 0.68rem; font-weight: 700; color: #94a3b8; margin-bottom: 0.35rem; text-transform: uppercase;">
						Detalle de Estructuras Evaluadas:
					</div>
					${result.evaluaciones_individuales.map((item, i) => {
						const iProb = Math.round((item.probabilidad_eleccion_correcta || 0.9) * 100);
						const iColor = iProb >= 80 ? "#10b981" : (iProb >= 50 ? "#f59e0b" : "#ef4444");
						return `
							<div class="eval-item-row" data-idx="${item.index !== undefined ? item.index : i}" style="display: flex; justify-content: space-between; align-items: center; padding: 0.3rem 0.4rem; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.72rem; cursor: pointer; border-radius: 4px;">
								<div>
									<span style="font-weight: 700; color: #e2e8f0;">#${item.index !== undefined ? item.index + 1 : i + 1}</span>
									<span style="color: #94a3b8; margin-left: 0.25rem;">${item.eleccion_evaluada || item.diagnostico_sugerido || "Estructura"}</span>
								</div>
								<span class="badge" style="background: ${iColor}22; color: ${iColor}; font-weight: 800; font-size: 0.68rem; border: 1px solid ${iColor}44;">
									${iProb}%
								</span>
							</div>
						`;
					}).join("")}
				</div>
			`;
		}

		studentResultContent.innerHTML = `
			<div style="background: rgba(2,132,199,0.12); border: 1px solid rgba(56,189,248,0.35); border-radius: 8px; padding: 0.75rem; margin-bottom: 0.6rem; text-align: center;">
				<div style="font-size: 0.68rem; color: #94a3b8; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.2rem;">
					Probabilidad de Elección Correcta (LLM)
				</div>
				<div style="font-size: 1.8rem; font-weight: 900; color: ${probColor}; display: flex; align-items: center; justify-content: center; gap: 0.4rem;">
					<span>🎯</span> ${probPct}%
				</div>
				<div style="background: rgba(255,255,255,0.1); border-radius: 9999px; height: 7px; width: 100%; margin: 0.45rem 0 0.25rem 0; overflow: hidden;">
					<div style="background: ${probColor}; width: ${probPct}%; height: 100%; border-radius: 9999px; transition: width 0.6s ease;"></div>
				</div>
				<div style="font-size: 0.68rem; color: #94a3b8; display: flex; justify-content: space-between; margin-top: 0.35rem;">
					<span>Calidad segmentación: <strong style="color: #e2e8f0;">${Math.round((result.calidad_segmentacion || 0.88) * 100)}%</strong></span>
					<span>Evaluadas: <strong style="color: #38bdf8;">${result.total_evaluadas || allDets.length}</strong></span>
					<span>Modelo: <strong style="color: #a78bfa;">Gemini 3.8 / 3.5</strong></span>
				</div>
			</div>

			<div style="font-size: 0.74rem; color: #cbd5e1; line-height: 1.45; background: rgba(255,255,255,0.02); padding: 0.55rem; border-radius: 6px; border: 1px solid var(--border-color); margin-bottom: 0.5rem;">
				<strong style="color: #38bdf8;">Dictamen del Patólogo (Gemini):</strong><br />
				${result.resumen_evaluacion || "Las segmentaciones concuerdan con la morfología histológica del corte."}
			</div>

			${indHtml}
		`;

		// Hook click on individual row to select on canvas
		studentResultContent.querySelectorAll(".eval-item-row").forEach(row => {
			row.addEventListener("click", () => {
				const idx = parseInt(row.getAttribute("data-idx") || "0", 10);
				if (allDets[idx]) {
