		});

		studentResultCard.scrollIntoView({ behavior: "smooth", block: "nearest" });
		renderOverlay();
	}

	function deduplicateOverlappingDetections() {
		if (!activeImageKey) {
			alert("⚠️ Selecciona una imagen primero.");
			return;
		}
		const data = imageStore.get(activeImageKey);
		if (!data || !data.groups) return;

		let removedCount = 0;
		const allDets = [];
		data.groups.forEach(g => {
			(g.detections || []).forEach(d => {
				if (!d._deleted && !d.is_macro && d.scale !== "macro") {
					allDets.push(d);
				}
			});
		});

		for (let i = 0; i < allDets.length; i++) {
			const d1 = allDets[i];
			if (d1._deleted) continue;
			const b1 = d1.box || [0,0,10,10];
			const c1x = (b1[0] + b1[2]) / 2;
			const c1y = (b1[1] + b1[3]) / 2;

			for (let j = i + 1; j < allDets.length; j++) {
				const d2 = allDets[j];
				if (d2._deleted) continue;
				const b2 = d2.box || [0,0,10,10];
				const c2x = (b2[0] + b2[2]) / 2;
				const c2y = (b2[1] + b2[3]) / 2;

				const dist = Math.hypot(c1x - c2x, c1y - c2y);
				if (dist < 18) { // Overlapping cell center
					if (d1.gemini_validated && !d2.gemini_validated) {
						d2._deleted = true;
						removedCount++;
					} else if (d2.gemini_validated && !d1.gemini_validated) {
						d1._deleted = true;
						removedCount++;
					} else {
						d2._deleted = true;
						removedCount++;
					}
				}
			}
		}

		if (removedCount > 0) {
			selectedDetections.clear();
			updateSelectionToolbar();
			renderOverlay();
			updateClassesList();
			updateExportStats();
			alert(`✓ Se resolvieron y eliminaron ${removedCount} detección(es) duplicadas en la misma coordenada.`);
		} else {
			alert("✓ No se encontraron detecciones duplicadas o superpuestas en esta lámina.");
		}
	}
	window.deduplicateOverlappingDetections = deduplicateOverlappingDetections;

