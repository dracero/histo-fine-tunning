	function updateStudentQuickChips(scale) {
		const chipsBox = document.getElementById("student-quick-chips");
		if (!chipsBox) return;
		chipsBox.innerHTML = "";

		const isMacro = scale === "macro";
		let candidateNames = [];

		if (classRegistry && classRegistry.length > 0) {
			candidateNames = classRegistry
				.filter(c => isMacro ? c.is_macro : !c.is_macro)
				.map(c => c.name);
		}

		if (candidateNames.length === 0) {
			candidateNames = isMacro
				? ["Túbulo seminífero", "Luz del túbulo", "Membrana basal tubular", "Espacio intersticial", "Glándula tubular", "Capa muscular", "Epitelio"]
				: ["Espermatogonia A clara", "Espermatogonia A oscura", "Espermatogonia B", "Célula de Sertoli", "Espermatocito primario", "Célula de Leydig", "Linfocito"];
		}

		candidateNames.forEach(name => {
			const btn = document.createElement("button");
			btn.type = "button";
			btn.className = "student-chip-btn";
			btn.dataset.name = name;
			btn.textContent = (isMacro ? "🏛️ " : "🔬 ") + name;
			btn.style.cssText = "font-size: 0.68rem; padding: 0.2rem 0.5rem; border-radius: 9999px; background: rgba(255,255,255,0.04); border: 1px solid var(--border-color); color: var(--text-muted); cursor: pointer; transition: all 0.15s ease;";
			btn.addEventListener("click", () => {
				if (studentChoiceInput) {
					studentChoiceInput.value = name;
					studentChoiceInput.focus();
				}
			});
			chipsBox.appendChild(btn);
		});
	}

	function setStudentChallengeScale(scale) {
		const isMacro = scale === "macro";
		if (studentStructScaleBadge) {
			studentStructScaleBadge.textContent = isMacro ? "🏛️ Macroestructura" : "🔬 Microestructura";
			studentStructScaleBadge.style.background = isMacro ? "#3b82f6" : "#0284c7";
		}
		if (studentChoiceInput) {
			studentChoiceInput.placeholder = isMacro
				? "Ej: Túbulo seminífero, Luz tubular, Membrana basal..."
				: "Ej: Espermatogonia A clara, Célula de Sertoli, Linfocito...";
		}
		updateStudentQuickChips(scale);

		// If a detection is currently open in challenge, sync its scale
		if (_studentActiveDetId) {
			const mapEntry = findDetectionById(_studentActiveDetId);
			if (mapEntry && mapEntry.det) {
				mapEntry.det.scale = scale;
				mapEntry.det.is_macro = isMacro;
				mapEntry.det.structure_type = isMacro ? "macro_compartment" : "cell";
			}
		}
	}

	async function segmentMacrostructures(targetKey = null) {
		const key = targetKey || activeImageKey;
		if (!key) {
			alert("Por favor selecciona o sube una imagen primero.");
			return;
		}
		const data = imageStore.get(key);
		if (!data) return;

		statusIdle.style.display = "none";
		statusRunning.style.display = "flex";
		statusText.textContent = `🏛️ SAM 3.1: Segmentando macroestructuras anatómicas en ${data.filename}...`;

		try {
			const formData = new FormData();
			formData.append("image", data.file);
			formData.append("umbral", thresholdSlider ? thresholdSlider.value : "0.05");
			formData.append("model_engine", "sam3");
			formData.append("structure_scale", "macro");
			const effectiveOnt = window._activeOntologyName || (_currentPdfData && _currentPdfData.pdf_id) || "arch4";
			formData.append("ontology_name", effectiveOnt);

			const response = await fetch(`${API_URL}/segment-auto`, {
				method: "POST",
				body: formData
			});

			if (!response.ok) {
				const err = await response.json().catch(() => ({}));
				throw new Error(err.detail || `HTTP ${response.status}`);
			}

			const result = await response.json();
			const newMacroGroups = (result.groups || []).filter(g => g.is_macro || g.scale === "macro" || true);

			// Merge with existing groups: preserve micro groups and add/replace macro groups
			const existingMicro = (data.groups || []).filter(g => !g.is_macro && g.scale !== "macro");
			newMacroGroups.forEach(g => {
				g.is_macro = true;
				g.scale = "macro";
				(g.detections || []).forEach(d => {
					d.is_macro = true;
					d.scale = "macro";
					d.structure_type = "macro_compartment";
				});
				if (!classRegistry.find(c => c.key === g.key)) {
					classRegistry.push({
						id: classIdCounter++,
						name: g.label,
						color: g.color,
						key: g.key,
						is_macro: true,
						scale: "macro",
					});
				}
			});

			data.groups = [...newMacroGroups, ...existingMicro];
			data.annotated = true;
			renderGallery();
			updateExportStats();

			if (key === activeImageKey) {
				viewerControls.style.display = "flex";
				renderOverlay();
				updateClassesList();
				updateCorrectionClassDropdown();
			}

			// Switch challenge to macro
			setStructureScale("macro");
			setStudentChallengeScale("macro");

			// Auto-select first macro detection to open challenge immediately
			if (newMacroGroups.length > 0 && newMacroGroups[0].detections && newMacroGroups[0].detections.length > 0) {
				const firstMacroId = `${newMacroGroups[0].key}:0`;
				selectedDetections.clear();
				selectedDetections.add(firstMacroId);
				updateSelectionToolbar();
				renderOverlay();
				if (typeof onDetectionSelectedForStudent === "function") {
					onDetectionSelectedForStudent(firstMacroId);
				}
			}

			const totalMacroCount = newMacroGroups.reduce((acc, g) => acc + (g.detections ? g.detections.length : 0), 0);
			statusText.textContent = `✓ Segmentadas ${totalMacroCount} macroestructuras anatómicas (SAM 3.1).`;
			setTimeout(() => {
				statusRunning.style.display = "none";
				statusIdle.style.display = "flex";
			}, 3000);
		} catch (err) {
			console.error("Error segmentando macro:", err);
			alert(`⚠️ Error al segmentar macroestructuras: ${err.message}`);
			statusRunning.style.display = "none";
			statusIdle.style.display = "flex";
		}
	}

	function setStructureScale(scale) {
		currentStructureScale = scale === "macro" ? "macro" : "micro";
		const isMicro = currentStructureScale === "micro";

		if (btnScaleMicro) {
			btnScaleMicro.classList.toggle("active", isMicro);
			btnScaleMicro.style.background = isMicro ? "var(--primary)" : "transparent";
			btnScaleMicro.style.color = isMicro ? "#fff" : "var(--text-muted)";
		}
		if (btnScaleMacro) {
			btnScaleMacro.classList.toggle("active", !isMicro);
			btnScaleMacro.style.background = !isMicro ? "var(--primary)" : "transparent";
			btnScaleMacro.style.color = !isMicro ? "#fff" : "var(--text-muted)";
		}
		if (activeScaleBadge) {
			activeScaleBadge.textContent = isMicro ? "🔬 Microestructura" : "🏛️ Macroestructura";
			activeScaleBadge.style.background = isMicro ? "#0284c7" : "#3b82f6";
		}
		if (viewerToggleScaleBtn) {
			viewerToggleScaleBtn.textContent = isMicro ? "🔬 Escala: Micro" : "🏛️ Escala: Macro";
			viewerToggleScaleBtn.style.color = isMicro ? "#38bdf8" : "#60a5fa";
		}
		if (scaleInfoText) {
			scaleInfoText.textContent = isMicro
				? "Segmentación de células individuales, núcleos y tipos celulares (Cellpose-SAM / Meta SAM 3.1)."
				: "Segmentación de capas tisulares, glándulas, folículos, luces y estroma (Meta SAM 3.1 / TissueNet).";
		}

		// Sync student challenge
		setStudentChallengeScale(currentStructureScale);

		// Update prompt tags container
		const tagsContainer = document.getElementById("prompt-tags-container");
		if (tagsContainer) {
			if (isMicro) {
				tagsContainer.innerHTML = `
					<span class="prompt-chip" data-concept="cell nucleus">🔬 Células</span>
					<span class="prompt-chip" data-concept="individual cell nucleus chromatin">🧬 Núcleos</span>
					<span class="prompt-chip" data-concept="lymphocyte leukocyte">🩸 Linfocitos</span>
					<span class="prompt-chip" data-concept="plasma cell">🧪 Plasmocitos</span>
					<span class="prompt-chip" data-concept="spermatogonia">⚡ Espermatogonias</span>
				`;
			} else {
				tagsContainer.innerHTML = `
					<span class="prompt-chip" data-concept="gland tubular structure">🏛️ Glándulas / Acinos</span>
					<span class="prompt-chip" data-concept="tubular lumen cavity">⭕ Luz / Lumen</span>
					<span class="prompt-chip" data-concept="basement membrane wall">🧱 Membrana basal</span>
					<span class="prompt-chip" data-concept="muscular layer tunica">🥩 Capa muscular</span>
					<span class="prompt-chip" data-concept="epithelial tissue layer">🧬 Epitelio</span>
					<span class="prompt-chip" data-concept="stroma connective tissue">🕸️ Estroma</span>
				`;
			}
			tagsContainer.querySelectorAll(".prompt-chip").forEach(chip => {
				chip.addEventListener("click", () => {
					const concept = chip.dataset.concept;
					if (customPromptInput) customPromptInput.value = concept;
					if (viewerPromptInput) viewerPromptInput.value = concept;
				});
			});
		}
	}

	btnScaleMicro?.addEventListener("click", () => setStructureScale("micro"));
	btnScaleMacro?.addEventListener("click", () => setStructureScale("macro"));
	viewerToggleScaleBtn?.addEventListener("click", () => {
		setStructureScale(currentStructureScale === "micro" ? "macro" : "micro");
	});

	// Click on student badge to toggle Micro vs Macro!
	studentStructScaleBadge?.addEventListener("click", () => {
		const isCurrentlyMacro = (studentStructScaleBadge.textContent || "").includes("Macro");
		const nextScale = isCurrentlyMacro ? "micro" : "macro";
		setStructureScale(nextScale);

		if (nextScale === "macro" && activeImageKey) {
			const data = imageStore.get(activeImageKey);
			const hasMacro = data && (data.groups || []).some(g => g.is_macro || g.scale === "macro");
			if (!hasMacro) {
				segmentMacrostructures();
			} else {
				const firstMacroGroup = (data.groups || []).find(g => g.is_macro || g.scale === "macro");
				if (firstMacroGroup && firstMacroGroup.detections && firstMacroGroup.detections.length > 0) {
					const detId = `${firstMacroGroup.key}:0`;
					selectedDetections.clear();
					selectedDetections.add(detId);
					updateSelectionToolbar();
					renderOverlay();
					if (typeof onDetectionSelectedForStudent === "function") {
						onDetectionSelectedForStudent(detId);
					}
				}
			}
		} else if (nextScale === "micro" && activeImageKey) {
			const data = imageStore.get(activeImageKey);
			const firstMicroGroup = data && (data.groups || []).find(g => !g.is_macro && g.scale !== "macro");
			if (firstMicroGroup && firstMicroGroup.detections && firstMicroGroup.detections.length > 0) {
				const detId = `${firstMicroGroup.key}:0`;
				selectedDetections.clear();
				selectedDetections.add(detId);
				updateSelectionToolbar();
				renderOverlay();
