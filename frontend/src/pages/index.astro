	function resolvePdfImageMeta(img, defaultPdfId) {
		if (!img) return null;
		let filename = "";
		let targetPdfId = defaultPdfId || (_currentPdfData && _currentPdfData.pdf_id) || "unknown";

		if (typeof img === "string") {
			filename = img.split("/").pop().split("\\").pop();
		} else if (typeof img === "object") {
			filename = img.filename || img.name || (img.path ? img.path.split("/").pop().split("\\").pop() : "");
			if (img.pdf_id) targetPdfId = img.pdf_id;
		}

		if (!filename) return null;

		// Extract actual pdf_id from filename prefix if targetPdfId is unknown or empty
		if ((!targetPdfId || targetPdfId === "unknown") && filename.includes("_")) {
			targetPdfId = filename.split("_")[0];
		}

		return { filename, pdf_id: targetPdfId };
	}

	async function transferPdfImageToGallery(img, pdf_id, shouldSwitchTab = false) {
		try {
			if (shouldSwitchTab) {
				switchTab("images-tab");
			}
			const meta = resolvePdfImageMeta(img, pdf_id);
			if (!meta || !meta.filename) {
				throw new Error("Identificador de PDF o nombre de archivo inválido.");
			}
			const imgUrl = `${API_URL}/pdf-image/${encodeURIComponent(meta.pdf_id)}/${encodeURIComponent(meta.filename)}`;
			const response = await fetch(imgUrl);
			if (!response.ok) {
				throw new Error(`El servidor respondió con código ${response.status}: ${response.statusText}`);
			}
			const blob = await response.blob();
			const file = new File([blob], meta.filename, { type: blob.type || "image/png" });

			await handleFiles([file], false);
		} catch (e) {
			const msg = e.message && e.message.includes("Failed to fetch")
				? "No se pudo conectar con el servidor backend (puerto 8000). Si se estaba reiniciando, espera unos segundos y vuelve a intentarlo."
				: e.message;
			alert("Error al cargar imagen en galería: " + msg);
		}
	}

	async function importAllPdfImagesToGallery(images, pdf_id, shouldSwitchTab = true) {
		if (!images || images.length === 0) {
			alert("No hay imágenes para cargar.");
			return;
		}

		if (shouldSwitchTab) {
			switchTab("images-tab");
		}

		const fallbackPdfId = pdf_id || (_currentPdfData && _currentPdfData.pdf_id);

		// Download all images in parallel for speed
		const downloadPromises = images.map(async (img) => {
			try {
				const meta = resolvePdfImageMeta(img, fallbackPdfId);
				if (!meta || !meta.filename) return null;
				const imgUrl = `${API_URL}/pdf-image/${encodeURIComponent(meta.pdf_id)}/${encodeURIComponent(meta.filename)}`;
				const response = await fetch(imgUrl);
				if (!response.ok) {
					console.warn(`No se pudo descargar ${meta.filename} (HTTP ${response.status})`);
					return null;
				}
				const blob = await response.blob();
				return new File([blob], meta.filename, { type: blob.type || "image/png" });
			} catch (err) {
				console.warn("Error fetching PDF image:", img, err);
				return null;
			}
		});

		const results = await Promise.all(downloadPromises);
		const files = results.filter(f => f !== null);

		if (files.length === 0) {
			alert("No se pudieron descargar las imágenes del PDF. Verifica que el backend esté activo.");
			return;
		}

		await handleFiles(files, false);
	}

